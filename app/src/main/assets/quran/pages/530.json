{
  "maps": {},
  "suraStart": true,
  "suraNo": 86,
  "ayatStart": 1,
  "ayatEnd": 17,
  "pageNo": 530,
  "ayatList": [
    {
      "number": 1,
      "text": "وَالسَّمَآءِ وَالطَّارِقِۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "070924086001.mp3"
    },
    {
      "number": 2,
      "text": "\u0026nbsp;وَمَاۤ اَدۡرٰٮكَ مَا الطَّارِقُۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "070956086002.mp3"
    },
    {
      "number": 3,
      "text": "النَّجۡمُ الثَّاقِبُۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "071029086003.mp3"
    },
    {
      "number": 4,
      "text": "اِنۡ كُلُّ نَفۡسٍ لَّمَّا عَلَيۡهَا حَافِظٌؕ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "071111086004.mp3"
    },
    {
      "number": 5,
      "text": "\u0026nbsp;فَلۡيَنۡظُرِ الۡاِنۡسَانُ مِمَّ خُلِقَؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "071150086005.mp3"
    },
    {
      "number": 6,
      "text": "خُلِقَ مِنۡ مَّآءٍ دَافِقٍۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "071230086006.mp3"
    },
    {
      "number": 7,
      "text": "يَّخۡرُجُ مِنۡۢ بَيۡنِ الصُّلۡبِ وَالتَّرَآٮِٕبِؕ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "071303086007.mp3"
    },
    {
      "number": 8,
      "text": "\u0026nbsp;اِنَّهٗ عَلٰى رَجۡعِهٖ لَقَادِرٌؕ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "071349086008.mp3"
    },
    {
      "number": 9,
      "text": "يَوۡمَ تُبۡلَى السَّرَآٮِٕرُۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "071428086009.mp3"
    },
    {
      "number": 10,
      "text": "فَمَا لَهٗ مِنۡ قُوَّةٍ وَّلَا نَاصِرٍؕ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "071516086010.mp3"
    },
    {
      "number": 11,
      "text": "وَالسَّمَآءِ ذَاتِ الرَّجۡعِۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "071548086011.mp3"
    },
    {
      "number": 12,
      "text": "وَالۡاَرۡضِ ذَاتِ الصَّدۡعِۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "071625086012.mp3"
    },
    {
      "number": 13,
      "text": "\u0026nbsp;اِنَّهٗ لَقَوۡلٌ فَصۡلٌۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "071724086013.mp3"
    },
    {
      "number": 14,
      "text": "وَّمَا هُوَ بِالۡهَزۡلِؕ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "071756086014.mp3"
    },
    {
      "number": 15,
      "text": "اِنَّهُمۡ يَكِيۡدُوۡنَ كَيۡدًا ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "071831086015.mp3"
    },
    {
      "number": 16,
      "text": "\u0026nbsp;وَّاَكِيۡدُ كَيۡدًا\u0026ensp;ۚۖ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "071902086016.mp3"
    },
    {
      "number": 17,
      "text": "فَمَهِّلِ الۡكٰفِرِيۡنَ اَمۡهِلۡهُمۡ رُوَيۡدًا\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "071935086017.mp3"
    }
  ]
}