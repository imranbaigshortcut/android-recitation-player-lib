{
  "maps": {},
  "suraStart": true,
  "suraNo": 91,
  "ayatStart": 1,
  "ayatEnd": 15,
  "pageNo": 535,
  "ayatList": [
    {
      "number": 1,
      "text": "وَالشَّمۡسِ وَضُحٰٮهَا\u0026emsp;\u0026emsp;ۙ\u0026rlm;",
      "translationNo": "\u0026nbsp; Her kommer norsk oversettelse\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "194747091001[28].mp3"
    },
    {
      "number": 2,
      "text": "﻿﴾ \u0026nbsp;وَالۡقَمَرِ اِذَا تَلٰٮهَا  ۙ\u0026rlm; ",
      "translationNo": "\u0026nbsp; Her kommer norsk oversettelse\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195040091002[29].mp3"
    },
    {
      "number": 3,
      "text": "﻿﴾ \u0026nbsp;وَالنَّهَارِ اِذَا جَلّٰٮهَا ۙ\u0026rlm; ",
      "translationNo": "\u0026nbsp; Her kommer norsk oversettelse\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195205091003[30].mp3"
    },
    {
      "number": 4,
      "text": "﻿﴾ \u0026nbsp;وَالَّيۡلِ اِذَا يَغۡشٰٮهَا ۙ\u0026rlm; ",
      "translationNo": "\u0026nbsp; Her kommer norsk oversettelse\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195313091004[31].mp3"
    },
    {
      "number": 5,
      "text": "وَالسَّمَآءِ وَمَا بَنٰٮهَا ۙ\u0026rlm; ",
      "translationNo": "\u0026nbsp; Her kommer norsk oversettelse\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195414091005[32].mp3"
    },
    {
      "number": 6,
      "text": "﻿﴾ \u0026nbsp;وَالۡاَرۡضِ وَمَا طَحٰٮهَا ۙ\u0026rlm; ",
      "translationNo": "\u0026nbsp; Her kommer norsk oversettelse\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195521091006[33].mp3"
    },
    {
      "number": 7,
      "text": "وَنَفۡسٍ وَّمَا سَوّٰٮهَا ۙ\u0026rlm; ",
      "translationNo": "\u0026nbsp; Her kommer norsk oversettelse\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195629091007[34].mp3"
    },
    {
      "number": 8,
      "text": "فَاَلۡهَمَهَا فُجُوۡرَهَا وَتَقۡوٰٮهَا ۙ\u0026rlm; ",
      "translationNo": "\u0026nbsp; Her kommer norsk oversettelse\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195757091008[35].mp3"
    },
    {
      "number": 9,
      "text": "قَدۡ اَفۡلَحَ مَنۡ زَكّٰٮهَا ۙ\u0026rlm; ",
      "translationNo": "\u0026nbsp; Her kommer norsk oversettelse\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195909091009[36].mp3"
    },
    {
      "number": 10,
      "text": "وَقَدۡ خَابَ مَنۡ دَسّٰٮهَا ؕ\u0026rlm; ",
      "translationNo": "\u0026nbsp; Her kommer norsk oversettelse\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200015091010[37].mp3"
    },
    {
      "number": 11,
      "text": "كَذَّبَتۡ ثَمُوۡدُ بِطَغۡوٰٮهَآ ",
      "translationNo": "\u0026nbsp; Her kommer norsk oversettelse\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200139091011[38].mp3"
    },
    {
      "number": 12,
      "text": "اِذِ انۡۢبَعَثَ اَشۡقٰٮهَا  ۙ\u0026rlm; ",
      "translationNo": "\u0026nbsp; Her kommer norsk oversettelse\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200335091012[39].mp3"
    },
    {
      "number": 13,
      "text": "فَقَالَ لَهُمۡ رَسُوۡلُ اللّٰهِ نَاقَةَ اللّٰهِ وَسُقۡيٰهَا ؕ\u0026rlm; ",
      "translationNo": "\u0026nbsp; Her kommer norsk oversettelse\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200453091013[40].mp3"
    },
    {
      "number": 14,
      "text": "فَكَذَّبُوۡهُ فَعَقَرُوۡهَا \u0026emsp; ۙفَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُمۡ بِذَنۡۢبِهِمۡ فَسَوّٰٮهَا  ۙ\u0026rlm; ",
      "translationNo": "\u0026nbsp; Her kommer norsk oversettelse\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200616091014[41].mp3"
    },
    {
      "number": 15,
      "text": "وَلَا يَخَافُ عُقۡبٰهَا",
      "translationNo": "\u0026nbsp; Her kommer norsk oversettelse\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200712091015[42].mp3"
    }
  ]
}