{
  "maps": {},
  "suraStart": true,
  "suraNo": 71,
  "ayatStart": 1,
  "ayatEnd": 20,
  "pageNo": 506,
  "ayatList": [
    {
      "number": 1,
      "text": "اِنَّاۤ اَرۡسَلۡنَا نُوۡحًا اِلٰى قَوۡمِهٖۤ اَنۡ اَنۡذِرۡ قَوۡمَكَ مِنۡ قَبۡلِ اَنۡ يَّاۡتِيَهُمۡ عَذَابٌ اَلِيۡمٌ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "094738071001.mp3"
    },
    {
      "number": 2,
      "text": "قَالَ يٰقَوۡمِ اِنِّىۡ لَـكُمۡ نَذِيۡرٌ مُّبِيۡنٌۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "134614071002.mp3"
    },
    {
      "number": 3,
      "text": "اَنِ اعۡبُدُوا اللّٰهَ وَاتَّقُوۡهُ وَاَطِيۡعُوۡنِۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "134649071003.mp3"
    },
    {
      "number": 4,
      "text": "يَغۡفِرۡ لَـكُمۡ مِّنۡ ذُنُوۡبِكُمۡ وَيُؤَخِّرۡكُمۡ اِلٰٓى اَجَلٍ مُّسَمًّى\u0026zwnj;ؕ اِنَّ اَجَلَ اللّٰهِ اِذَا جَآءَ لَا يُؤَخَّرُ\u0026zwnj;\u0026zwnj;ۘ لَوۡ كُنۡتُمۡ تَعۡلَمُوۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "134722071004.mp3"
    },
    {
      "number": 5,
      "text": "قَالَ رَبِّ اِنِّىۡ دَعَوۡتُ قَوۡمِىۡ لَيۡلًا وَّنَهَارًا ۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "134755071005.mp3"
    },
    {
      "number": 6,
      "text": "فَلَمۡ يَزِدۡهُمۡ دُعَآءِىۡۤ اِلَّا فِرَارًا\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "134835071006.mp3"
    },
    {
      "number": 7,
      "text": "\u0026nbsp;وَاِنِّىۡ كُلَّمَا دَعَوۡتُهُمۡ لِتَغۡفِرَ لَهُمۡ جَعَلُوۡۤا اَصَابِعَهُمۡ فِىۡۤ اٰذَانِهِمۡ وَاسۡتَغۡشَوۡا ثِيَابَهُمۡ وَاَصَرُّوۡا وَاسۡتَكۡبَرُوا اسۡتِكۡبَارًا\u0026zwnj; ۚ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "134913071007.mp3"
    },
    {
      "number": 8,
      "text": "ثُمَّ اِنِّىۡ دَعَوۡتُهُمۡ جِهَارًا ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "134941071008.mp3"
    },
    {
      "number": 9,
      "text": "ثُمَّ اِنِّىۡۤ اَعۡلَـنۡتُ لَهُمۡ وَاَسۡرَرۡتُ لَهُمۡ اِسۡرَارًا ۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "135011071009.mp3"
    },
    {
      "number": 10,
      "text": "فَقُلۡتُ اسۡتَغۡفِرُوۡا رَبَّكُمۡؕ اِنَّهٗ كَانَ غَفَّارًا ۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "135042071010.mp3"
    },
    {
      "number": 11,
      "text": "يُّرۡسِلِ السَّمَآءَ عَلَيۡكُمۡ مِّدۡرَارًا ۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "135110071011.mp3"
    },
    {
      "number": 12,
      "text": "\u0026nbsp;وَّيُمۡدِدۡكُمۡ بِاَمۡوَالٍ وَّبَنِيۡنَ وَيَجۡعَلۡ لَّـكُمۡ جَنّٰتٍ وَّيَجۡعَلۡ لَّـكُمۡ اَنۡهٰرًا ؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "135145071012.mp3"
    },
    {
      "number": 13,
      "text": "مَا لَـكُمۡ لَا تَرۡجُوۡنَ لِلّٰهِ وَقَارًا\u0026zwnj; ۚ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "135221071013.mp3"
    },
    {
      "number": 14,
      "text": "وَقَدۡ خَلَقَكُمۡ اَطۡوَارًا",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "135249071014.mp3"
    },
    {
      "number": 15,
      "text": "اَلَمۡ تَرَوۡا كَيۡفَ خَلَقَ اللّٰهُ سَبۡعَ سَمٰوٰتٍ طِبَاقًا ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "135321071015.mp3"
    },
    {
      "number": 16,
      "text": "وَّجَعَلَ الۡقَمَرَ فِيۡهِنَّ نُوۡرًا وَّجَعَلَ الشَّمۡسَ سِرَاجًا\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "135400071016.mp3"
    },
    {
      "number": 17,
      "text": "وَاللّٰهُ اَنۡۢبَتَكُمۡ مِّنَ الۡاَرۡضِ نَبَاتًا ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "135434071017.mp3"
    },
    {
      "number": 18,
      "text": "ثُمَّ يُعِيۡدُكُمۡ فِيۡهَا وَيُخۡرِجُكُمۡ اِخۡرَاجًا\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "135505071018.mp3"
    },
    {
      "number": 19,
      "text": "وَاللّٰهُ جَعَلَ لَـكُمُ الۡاَرۡضَ بِسَاطًا ۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "135540071019.mp3"
    },
    {
      "number": 20,
      "text": "\u0026nbsp;لِّـتَسۡلُكُوۡا مِنۡهَا سُبُلًا فِجَاجًا\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "135615071020.mp3"
    }
  ]
}