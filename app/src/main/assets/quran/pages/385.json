{
  "maps": {},
  "suraStart": false,
  "suraNo": 36,
  "ayatStart": 33,
  "ayatEnd": 50,
  "pageNo": 385,
  "ayatList": [
    {
      "number": 33,
      "text": "وَاٰيَةٌ لَّهُمُ الۡاَرۡضُ الۡمَيۡتَةُ\u0026nbsp;\u0026nbsp;\u0026nbsp;ۖۚ اَحۡيَيۡنٰهَا وَاَخۡرَجۡنَا مِنۡهَا حَبًّا فَمِنۡهُ يَاۡكُلُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195310036033.mp3"
    },
    {
      "number": 34,
      "text": "وَجَعَلۡنَا فِيۡهَا جَنّٰتٍ مِّنۡ نَّخِيۡلٍ وَّاَعۡنَابٍ وَّفَجَّرۡنَا فِيۡهَا مِنَ الۡعُيُوۡنِۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195411036034.mp3"
    },
    {
      "number": 35,
      "text": "\u0026nbsp;لِيَاۡكُلُوۡا مِنۡ ثَمَرِهٖ ۙ وَمَا عَمِلَـتۡهُ اَيۡدِيۡهِمۡ\u0026zwnj; ؕ اَفَلَا يَشۡكُرُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195510036035.mp3"
    },
    {
      "number": 36,
      "text": "سُبۡحٰنَ الَّذِىۡ خَلَقَ الۡاَزۡوَاجَ كُلَّهَا مِمَّا تُنۡۢبِتُ الۡاَرۡضُ وَمِنۡ اَنۡفُسِهِمۡ وَمِمَّا لَا يَعۡلَمُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195612036036.mp3"
    },
    {
      "number": 37,
      "text": "وَاٰيَةٌ لَّهُمُ الَّيۡلُ\u0026nbsp;\u0026nbsp;ۖۚ نَسۡلَخُ مِنۡهُ النَّهَارَ فَاِذَا هُمۡ مُّظۡلِمُوۡنَۙ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195716036037.mp3"
    },
    {
      "number": 38,
      "text": "وَالشَّمۡسُ تَجۡرِىۡ لِمُسۡتَقَرٍّ لَّهَا\u0026nbsp;\u0026nbsp;\u0026zwnj;ؕ ذٰلِكَ تَقۡدِيۡرُ الۡعَزِيۡزِ الۡعَلِيۡمِؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195831036038.mp3"
    },
    {
      "number": 39,
      "text": "وَالۡقَمَرَ قَدَّرۡنٰهُ مَنَازِلَ حَتّٰى عَادَ كَالۡعُرۡجُوۡنِ الۡقَدِيۡمِ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200011036039.mp3"
    },
    {
      "number": 40,
      "text": "لَا الشَّمۡسُ يَنۡۢبَغِىۡ لَهَاۤ اَنۡ تُدۡرِكَ الۡقَمَرَ وَلَا الَّيۡلُ سَابِقُ النَّهَارِ\u0026zwnj;ؕ وَكُلٌّ فِىۡ فَلَكٍ يَّسۡبَحُوۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200103036040.mp3"
    },
    {
      "number": 41,
      "text": "وَاٰيَةٌ لَّهُمۡ اَنَّا حَمَلۡنَا ذُرِّيَّتَهُمۡ فِى الۡفُلۡكِ الۡمَشۡحُوۡنِۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200217036041.mp3"
    },
    {
      "number": 42,
      "text": "\u0026nbsp;وَخَلَقۡنَا لَهُمۡ مِّنۡ مِّثۡلِهٖ مَا يَرۡكَبُوۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200326036042.mp3"
    },
    {
      "number": 43,
      "text": "وَاِنۡ نَّشَاۡ نُغۡرِقۡهُمۡ فَلَا صَرِيۡخَ لَهُمۡ وَلَا هُمۡ يُنۡقَذُوۡنَۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200430036043.mp3"
    },
    {
      "number": 44,
      "text": "\u0026nbsp;اِلَّا رَحۡمَةً مِّنَّا وَمَتَاعًا اِلٰى حِيۡنٍ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200546036044.mp3"
    },
    {
      "number": 45,
      "text": "وَاِذَا قِيۡلَ لَهُمُ اتَّقُوۡا مَا بَيۡنَ اَيۡدِيۡكُمۡ وَمَا خَلۡفَكُمۡ لَعَلَّكُمۡ تُرۡحَمُوۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200642036045.mp3"
    },
    {
      "number": 46,
      "text": "وَمَا تَاۡتِيۡهِمۡ مِّنۡ اٰيَةٍ مِّنۡ اٰيٰتِ رَبِّهِمۡ اِلَّا كَانُوۡا عَنۡهَا مُعۡرِضِيۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200750036046.mp3"
    },
    {
      "number": 47,
      "text": "وَاِذَا قِيۡلَ لَهُمۡ اَنۡفِقُوۡا مِمَّا رَزَقَكُمُ اللّٰهُ ۙ قَالَ الَّذِيۡنَ كَفَرُوۡا لِلَّذِيۡنَ اٰمَنُوۡۤا اَنُطۡعِمُ مَنۡ لَّوۡ يَشَآءُ اللّٰهُ اَطۡعَمَهٗٓ ۖ  اِنۡ اَنۡـتُمۡ اِلَّا فِىۡ ضَلٰلٍ مُّبِيۡنٍ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200912036047.mp3"
    },
    {
      "number": 48,
      "text": "وَيَقُوۡلُوۡنَ مَتٰى هٰذَا الۡوَعۡدُ اِنۡ كُنۡتُمۡ صٰدِقِيۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "201049036048.mp3"
    },
    {
      "number": 49,
      "text": "مَا يَنۡظُرُوۡنَ اِلَّا صَيۡحَةً وَّاحِدَةً تَاۡخُذُهُمۡ وَهُمۡ يَخِصِّمُوۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "201145036049.mp3"
    },
    {
      "number": 50,
      "text": "فَلَا يَسۡتَطِيۡعُوۡنَ تَوۡصِيَةً وَّلَاۤ اِلٰٓى اَهۡلِهِمۡ يَرۡجِعُوۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "201249036050.mp3"
    }
  ]
}