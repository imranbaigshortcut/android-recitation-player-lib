{
  "maps": {},
  "suraStart": true,
  "suraNo": 44,
  "ayatStart": 1,
  "ayatEnd": 29,
  "pageNo": 433,
  "ayatList": [
    {
      "number": 1,
      "text": "حٰمٓ \u0026zwnj; ۛ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "134847044001.mp3"
    },
    {
      "number": 2,
      "text": "وَالۡكِتٰبِ الۡمُبِيۡنِ\u0026ensp;\u0026zwnj; ۛ\u0026zwnj;ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "135037044002.mp3"
    },
    {
      "number": 3,
      "text": "اِنَّاۤ اَنۡزَلۡنٰهُ فِىۡ لَيۡلَةٍ مُّبٰـرَكَةٍ\u0026zwnj; اِنَّا كُنَّا مُنۡذِرِيۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "135145044003.mp3"
    },
    {
      "number": 4,
      "text": "فِيۡهَا يُفۡرَقُ كُلُّ اَمۡرٍ حَكِيۡمٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.",
      "commentary": "",
      "audioTalawat": "135304044004.mp3"
    },
    {
      "number": 5,
      "text": "اَمۡرًا مِّنۡ عِنۡدِنَا\u0026zwnj;ؕ اِنَّا كُنَّا مُرۡسِلِيۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "135450044005.mp3"
    },
    {
      "number": 6,
      "text": "رَحۡمَةً مِّنۡ رَّبِّكَ\u0026zwnj;ؕ اِنَّهٗ هُوَ السَّمِيۡعُ الۡعَلِيۡمُۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "135545044006.mp3"
    },
    {
      "number": 7,
      "text": "رَبِّ السَّمٰوٰتِ وَالۡاَرۡضِ وَمَا بَيۡنَهُمَا\u0026zwnj;ۘ اِنۡ كُنۡتُمۡ مُّوۡقِنِيۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "135622044007.mp3"
    },
    {
      "number": 8,
      "text": "لَاۤ اِلٰهَ اِلَّا هُوَ يُحۡىٖ وَيُمِيۡتُ\u0026zwnj;ؕ رَبُّكُمۡ وَرَبُّ اٰبَآٮِٕكُمُ الۡاَوَّلِيۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "135703044008.mp3"
    },
    {
      "number": 9,
      "text": "بَلۡ هُمۡ فِىۡ شَكٍّ يَّلۡعَبُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "135741044009.mp3"
    },
    {
      "number": 10,
      "text": "فَارۡتَقِبۡ يَوۡمَ تَاۡتِى السَّمَآءُ بِدُخَانٍ مُّبِيۡنٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "135820044010.mp3"
    },
    {
      "number": 11,
      "text": "يَغۡشَى النَّاسَ\u0026zwnj;ؕ هٰذَا عَذَابٌ اَلِيۡمٌ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "173003044011.mp3"
    },
    {
      "number": 12,
      "text": "رَبَّنَا اكۡشِفۡ عَنَّا الۡعَذَابَ اِنَّا مُؤۡمِنُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "173048044012.mp3"
    },
    {
      "number": 13,
      "text": "اَنّٰى لَهُمُ الذِّكۡرٰى وَقَدۡ جَآءَهُمۡ رَسُوۡلٌ مُّبِيۡنٌۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "173128044013.mp3"
    },
    {
      "number": 14,
      "text": "ثُمَّ تَوَلَّوۡا عَنۡهُ وَقَالُوۡا مُعَلَّمٌ مَّجۡنُوۡنٌ\u0026zwnj;ۘ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "173209044014.mp3"
    },
    {
      "number": 15,
      "text": "اِنَّا كَاشِفُوا الۡعَذَابِ قَلِيۡلًا اِنَّكُمۡ عَآٮِٕدُوۡنَ\u0026zwnj;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "173359044015.mp3"
    },
    {
      "number": 16,
      "text": "يَوۡمَ نَبۡطِشُ الۡبَطۡشَةَ الۡكُبۡـرٰى\u0026zwnj;ۚ اِنَّا مُنۡتَقِمُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "173449044016.mp3"
    },
    {
      "number": 17,
      "text": "وَلَقَدۡ فَتَنَّا قَبۡلَهُمۡ قَوۡمَ فِرۡعَوۡنَ وَ جَآءَهُمۡ رَسُوۡلٌ كَرِيۡمٌۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "173557044017.mp3"
    },
    {
      "number": 18,
      "text": "اَنۡ اَدُّوۡۤا اِلَىَّ عِبَادَ اللّٰهِ\u0026zwnj;ؕ اِنِّىۡ لَـكُمۡ رَسُوۡلٌ اَمِيۡنٌۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "173641044018.mp3"
    },
    {
      "number": 19,
      "text": "وَّاَنۡ لَّا تَعۡلُوۡا عَلَى اللّٰهِ\u0026zwnj;ۚ اِنِّىۡۤ اٰتِيۡكُمۡ بِسُلۡطٰنٍ مُّبِيۡنٍ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "173726044019.mp3"
    },
    {
      "number": 20,
      "text": "وَاِنِّىۡ عُذۡتُ بِرَبِّىۡ وَرَبِّكُمۡ اَنۡ تَرۡجُمُوۡنِ ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "173808044020.mp3"
    },
    {
      "number": 21,
      "text": "وَاِنۡ لَّمۡ تُؤۡمِنُوۡا لِىۡ فَاعۡتَزِلُوۡنِ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "174018044021.mp3"
    },
    {
      "number": 22,
      "text": "فَدَعَا رَبَّهٗۤ اَنَّ هٰۤؤُلَاۤءِ قَوۡمٌ مُّجۡرِمُوۡنَ\u0026rlm;\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "174118044022.mp3"
    },
    {
      "number": 23,
      "text": "فَاَسۡرِ بِعِبَادِىۡ لَيۡلًا اِنَّكُمۡ مُّتَّبَعُوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "174156044023.mp3"
    },
    {
      "number": 24,
      "text": "وَاتۡرُكِ الۡبَحۡرَ رَهۡوًا\u0026zwnj;ؕ اِنَّهُمۡ جُنۡدٌ مُّغۡرَقُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "174238044024.mp3"
    },
    {
      "number": 25,
      "text": "كَمۡ تَرَكُوۡا مِنۡ جَنّٰتٍ وَّعُيُوۡنٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "174343044025.mp3"
    },
    {
      "number": 26,
      "text": "وَّزُرُوۡعٍ وَّمَقَامٍ كَرِيۡمٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "174434044026.mp3"
    },
    {
      "number": 27,
      "text": "وَّنَعۡمَةٍ كَانُوۡا فِيۡهَا فٰكِهِيۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "174521044027.mp3"
    },
    {
      "number": 28,
      "text": "\u0026nbsp;كَذٰلِكَ\u0026zwnj; وَاَوۡرَثۡنٰهَا قَوۡمًا اٰخَرِيۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "174606044028.mp3"
    },
    {
      "number": 29,
      "text": "فَمَا بَكَتۡ عَلَيۡهِمُ السَّمَآءُ وَالۡاَرۡضُ وَمَا كَانُوۡا مُنۡظَرِيۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "174650044029.mp3"
    }
  ]
}