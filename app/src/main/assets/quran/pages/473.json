{
  "maps": {},
  "suraStart": false,
  "suraNo": 56,
  "ayatStart": 75,
  "ayatEnd": 96,
  "pageNo": 473,
  "ayatList": [
    {
      "number": 75,
      "text": "فَلَاۤ اُقۡسِمُ بِمَوٰقِعِ النُّجُوۡمِۙ\u0026rlm;\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "014830056075.mp3"
    },
    {
      "number": 76,
      "text": "وَاِنَّهٗ لَقَسَمٌ لَّوۡ تَعۡلَمُوۡنَ عَظِيۡمٌۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "014911056076.mp3"
    },
    {
      "number": 77,
      "text": "اِنَّهٗ لَـقُرۡاٰنٌ كَرِيۡمٌۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "015014056077.mp3"
    },
    {
      "number": 78,
      "text": "فِىۡ كِتٰبٍ مَّكۡنُوۡنٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "015100056078.mp3"
    },
    {
      "number": 79,
      "text": "لَّا يَمَسُّهٗۤ اِلَّا الۡمُطَهَّرُوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "015147056079.mp3"
    },
    {
      "number": 80,
      "text": "تَنۡزِيۡلٌ مِّنۡ رَّبِّ الۡعٰلَمِيۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "015230056080.mp3"
    },
    {
      "number": 81,
      "text": "اَفَبِهٰذَا الۡحَـدِيۡثِ اَنۡتُمۡ مُّدۡهِنُوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "015326056081.mp3"
    },
    {
      "number": 82,
      "text": "وَتَجۡعَلُوۡنَ رِزۡقَكُمۡ اَنَّكُمۡ تُكَذِّبُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "015828056082.mp3"
    },
    {
      "number": 83,
      "text": "فَلَوۡلَاۤ اِذَا بَلَغَتِ الۡحُـلۡقُوۡمَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "015925056083.mp3"
    },
    {
      "number": 84,
      "text": "وَاَنۡتُمۡ حِيۡنَٮِٕذٍ تَـنۡظُرُوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "020014056084.mp3"
    },
    {
      "number": 85,
      "text": "وَنَحۡنُ اَقۡرَبُ اِلَيۡهِ مِنۡكُمۡ وَلٰـكِنۡ لَّا تُبۡصِرُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "020100056085.mp3"
    },
    {
      "number": 86,
      "text": "فَلَوۡلَاۤ اِنۡ كُنۡتُمۡ غَيۡرَ مَدِيۡنِيۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "020148056086.mp3"
    },
    {
      "number": 87,
      "text": "تَرۡجِعُوۡنَهَاۤ اِنۡ كُنۡتُمۡ صٰدِقِيۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "020251056087.mp3"
    },
    {
      "number": 88,
      "text": "فَاَمَّاۤ اِنۡ كَانَ مِنَ الۡمُقَرَّبِيۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "020347056088.mp3"
    },
    {
      "number": 89,
      "text": "فَرَوۡحٌ وَّ رَيۡحَانٌ\u0026ensp;ۙ وَّجَنَّتُ نَعِيۡمٍ\u0026rlm;",
      "translationNo": "Her kommer nosk oversettelse",
      "commentary": "",
      "audioTalawat": "020440056089.mp3"
    },
    {
      "number": 90,
      "text": "وَاَمَّاۤ اِنۡ كَانَ مِنۡ اَصۡحٰبِ الۡيَمِيۡنِۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "020525056090.mp3"
    },
    {
      "number": 91,
      "text": "فَسَلٰمٌ لَّكَ مِنۡ اَصۡحٰبِ الۡيَمِيۡنِؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "020620056091.mp3"
    },
    {
      "number": 92,
      "text": "وَاَمَّاۤ اِنۡ كَانَ مِنَ الۡمُكَذِّبِيۡنَ الضَّآلِّيۡنَۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "020805056092.mp3"
    },
    {
      "number": 93,
      "text": "فَنُزُلٌ مِّنۡ حَمِيۡمٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "020913056093.mp3"
    },
    {
      "number": 94,
      "text": "وَّتَصۡلِيَةُ جَحِيۡمٍ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "021000056094.mp3"
    },
    {
      "number": 95,
      "text": "اِنَّ هٰذَا لَهُوَ حَقُّ الۡيَـقِيۡنِۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "021045056095.mp3"
    },
    {
      "number": 96,
      "text": "فَسَبِّحۡ بِاسۡمِ رَبِّكَ الۡعَظِيۡمِ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "021129056096.mp3"
    }
  ]
}