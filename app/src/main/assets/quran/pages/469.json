  "ayatList": [
    {
      "number": 26,
      "text": "كُلُّ مَنۡ عَلَيۡهَا فَانٍ\u0026zwnj; ۚ\u0026zwnj;\u0026ensp;ۖ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "175631055026.mp3"
    },
    {
      "number": 27,
      "text": "وَّيَبۡقٰى وَجۡهُ رَبِّكَ ذُو الۡجَلٰلِ وَالۡاِكۡرَامِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "175718055027.mp3"
    },
    {
      "number": 28,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "175801055028.mp3"
    },
    {
      "number": 29,
      "text": "يَسۡـَٔـلُهٗ مَنۡ فِى السَّمٰوٰتِ وَالۡاَرۡضِ\u0026zwnj;ؕ كُلَّ يَوۡمٍ هُوَ فِىۡ شَاۡنٍ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "175915055029.mp3"
    },
    {
      "number": 30,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "175956055030.mp3"
    },
    {
      "number": 31,
      "text": "سَنَفۡرُغُ لَـكُمۡ اَيُّهَ الثَّقَلٰنِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "180036055031.mp3"
    },
    {
      "number": 32,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "180121055032.mp3"
    },
    {
      "number": 33,
      "text": "يٰمَعۡشَرَ الۡجِنِّ وَالۡاِنۡسِ اِنِ اسۡتَطَعۡتُمۡ اَنۡ تَنۡفُذُوۡا مِنۡ اَقۡطَارِ السَّمٰوٰتِ وَالۡاَرۡضِ فَانْفُذُوۡا\u0026zwnj;ؕ لَا تَنۡفُذُوۡنَ اِلَّا بِسُلۡطٰنٍ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "180208055033.mp3"
    },
    {
      "number": 34,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "180247055034.mp3"
    },
    {
      "number": 35,
      "text": "يُرۡسَلُ عَلَيۡكُمَا شُوَاظٌ مِّنۡ نَّارٍ\u0026ensp;ۙ وَّنُحَاسٌ فَلَا تَنۡتَصِرٰنِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "180342055035.mp3"
    },
    {
      "number": 36,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "180431055036.mp3"
    },
    {
      "number": 37,
      "text": "فَاِذَا انْشَقَّتِ السَّمَآءُ فَكَانَتۡ وَرۡدَةً كَالدِّهَانِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "180529055037.mp3"
    },
    {
      "number": 38,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ\u0026rlm;",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "180615055038.mp3"
    },
    {
      "number": 39,
      "text": "فَيَوۡمَٮِٕذٍ لَّا يُسۡـٴَـلُ عَنۡ ذَنۡۢبِهٖۤ اِنۡسٌ وَّلَا جَآنٌّ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "180702055039.mp3"
    },
    {
      "number": 40,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "180750055040.mp3"
    },
    {
      "number": 41,
      "text": "يُعۡرَفُ الۡمُجۡرِمُوۡنَ بِسِيۡمٰهُمۡ فَيُؤۡخَذُ بِالنَّوَاصِىۡ وَ الۡاَقۡدَامِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "180836055041.mp3"
    },
    {
      "number": 42,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "180922055042.mp3"
    },
    {
      "number": 43,
      "text": "هٰذِهٖ جَهَنَّمُ الَّتِىۡ يُكَذِّبُ بِهَا الۡمُجۡرِمُوۡنَ\u0026zwnj;ۘ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "181009055043.mp3"
    },
    {
      "number": 44,
      "text": "يَطُوۡفُوۡنَ بَيۡنَهَا وَبَيۡنَ حَمِيۡمٍ اٰنٍ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "181053055044.mp3"
    },
    {
      "number": 45,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
