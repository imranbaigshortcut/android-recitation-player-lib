{
  "maps": {},
  "suraStart": false,
  "suraNo": 68,
  "ayatStart": 34,
  "ayatEnd": 52,
  "pageNo": 501,
  "ayatList": [
    {
      "number": 34,
      "text": "اِنَّ لِلۡمُتَّقِيۡنَ عِنۡدَ رَبِّهِمۡ جَنّٰتِ النَّعِيۡمِ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "102311068034.mp3"
    },
    {
      "number": 35,
      "text": "اَفَنَجۡعَلُ الۡمُسۡلِمِيۡنَ كَالۡمُجۡرِمِيۡنَؕ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "102419068035.mp3"
    },
    {
      "number": 36,
      "text": "مَا لَـكُمۡ كَيۡفَ تَحۡكُمُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "102622068036.mp3"
    },
    {
      "number": 37,
      "text": "اَمۡ لَـكُمۡ كِتٰبٌ فِيۡهِ تَدۡرُسُوۡنَۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "102739068037.mp3"
    },
    {
      "number": 38,
      "text": "اِنَّ لَـكُمۡ فِيۡهِ لَمَا تَخَيَّرُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "102909068038.mp3"
    },
    {
      "number": 39,
      "text": "اَمۡ لَـكُمۡ اَيۡمَانٌ عَلَيۡنَا بَالِغَةٌ اِلٰى يَوۡمِ الۡقِيٰمَةِ\u0026zwnj; ۙ اِنَّ لَـكُمۡ لَمَا تَحۡكُمُوۡنَ\u0026zwnj;ۚ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "103152068039.mp3"
    },
    {
      "number": 40,
      "text": "سَلۡهُمۡ اَيُّهُمۡ بِذٰلِكَ زَعِيۡمٌ ۛۚ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "103356068040.mp3"
    },
    {
      "number": 41,
      "text": "اَمۡ لَهُمۡ شُرَكَآءُ\u0026nbsp;\u0026nbsp;\u0026nbsp;ۛۚ فَلۡيَاۡتُوۡا بِشُرَكَآٮِٕهِمۡ اِنۡ كَانُوۡا صٰدِقِيۡنَ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "103504068041.mp3"
    },
    {
      "number": 42,
      "text": "يَوۡمَ يُكۡشَفُ عَنۡ سَاقٍ وَّيُدۡعَوۡنَ اِلَى السُّجُوۡدِ فَلَا يَسۡتَطِيۡعُوۡنَۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "103605068042.mp3"
    },
    {
      "number": 43,
      "text": "خَاشِعَةً اَبۡصَارُهُمۡ تَرۡهَقُهُمۡ ذِلَّةٌ ؕ وَقَدۡ كَانُوۡا يُدۡعَوۡنَ اِلَى السُّجُوۡدِ وَهُمۡ سٰلِمُوۡنَ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "17172700680043.wav"
    },
    {
      "number": 44,
      "text": "فَذَرۡنِىۡ وَمَنۡ يُّكَذِّبُ بِهٰذَا الۡحَـدِيۡثِ\u0026zwnj;ؕ سَنَسۡتَدۡرِجُهُمۡ مِّنۡ حَيۡثُ لَا يَعۡلَمُوۡنَۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "104912068044.mp3"
    },
    {
      "number": 45,
      "text": "وَاُمۡلِىۡ لَهُمۡ\u0026zwnj;ؕ اِنَّ كَيۡدِىۡ مَتِيۡنٌ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "105110068045.mp3"
    },
    {
      "number": 46,
      "text": "اَمۡ تَسۡـَٔـلُهُمۡ اَجۡرًا فَهُمۡ مِّنۡ مَّغۡرَمٍ مُّثۡقَلُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "105217068046.mp3"
    },
    {
      "number": 47,
      "text": "اَمۡ عِنۡدَهُمُ الۡغَيۡبُ فَهُمۡ يَكۡتُبُوۡنَ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "105340068047.mp3"
    },
    {
      "number": 48,
      "text": "فَاصۡبِرۡ لِحُكۡمِ رَبِّكَ وَلَا تَكُنۡ كَصَاحِبِ الۡحُوۡتِ\u0026zwnj;ۘ اِذۡ نَادٰى وَهُوَ مَكۡظُوۡمٌؕ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "105518068048.mp3"
    },
    {
      "number": 49,
      "text": "\u0026nbsp;لَوۡلَاۤ اَنۡ تَدٰرَكَهٗ نِعۡمَةٌ مِّنۡ رَّبِّهٖ لَنُبِذَ بِالۡعَرَآءِ وَهُوَ مَذۡمُوۡمٌ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "105620068049.mp3"
    },
    {
      "number": 50,
      "text": "فَاجۡتَبٰهُ رَبُّهٗ فَجَعَلَهٗ مِنَ الصّٰلِحِيۡنَ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "105725068050.mp3"
    },
    {
      "number": 51,
      "text": "وَاِنۡ يَّكَادُ الَّذِيۡنَ كَفَرُوۡا لَيُزۡلِقُوۡنَكَ بِاَبۡصَارِهِمۡ لَمَّا سَمِعُوا الذِّكۡرَ وَيَقُوۡلُوۡنَ اِنَّهٗ لَمَجۡنُوۡنٌ\u0026zwnj;ۘ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "105850068051.mp3"
    },
    {
      "number": 52,
      "text": "وَمَا هُوَ اِلَّا ذِكۡرٌ لِّلۡعٰلَمِيۡنَ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "110021068052.mp3"
    }
  ]
}