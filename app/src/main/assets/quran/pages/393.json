{
  "maps": {},
  "suraStart": true,
  "suraNo": 38,
  "ayatStart": 1,
  "ayatEnd": 14,
  "pageNo": 393,
  "ayatList": [
    {
      "number": 1,
      "text": "صٓ\u0026zwnj; وَالۡقُرۡاٰنِ ذِى الذِّكۡرِؕ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "221509038001.mp3"
    },
    {
      "number": 2,
      "text": "بَلِ الَّذِيۡنَ كَفَرُوۡا فِىۡ عِزَّةٍ وَّشِقَاقٍ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "221613038002.mp3"
    },
    {
      "number": 3,
      "text": "كَمۡ اَهۡلَـكۡنَا مِنۡ قَبۡلِهِمۡ مِّنۡ قَرۡنٍ فَنَادَوْا وَّلَاتَ حِيۡنَ مَنَاصٍ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "221718038003.mp3"
    },
    {
      "number": 4,
      "text": "\u0026nbsp;وَعَجِبُوۡۤا اَنۡ جَآءَهُمۡ مُّنۡذِرٌ مِّنۡهُمۡ\u0026zwnj; وَقَالَ الۡكٰفِرُوۡنَ هٰذَا سٰحِرٌ كَذَّابٌ\u0026zwnj;\u0026nbsp;",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "221832038004.mp3"
    },
    {
      "number": 5,
      "text": "اَجَعَلَ الۡاٰلِهَةَ اِلٰهًا وَّاحِدًا\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;ۖۚ اِنَّ هٰذَا لَشَىۡءٌ عُجَابٌ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "222116038005.mp3"
    },
    {
      "number": 6,
      "text": "وَانْطَلَقَ الۡمَلَاُ مِنۡهُمۡ اَنِ امۡشُوۡا وَاصۡبِرُوۡا عَلٰٓى اٰلِهَتِكُمۡ\u0026zwnj;\u0026nbsp;\u0026zwnj;ۖۚ\u0026zwnj; اِنَّ هٰذَا لَشَىۡءٌ يُّرَادُ\u0026nbsp;ۖ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "222225038006.mp3"
    },
    {
      "number": 7,
      "text": "مَا سَمِعۡنَا بِهٰذَا فِى الۡمِلَّةِ الۡاٰخِرَةِ ۖۚ اِنۡ هٰذَاۤ اِلَّا اخۡتِلَاقٌ \u0026zwnj; ۖ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "222316038007.mp3"
    },
    {
      "number": 8,
      "text": "\u0026nbsp;ءَاُنۡزِلَ عَلَيۡهِ الذِّكۡرُ مِنۡۢ بَيۡنِنَا\u0026zwnj;ؕ بَلۡ هُمۡ فِىۡ شَكٍّ مِّنۡ ذِكۡرِىۡ\u0026zwnj;ۚ بَلْ لَّمَّا يَذُوۡقُوۡا عَذَابِؕ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "222418038008.mp3"
    },
    {
      "number": 9,
      "text": "\u0026nbsp;اَمۡ عِنۡدَهُمۡ خَزَآٮِٕنُ رَحۡمَةِ رَبِّكَ الۡعَزِيۡزِ الۡوَهَّابِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "222505038009.mp3"
    },
    {
      "number": 10,
      "text": "اَمۡ لَهُمۡ مُّلۡكُ السَّمٰوٰتِ وَالۡاَرۡضِ وَمَا بَيۡنَهُمَا\u0026zwnj;فَلۡيَرۡتَقُوۡا فِى الۡاَسۡبَابِ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "222554038010.mp3"
    },
    {
      "number": 11,
      "text": "\u0026nbsp;جُنۡدٌ مَّا هُنَالِكَ مَهۡزُوۡمٌ مِّنَ الۡاَحۡزَابِ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "222642038011.mp3"
    },
    {
      "number": 12,
      "text": "كَذَّبَتۡ قَبۡلَهُمۡ قَوۡمُ نُوۡحٍ وَّعَادٌ وَّفِرۡعَوۡنُ ذُو الۡاَوۡتَادِۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "222733038012.mp3"
    },
    {
      "number": 13,
      "text": "\u0026nbsp;وَثَمُوۡدُ وَقَوۡمُ لُوۡطٍ وَّاَصۡحٰبُ لْئَیْكَةِ\u0026zwnj; ؕ اُولٰٓٮِٕكَ الۡاَحۡزَابُ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "222833038013.mp3"
    },
    {
      "number": 14,
      "text": "\u0026nbsp;اِنۡ كُلٌّ اِلَّا كَذَّبَ الرُّسُلَ فَحَقَّ عِقَابِ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "223043038014.mp3"
    }
  ]
}