{
  "maps": {},
  "suraStart": true,
  "suraNo": 82,
  "ayatStart": 1,
  "ayatEnd": 19,
  "pageNo": 526,
  "ayatList": [
    {
      "number": 1,
      "text": "اِذَا السَّمَآءُ انْفَطَرَتۡۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194417082001.mp3"
    },
    {
      "number": 2,
      "text": "\u0026nbsp;\u0026nbsp;وَاِذَا الۡكَوَاكِبُ انْتَثَرَتۡۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194507082002.mp3"
    },
    {
      "number": 3,
      "text": "\u0026nbsp;\u0026nbsp;وَاِذَا الۡبِحَارُ فُجِّرَتۡۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194611082003.mp3"
    },
    {
      "number": 4,
      "text": "\u0026nbsp;\u0026nbsp;وَاِذَا الۡقُبُوۡرُ بُعۡثِرَتۡۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194652082004.mp3"
    },
    {
      "number": 5,
      "text": "\u0026nbsp;\u0026nbsp;عَلِمَتۡ نَفۡسٌ مَّا قَدَّمَتۡ وَاَخَّرَتۡؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194814082005.mp3"
    },
    {
      "number": 6,
      "text": "\u0026nbsp;\u0026nbsp;يٰۤاَيُّهَا الۡاِنۡسَانُ مَا غَرَّكَ بِرَبِّكَ الۡكَرِيۡمِۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194856082006.mp3"
    },
    {
      "number": 7,
      "text": "\u0026nbsp;\u0026nbsp;الَّذِىۡ خَلَقَكَ فَسَوّٰٮكَ فَعَدَلَـكَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194933082007.mp3"
    },
    {
      "number": 8,
      "text": "\u0026nbsp;\u0026nbsp;فِىۡۤ اَىِّ صُوۡرَةٍ مَّا شَآءَ رَكَّبَكَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195009082008.mp3"
    },
    {
      "number": 9,
      "text": "\u0026nbsp;\u0026nbsp;كَلَّا بَلۡ تُكَذِّبُوۡنَ بِالدِّيۡنِۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195040082009.mp3"
    },
    {
      "number": 10,
      "text": "\u0026nbsp;\u0026nbsp;وَاِنَّ عَلَيۡكُمۡ لَحٰـفِظِيۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195122082010.mp3"
    },
    {
      "number": 11,
      "text": "\u0026nbsp;\u0026nbsp;كِرَامًا كَاتِبِيۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195259082011.mp3"
    },
    {
      "number": 12,
      "text": "\u0026nbsp;\u0026nbsp;يَعۡلَمُوۡنَ مَا تَفۡعَلُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195417082012.mp3"
    },
    {
      "number": 13,
      "text": "\u0026nbsp;اِنَّ الۡاَبۡرَارَ لَفِىۡ نَعِيۡمٍۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195453082013.mp3"
    },
    {
      "number": 14,
      "text": "\u0026nbsp;وَاِنَّ الۡفُجَّارَ لَفِىۡ جَحِيۡمٍ ۚۖ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195542082014.mp3"
    },
    {
      "number": 15,
      "text": "\u0026nbsp;\u0026nbsp;يَّصۡلَوۡنَهَا يَوۡمَ الدِّيۡنِ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195633082015.mp3"
    },
    {
      "number": 16,
      "text": "\u0026nbsp;\u0026nbsp;وَمَا هُمۡ عَنۡهَا بِغَآٮِٕبِيۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195707082016.mp3"
    },
    {
      "number": 17,
      "text": "\u0026nbsp;\u0026nbsp;وَمَاۤ اَدۡرٰٮكَ مَا يَوۡمُ الدِّيۡنِۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195806082017.mp3"
    },
    {
      "number": 18,
      "text": "\u0026nbsp;\u0026nbsp;ثُمَّ مَاۤ اَدۡرٰٮكَ مَا يَوۡمُ الدِّيۡنِؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195840082018.mp3"
    },
    {
      "number": 19,
      "text": "\u0026nbsp;\u0026nbsp;يَوۡمَ لَا تَمۡلِكُ نَفۡسٌ لِّنَفۡسٍ شَيۡـــًٔا\u0026zwnj; ؕ وَالۡاَمۡرُ يَوۡمَٮِٕذٍ لِّلَّهِ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195906082019.mp3"
    }
  ]
}