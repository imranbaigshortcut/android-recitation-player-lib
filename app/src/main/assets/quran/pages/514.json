{
  "maps": {},
  "suraStart": true,
  "suraNo": 75,
  "ayatStart": 1,
  "ayatEnd": 30,
  "pageNo": 514,
  "ayatList": [
    {
      "number": 1,
      "text": "لَاۤ اُقۡسِمُ بِيَوۡمِ الۡقِيٰمَةِۙ\u0026rlm;",
      "translationNo": "Her kommer Norsk oversettelse",
      "commentary": "",
      "audioTalawat": "121801075001.mp3"
    },
    {
      "number": 2,
      "text": "وَلَاۤ اُقۡسِمُ بِالنَّفۡسِ اللَّوَّامَةِؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "121940075002.mp3"
    },
    {
      "number": 3,
      "text": "اَيَحۡسَبُ الۡاِنۡسَانُ اَلَّنۡ نَّجۡمَعَ عِظَامَهٗؕ\u0026rlm;\r\n\r\n\u0026nbsp;",
      "translationNo": "Her kommer Norsk oversettelse",
      "commentary": "",
      "audioTalawat": "122404075003.mp3"
    },
    {
      "number": 4,
      "text": "بَلٰى قٰدِرِيۡنَ عَلٰٓى اَنۡ نُّسَوِّىَ بَنَانَهٗ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "122540075004.mp3"
    },
    {
      "number": 5,
      "text": "\u0026nbsp; بَلۡ يُرِيۡدُ الۡاِنۡسَانُ لِيَفۡجُرَ اَمَامَهٗ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "122653075005.mp3"
    },
    {
      "number": 6,
      "text": "يَسۡـَٔـلُ اَيَّانَ يَوۡمُ الۡقِيٰمَةِؕ\u0026rlm;",
      "translationNo": "Her kommer Norsk oversettelse",
      "commentary": "",
      "audioTalawat": "122824075006.mp3"
    },
    {
      "number": 7,
      "text": "فَاِذَا بَرِقَ الۡبَصَرُۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "123406075007.mp3"
    },
    {
      "number": 8,
      "text": "وَخَسَفَ الۡقَمَرُۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "123758075008[1].mp3"
    },
    {
      "number": 9,
      "text": "وَجُمِعَ الشَّمۡسُ وَالۡقَمَرُۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "123934075009.mp3"
    },
    {
      "number": 10,
      "text": "\u0026nbsp; يَقُوۡلُ الۡاِنۡسَانُ يَوۡمَٮِٕذٍ اَيۡنَ الۡمَفَرُّ\u0026zwnj; ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "124040075010.mp3"
    },
    {
      "number": 11,
      "text": "كَلَّا لَا وَزَرَؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "124135075011.mp3"
    },
    {
      "number": 12,
      "text": "اِلٰى رَبِّكَ يَوۡمَٮِٕذِ اۨلۡمُسۡتَقَرُّ ؕ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer Norsk oversettelse",
      "commentary": "",
      "audioTalawat": "124303075012.mp3"
    },
    {
      "number": 13,
      "text": "يُنَبَّؤُا الۡاِنۡسَانُ يَوۡمَٮِٕذٍۢ بِمَا قَدَّمَ وَاَخَّرَؕ\u0026rlm; ",
      "translationNo": "her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "124947075013.mp3"
    },
    {
      "number": 14,
      "text": "بَلِ الۡاِنۡسَانُ عَلٰى نَفۡسِهٖ بَصِيۡرَةٌ\u0026ensp;ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "125322075014.mp3"
    },
    {
      "number": 15,
      "text": "وَّلَوۡ اَلۡقٰى مَعَاذِيۡرَهٗؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "125504075015.mp3"
    },
    {
      "number": 16,
      "text": "لَا تُحَرِّكۡ بِهٖ لِسَانَكَ لِتَعۡجَلَ بِهٖؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "125646075016.mp3"
    },
    {
      "number": 17,
      "text": "\u0026nbsp;اِنَّ عَلَيۡنَا جَمۡعَهٗ وَقُرۡاٰنَهٗۚ \u0026ensp;ۖ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "125830075017.mp3"
    },
    {
      "number": 18,
      "text": "فَاِذَا قَرَاۡنٰهُ فَاتَّبِعۡ قُرۡاٰنَهٗ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "130024075018.mp3"
    },
    {
      "number": 19,
      "text": "ثُمَّ اِنَّ عَلَيۡنَا بَيَانَهٗؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "130150075019.mp3"
    },
    {
      "number": 20,
      "text": "كَلَّا بَلۡ تُحِبُّوۡنَ الۡعَاجِلَةَ ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse \u0026nbsp;",
      "commentary": "",
      "audioTalawat": "130353075020.mp3"
    },
    {
      "number": 21,
      "text": "وَتَذَرُوۡنَ الۡاٰخِرَةَ ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "130527075021.mp3"
    },
    {
      "number": 22,
      "text": "وُجُوۡهٌ يَّوۡمَٮِٕذٍ نَّاضِرَةٌ\u0026ensp;ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "130656075022.mp3"
    },
    {
      "number": 23,
      "text": "اِلٰى رَبِّهَا نَاظِرَةٌ\u0026zwnj;\u0026ensp;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "130804075023.mp3"
    },
    {
      "number": 24,
      "text": "وَوُجُوۡهٌ يَّوۡمَٮِٕذٍۢ بَاسِرَةٌ\u0026ensp;ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "130922075024.mp3"
    },
    {
      "number": 25,
      "text": "تَظُنُّ اَنۡ يُّفۡعَلَ بِهَا فَاقِرَةٌ\u0026ensp;ؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "131038075025.mp3"
    },
    {
      "number": 26,
      "text": "كَلَّاۤ اِذَا بَلَغَتِ التَّرَاقِىَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "131209075026.mp3"
    },
    {
      "number": 27,
      "text": "وَقِيۡلَ مَنۡ؄ رَاقٍۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse \u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200730075027.mp3"
    },
    {
      "number": 28,
      "text": "وَّظَنَّ اَنَّهُ الۡفِرَاقُۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195656075028.mp3"
    },
    {
      "number": 29,
      "text": "\u0026nbsp; وَالۡتَفَّتِ السَّاقُ بِالسَّاقِۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "131622075029.mp3"
    },
    {
      "number": 30,
      "text": "اِلٰى رَبِّكَ يَوۡمَٮِٕذِ اۨلۡمَسَاقُؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "131725075030.mp3"
    }
  ]
}