{
  "maps": {},
  "suraStart": true,
  "suraNo": 92,
  "ayatStart": 1,
  "ayatEnd": 21,
  "pageNo": 536,
  "ayatList": [
    {
      "number": 1,
      "text": "وَالَّيۡلِ اِذَا يَغۡشٰىۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "185805092001.mp3"
    },
    {
      "number": 2,
      "text": "\u0026nbsp;\u0026nbsp;وَالنَّهَارِ اِذَا تَجَلّٰىۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195720092002.mp3"
    },
    {
      "number": 3,
      "text": "\u0026nbsp;\u0026nbsp;وَمَا خَلَقَ الذَّكَرَ وَالۡاُنۡثٰٓىۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195839092003.mp3"
    },
    {
      "number": 4,
      "text": "\u0026nbsp;\u0026nbsp;اِنَّ سَعۡيَكُمۡ لَشَتّٰىؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "200004092004.mp3"
    },
    {
      "number": 5,
      "text": "\u0026nbsp;\u0026nbsp;فَاَمَّا مَنۡ اَعۡطٰى وَاتَّقٰىۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "200146092005.mp3"
    },
    {
      "number": 6,
      "text": "\u0026nbsp;\u0026nbsp;وَصَدَّقَ بِالۡحُسۡنٰىۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "200303092006.mp3"
    },
    {
      "number": 7,
      "text": "\u0026nbsp;\u0026nbsp;فَسَنُيَسِّرُهٗ لِلۡيُسۡرٰىؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "200414092007.mp3"
    },
    {
      "number": 8,
      "text": "\u0026nbsp;\u0026nbsp;وَاَمَّا مَنۡۢ بَخِلَ وَاسۡتَغۡنٰىۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "201027092008.mp3"
    },
    {
      "number": 9,
      "text": "\u0026nbsp;\u0026nbsp;وَكَذَّبَ بِالۡحُسۡنٰىۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "201118092009.mp3"
    },
    {
      "number": 10,
      "text": "\u0026nbsp;\u0026nbsp;فَسَنُيَسِّرُهٗ لِلۡعُسۡرٰىؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "201216092010.mp3"
    },
    {
      "number": 11,
      "text": "\u0026nbsp;\u0026nbsp;وَمَا يُغۡنِىۡ عَنۡهُ مَالُهٗۤ اِذَا تَرَدّٰىؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "201321092011.mp3"
    },
    {
      "number": 12,
      "text": "\u0026nbsp;\u0026nbsp;اِنَّ عَلَيۡنَا لَـلۡهُدٰىۖ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "202122092012.mp3"
    },
    {
      "number": 13,
      "text": "\u0026nbsp;\u0026nbsp;وَاِنَّ لَـنَا لَـلۡاٰخِرَةَ وَالۡاُوۡلٰى\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "202220092013.mp3"
    },
    {
      "number": 14,
      "text": "\u0026nbsp;\u0026nbsp;فَاَنۡذَرۡتُكُمۡ نَارًا تَلَظّٰى\u0026zwnj;ۚ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "202315092014.mp3"
    },
    {
      "number": 15,
      "text": "\u0026nbsp;\u0026nbsp;لَا يَصۡلٰٮهَاۤ اِلَّا الۡاَشۡقَىۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "202431092015.mp3"
    },
    {
      "number": 16,
      "text": "\u0026nbsp;\u0026nbsp;الَّذِىۡ كَذَّبَ وَتَوَلّٰىؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "202531092016.mp3"
    },
    {
      "number": 17,
      "text": "\u0026nbsp;\u0026nbsp;وَسَيُجَنَّبُهَا الۡاَتۡقَىۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "202634092017.mp3"
    },
    {
      "number": 18,
      "text": "\u0026nbsp;\u0026nbsp;الَّذِىۡ يُؤۡتِىۡ مَالَهٗ يَتَزَكّٰى\u0026zwnj;ۚ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "202808092018.mp3"
    },
    {
      "number": 19,
      "text": "\u0026nbsp;\u0026nbsp;وَمَا لِاَحَدٍ عِنۡدَهٗ مِنۡ نِّعۡمَةٍ تُجۡزٰٓىۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "202919092019.mp3"
    },
    {
      "number": 20,
      "text": "\u0026nbsp;\u0026nbsp;اِلَّا ابۡتِغَآءَ وَجۡهِ رَبِّهِ الۡاَعۡلٰى\u0026zwnj;ۚ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "203026092020.mp3"
    },
    {
      "number": 21,
      "text": "\u0026nbsp;\u0026nbsp;وَلَسَوۡفَ يَرۡضٰى\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "203113092021.mp3"
    }
  ]
}