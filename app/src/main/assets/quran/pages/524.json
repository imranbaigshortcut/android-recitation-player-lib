{
  "maps": {},
  "suraStart": true,
  "suraNo": 80,
  "ayatStart": 1,
  "ayatEnd": 42,
  "pageNo": 524,
  "ayatList": [
    {
      "number": 1,
      "text": "عَبَسَ وَتَوَلّٰٓىۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "201259080001.mp3"
    },
    {
      "number": 2,
      "text": "\u0026nbsp;\u0026nbsp;اَنۡ جَآءَهُ الۡاَعۡمٰىؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "201429080002.mp3"
    },
    {
      "number": 3,
      "text": "\u0026nbsp;\u0026nbsp;وَمَا يُدۡرِيۡكَ لَعَلَّهٗ يَزَّكّٰٓىۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "201501080003.mp3"
    },
    {
      "number": 4,
      "text": "\u0026nbsp;\u0026nbsp;اَوۡ يَذَّكَّرُ فَتَنۡفَعَهُ الذِّكۡرٰىؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "201548080004.mp3"
    },
    {
      "number": 5,
      "text": "\u0026nbsp;\u0026nbsp;اَمَّا مَنِ اسۡتَغۡنٰىۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "201647080005.mp3"
    },
    {
      "number": 6,
      "text": "\u0026nbsp;\u0026nbsp;فَاَنۡتَ لَهٗ تَصَدّٰىؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "201759080006.mp3"
    },
    {
      "number": 7,
      "text": "\u0026nbsp;\u0026nbsp;وَمَا عَلَيۡكَ اَلَّا يَزَّكّٰٓىؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "201901080007.mp3"
    },
    {
      "number": 8,
      "text": "\u0026nbsp;وَاَمَّا مَنۡ جَآءَكَ يَسۡعٰىۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "201939080008.mp3"
    },
    {
      "number": 9,
      "text": "\u0026nbsp;وَهُوَ يَخۡشٰىۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "202010080009.mp3"
    },
    {
      "number": 10,
      "text": "\u0026nbsp;\u0026nbsp;فَاَنۡتَ عَنۡهُ تَلَهّٰى\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "202049080010.mp3"
    },
    {
      "number": 11,
      "text": "\u0026nbsp;\u0026nbsp;كَلَّاۤ اِنَّهَا تَذۡكِرَةٌ\u0026ensp;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "202235080011.mp3"
    },
    {
      "number": 12,
      "text": "\u0026nbsp;\u0026nbsp;فَمَنۡ شَآءَ ذَكَرَهٗ\u0026zwnj;ۘ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "202302080012.mp3"
    },
    {
      "number": 13,
      "text": "\u0026nbsp;\u0026nbsp;فِىۡ صُحُفٍ مُّكَرَّمَةٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "202515080013.mp3"
    },
    {
      "number": 14,
      "text": "\u0026nbsp;\u0026nbsp;مَّرۡفُوۡعَةٍ مُّطَهَّرَةٍ ۭۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "202541080014.mp3"
    },
    {
      "number": 15,
      "text": "\u0026nbsp;\u0026nbsp;بِاَيۡدِىۡ سَفَرَةٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "202631080015.mp3"
    },
    {
      "number": 16,
      "text": "\u0026nbsp;\u0026nbsp;كِرَامٍۢ بَرَرَةٍؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "202735080016.mp3"
    },
    {
      "number": 17,
      "text": "\u0026nbsp;\u0026nbsp;قُتِلَ الۡاِنۡسَانُ مَاۤ اَكۡفَرَهٗؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "202813080017.mp3"
    },
    {
      "number": 18,
      "text": "\u0026nbsp;\u0026nbsp;مِنۡ اَىِّ شَىۡءٍ خَلَقَهٗؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "202847080018.mp3"
    },
    {
      "number": 19,
      "text": "\u0026nbsp;\u0026nbsp;مِنۡ نُّطۡفَةٍؕ خَلَقَهٗ فَقَدَّرَهٗ ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "202928080019.mp3"
    },
    {
      "number": 20,
      "text": "\u0026nbsp;\u0026nbsp;ثُمَّ السَّبِيۡلَ يَسَّرَهٗۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "203219080020.mp3"
    },
    {
      "number": 21,
      "text": "\u0026nbsp;\u0026nbsp;ثُمَّ اَمَاتَهٗ فَاَقۡبَرَهٗۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "203258080021.mp3"
    },
    {
      "number": 22,
      "text": "\u0026nbsp;ثُمَّ اِذَا شَآءَ اَنۡشَرَهٗؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "203336080022.mp3"
    },
    {
      "number": 23,
      "text": "\u0026nbsp;\u0026nbsp;كَلَّا لَـمَّا يَقۡضِ مَاۤ اَمَرَهٗؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "203417080023.mp3"
    },
    {
      "number": 24,
      "text": "\u0026nbsp;\u0026nbsp;فَلۡيَنۡظُرِ الۡاِنۡسَانُ اِلٰى طَعَامِهٖۤۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "203501080024.mp3"
    },
    {
      "number": 25,
      "text": "\u0026nbsp;\u0026nbsp;اَنَّا صَبَبۡنَا الۡمَآءَ صَبًّا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "203536080025.mp3"
    },
    {
      "number": 26,
      "text": "\u0026nbsp;\u0026nbsp;ثُمَّ شَقَقۡنَا الۡاَرۡضَ شَقًّا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "203819080026.mp3"
    },
    {
      "number": 27,
      "text": "\u0026nbsp;\u0026nbsp;فَاَنۡۢبَتۡنَا فِيۡهَا حَبًّا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "203858080027.mp3"
    },
    {
      "number": 28,
      "text": "\u0026nbsp;\u0026nbsp;وَّ عِنَبًا وَّقَضۡبًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "203940080028.mp3"
    },
    {
      "number": 29,
      "text": "\u0026nbsp;\u0026nbsp;وَّزَيۡتُوۡنًا وَّنَخۡلًا ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "204015080029.mp3"
    },
    {
      "number": 30,
      "text": "\u0026nbsp;وَحَدَآٮِٕقَ غُلۡبًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "204101080030.mp3"
    },
    {
      "number": 31,
      "text": "\u0026nbsp;\u0026nbsp;وَّفَاكِهَةً وَّاَبًّا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "204153080031.mp3"
    },
    {
      "number": 32,
      "text": "\u0026nbsp;\u0026nbsp;مَّتَاعًا لَّـكُمۡ وَلِاَنۡعَامِكُمۡؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "204236080032.mp3"
    },
    {
      "number": 33,
      "text": "\u0026nbsp;فَاِذَا جَآءَتِ الصَّآخَّةُ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "204321080033.mp3"
    },
    {
      "number": 34,
      "text": "\u0026nbsp;يَوۡمَ يَفِرُّ الۡمَرۡءُ مِنۡ اَخِيۡهِۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "204356080034.mp3"
    },
    {
      "number": 35,
      "text": "\u0026nbsp;وَاُمِّهٖ وَاَبِيۡهِۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "204431080035.mp3"
    },
    {
      "number": 36,
      "text": "\u0026nbsp;\u0026nbsp;وَصَاحِبَتِهٖ وَبَنِيۡهِؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "204518080036.mp3"
    },
    {
      "number": 37,
      "text": "\u0026nbsp;\u0026nbsp;لِكُلِّ امۡرِیءٍ مِّنۡهُمۡ يَوۡمَٮِٕذٍ شَاۡنٌ يُّغۡنِيۡهِؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "204603080037.mp3"
    },
    {
      "number": 38,
      "text": "\u0026nbsp;وُجُوۡهٌ يَّوۡمَٮِٕذٍ مُّسۡفِرَةٌ\u0026ensp;ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "204636080038.mp3"
    },
    {
      "number": 39,
      "text": "\u0026nbsp;\u0026nbsp;ضَاحِكَةٌ مُّسۡتَبۡشِرَةٌ\u0026ensp;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "204714080039.mp3"
    },
    {
      "number": 40,
      "text": "\u0026nbsp;\u0026nbsp;وَوُجُوۡهٌ يَّوۡمَٮِٕذٍ عَلَيۡهَا غَبَرَةٌ\u0026ensp;ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "204748080040.mp3"
    },
    {
      "number": 41,
      "text": "\u0026nbsp;\u0026nbsp;تَرۡهَقُهَا قَتَرَةٌ\u0026ensp;ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "204824080041.mp3"
    },
    {
      "number": 42,
      "text": "\u0026nbsp;\u0026nbsp;اُولٰٓٮِٕكَ هُمُ الۡكَفَرَةُ الۡفَجَرَةُ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "204859080042.mp3"
    }
  ]
}