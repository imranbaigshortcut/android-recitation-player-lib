{
  "maps": {},
  "suraStart": true,
  "suraNo": 50,
  "ayatStart": 1,
  "ayatEnd": 15,
  "pageNo": 454,
  "ayatList": [
    {
      "number": 1,
      "text": "قٓ\u0026nbsp;\u0026nbsp;ۚ وَالۡقُرۡاٰنِ الۡمَجِيۡدِۚ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "214911050001.mp3"
    },
    {
      "number": 2,
      "text": "\u0026nbsp;بَلۡ عَجِبُوۡۤا اَنۡ جَآءَهُمۡ مُّنۡذِرٌ مِّنۡهُمۡ فَقَالَ الۡكٰفِرُوۡنَ هٰذَا شَىۡءٌ عَجِيۡبٌ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "215020050002.mp3"
    },
    {
      "number": 3,
      "text": "ءَاِذَا مِتۡنَا وَكُنَّا تُرَابًا \u0026zwnj;ۚ ذٰ لِكَ رَجۡعٌ ۢ بَعِيۡدٌ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "215224050003.mp3"
    },
    {
      "number": 4,
      "text": "قَدۡ عَلِمۡنَا مَا تَنۡقُصُ الۡاَرۡضُ مِنۡهُمۡ\u0026zwnj;ۚ وَعِنۡدَنَا كِتٰبٌ حَفِيۡظٌ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "215319050004.mp3"
    },
    {
      "number": 5,
      "text": "\u0026nbsp;بَلۡ كَذَّبُوۡا بِالۡحَقِّ لَمَّا جَآءَهُمۡ فَهُمۡ فِىۡۤ اَمۡرٍ مَّرِيۡجٍ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "215446050005.mp3"
    },
    {
      "number": 6,
      "text": "﻿\u0026nbsp;اَ فَلَمۡ يَنۡظُرُوۡۤا اِلَى السَّمَآءِ فَوۡقَهُمۡ كَيۡفَ بَنَيۡنٰهَا وَزَ يَّـنّٰهَا وَمَا لَهَا مِنۡ فُرُوۡجٍ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "215707050006.mp3"
    },
    {
      "number": 7,
      "text": "وَالۡاَرۡضَ مَدَدۡنٰهَا وَاَ لۡقَيۡنَا فِيۡهَا رَوَاسِىَ وَاَنۡۢبَتۡنَا فِيۡهَا مِنۡ كُلِّ زَوۡجٍۢ بَهِيۡجٍ ۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "215804050007.mp3"
    },
    {
      "number": 8,
      "text": "تَبۡصِرَةً وَّذِكۡرٰى لِكُلِّ عَبۡدٍ مُّنِيۡبٍ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "215853050008.mp3"
    },
    {
      "number": 9,
      "text": "﻿\u0026nbsp; وَنَزَّلۡنَا مِنَ السَّمَآءِ مَآءً مُّبٰـرَكًا فَاَنۡۢبَـتۡـنَا بِهٖ جَنّٰتٍ وَّحَبَّ الۡحَصِيۡدِ ۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "215954050009.mp3"
    },
    {
      "number": 10,
      "text": "وَالنَّخۡلَ بٰسِقٰتٍ لَّهَا طَلۡـعٌ نَّضِيۡدٌ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "220045050010.mp3"
    },
    {
      "number": 11,
      "text": "\u0026nbsp;رِّزۡقًا لِّلۡعِبَادِ\u0026zwnj; ۙ وَاَحۡيَيۡنَا بِهٖ بَلۡدَةً مَّيۡـتًا\u0026zwnj; ؕ كَذٰلِكَ الۡخُـرُوۡجُ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "220137050011.mp3"
    },
    {
      "number": 12,
      "text": "\u0026nbsp;كَذَّبَتۡ قَبۡلَهُمۡ قَوۡمُ نُوۡحٍ وَّاَصۡحٰبُ الرَّسِّ وَثَمُوۡدُۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "220240050012.mp3"
    },
    {
      "number": 13,
      "text": "﻿\u0026nbsp;وَعَادٌ وَّفِرۡعَوۡنُ وَاِخۡوَانُ لُوۡطٍۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "220453050013.mp3"
    },
    {
      "number": 14,
      "text": "\u0026nbsp;وَّاَصۡحٰبُ الۡاَيۡكَةِ وَقَوۡمُ تُبَّعٍ\u0026zwnj;ؕ كُلٌّ كَذَّبَ الرُّسُلَ فَحَقَّ وَعِيۡدِ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "220542050014.mp3"
    },
    {
      "number": 15,
      "text": "\u0026nbsp;اَفَعَيِيۡنَا بِالۡخَـلۡقِ الۡاَوَّلِ\u0026zwnj;ؕ بَلۡ هُمۡ فِىۡ لَبۡسٍ مِّنۡ خَلۡقٍ جَدِيۡدٍ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "220635050015.mp3"
    }
  ]
}