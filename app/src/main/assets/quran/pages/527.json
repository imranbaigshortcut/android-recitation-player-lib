{
  "maps": {},
  "suraStart": true,
  "suraNo": 83,
  "ayatStart": 1,
  "ayatEnd": 36,
  "pageNo": 527,
  "ayatList": [
    {
      "number": 1,
      "text": "وَيۡلٌ لِّلۡمُطَفِّفِيۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192438083001.mp3"
    },
    {
      "number": 2,
      "text": "\u0026nbsp;\u0026nbsp;الَّذِيۡنَ اِذَا اكۡتَالُوۡا عَلَى النَّاسِ يَسۡتَوۡفُوۡنَۖ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192553083002.mp3"
    },
    {
      "number": 3,
      "text": "\u0026nbsp;\u0026nbsp;وَاِذَا كَالُوۡهُمۡ اَوْ وَّزَنُوۡهُمۡ يُخۡسِرُوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192635083003.mp3"
    },
    {
      "number": 4,
      "text": "\u0026nbsp;اَلَا يَظُنُّ اُولٰٓٮِٕكَ اَنَّهُمۡ مَّبۡعُوۡثُوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192704083004.mp3"
    },
    {
      "number": 5,
      "text": "\u0026nbsp;لِيَوۡمٍ عَظِيۡمٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192733083005.mp3"
    },
    {
      "number": 6,
      "text": "\u0026nbsp;\u0026nbsp;يَّوۡمَ يَقُوۡمُ النَّاسُ لِرَبِّ الۡعٰلَمِيۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192811083006.mp3"
    },
    {
      "number": 7,
      "text": "\u0026nbsp;\u0026nbsp;كَلَّاۤ اِنَّ كِتٰبَ الۡفُجَّارِ لَفِىۡ سِجِّيۡنٍؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192851083007.mp3"
    },
    {
      "number": 8,
      "text": "\u0026nbsp;\u0026nbsp;وَمَاۤ اَدۡرٰٮكَ مَا سِجِّيۡنٌؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192921083008.mp3"
    },
    {
      "number": 9,
      "text": "\u0026nbsp;\u0026nbsp;كِتٰبٌ مَّرۡقُوۡمٌؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192949083009.mp3"
    },
    {
      "number": 10,
      "text": "\u0026nbsp;وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193037083010.mp3"
    },
    {
      "number": 11,
      "text": "\u0026nbsp;\u0026nbsp;الَّذِيۡنَ يُكَذِّبُوۡنَ بِيَوۡمِ الدِّيۡنِؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193212083011.mp3"
    },
    {
      "number": 12,
      "text": "\u0026nbsp;\u0026nbsp;وَمَا يُكَذِّبُ بِهٖۤ اِلَّا كُلُّ مُعۡتَدٍ اَثِيۡمٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193239083012.mp3"
    },
    {
      "number": 13,
      "text": "\u0026nbsp;\u0026nbsp;اِذَا تُتۡلٰى عَلَيۡهِ اٰيٰتُنَا قَالَ اَسَاطِيۡرُ الۡاَوَّلِيۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193315083013.mp3"
    },
    {
      "number": 14,
      "text": "\u0026nbsp;\u0026nbsp;كَلَّا\u0026zwnj; بَلۡ؄ رَانَ عَلٰى قُلُوۡبِهِمۡ مَّا كَانُوۡا يَكۡسِبُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193347083014.mp3"
    },
    {
      "number": 15,
      "text": "\u0026nbsp;\u0026nbsp;كَلَّاۤ اِنَّهُمۡ عَنۡ رَّبِّهِمۡ يَوۡمَٮِٕذٍ لَّمَحۡجُوۡبُوۡنَ\u0026zwnj;ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193418083015.mp3"
    },
    {
      "number": 16,
      "text": "\u0026nbsp;\u0026nbsp;ثُمَّ اِنَّهُمۡ لَصَالُوا الۡجَحِيۡمِؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193447083016.mp3"
    },
    {
      "number": 17,
      "text": "\u0026nbsp;\u0026nbsp;ثُمَّ يُقَالُ هٰذَا الَّذِىۡ كُنۡتُمۡ بِهٖ تُكَذِّبُوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193525083017.mp3"
    },
    {
      "number": 18,
      "text": "\u0026nbsp;\u0026nbsp;كَلَّاۤ اِنَّ كِتٰبَ الۡاَبۡرَارِ لَفِىۡ عِلِّيِّيۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193603083018.mp3"
    },
    {
      "number": 19,
      "text": "\u0026nbsp;\u0026nbsp;وَمَاۤ اَدۡرٰٮكَ مَا عِلِّيُّوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193650083019.mp3"
    },
    {
      "number": 20,
      "text": "\u0026nbsp;\u0026nbsp;كِتٰبٌ مَّرۡقُوۡمٌۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193719083020.mp3"
    },
    {
      "number": 21,
      "text": "\u0026nbsp;\u0026nbsp;يَّشۡهَدُهُ الۡمُقَرَّبُوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194020083021.mp3"
    },
    {
      "number": 22,
      "text": "\u0026nbsp;\u0026nbsp;اِنَّ الۡاَبۡرَارَ لَفِىۡ نَعِيۡمٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194112083022.mp3"
    },
    {
      "number": 23,
      "text": "\u0026nbsp;\u0026nbsp;عَلَى الۡاَرَآٮِٕكِ يَنۡظُرُوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194141083023.mp3"
    },
    {
      "number": 24,
      "text": "\u0026nbsp;\u0026nbsp;تَعۡرِفُ فِىۡ وُجُوۡهِهِمۡ نَضۡرَةَ النَّعِيۡمِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194214083024.mp3"
    },
    {
      "number": 25,
      "text": "\u0026nbsp;\u0026nbsp;يُسۡقَوۡنَ مِنۡ رَّحِيۡقٍ مَّخۡتُوۡمٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194321083025.mp3"
    },
    {
      "number": 26,
      "text": "\u0026nbsp;\u0026nbsp;خِتٰمُهٗ مِسۡكٌ \u0026zwnj;ؕ وَفِىۡ ذٰلِكَ فَلۡيَتَنَافَسِ الْمُتَنَافِسُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194412083026.mp3"
    },
    {
      "number": 27,
      "text": "\u0026nbsp;\u0026nbsp;وَ مِزَاجُهٗ مِنۡ تَسۡنِيۡمٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194513083027.mp3"
    },
    {
      "number": 28,
      "text": "\u0026nbsp;\u0026nbsp;عَيۡنًا يَّشۡرَبُ بِهَا الۡمُقَرَّبُوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194551083028.mp3"
    },
    {
      "number": 29,
      "text": "\u0026nbsp;اِنَّ الَّذِيۡنَ اَجۡرَمُوۡا كَانُوۡا مِنَ الَّذِيۡنَ اٰمَنُوۡا يَضۡحَكُوۡنَ\u0026emsp;ۖ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195001083029.mp3"
    },
    {
      "number": 30,
      "text": "\u0026nbsp;\u0026nbsp;وَاِذَا مَرُّوۡا بِهِمۡ يَتَغَامَزُوۡنَ \u0026emsp;ۖ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195145083030.mp3"
    },
    {
      "number": 31,
      "text": "\u0026nbsp;\u0026nbsp;وَاِذَا انۡقَلَبُوۡۤا اِلٰٓى اَهۡلِهِمُ انْقَلَبُوۡا فَكِهِيۡنَ \u0026emsp;ۖ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195305083031.mp3"
    },
    {
      "number": 32,
      "text": "\u0026nbsp;\u0026nbsp;وَاِذَا رَاَوۡهُمۡ قَالُوۡۤا اِنَّ هٰٓؤُلَاۤءِ لَـضَآلُّوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195341083032.mp3"
    },
    {
      "number": 33,
      "text": "\u0026nbsp;وَمَاۤ اُرۡسِلُوۡا عَلَيۡهِمۡ حٰفِظِيۡنَۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195428083033.mp3"
    },
    {
      "number": 34,
      "text": "\u0026nbsp;فَالۡيَوۡمَ الَّذِيۡنَ اٰمَنُوۡا مِنَ الۡكُفَّارِ يَضۡحَكُوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195515083034.mp3"
    },
    {
      "number": 35,
      "text": "\u0026nbsp;\u0026nbsp;عَلَى الۡاَرَآٮِٕكِۙ يَنۡظُرُوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195624083035.mp3"
    },
    {
      "number": 36,
      "text": "\u0026nbsp;\u0026nbsp;هَلۡ ثُوِّبَ الۡكُفَّارُ مَا كَانُوۡا يَفۡعَلُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195709083036.mp3"
    }
  ]
}