{
  "maps": {},
  "suraStart": true,
  "suraNo": 87,
  "ayatStart": 1,
  "ayatEnd": 19,
  "pageNo": 531,
  "ayatList": [
    {
      "number": 1,
      "text": "سَبِّحِ اسۡمَ رَبِّكَ الۡاَعۡلَىۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092257087001.mp3"
    },
    {
      "number": 2,
      "text": "\u0026nbsp;الَّذِىۡ خَلَقَ فَسَوّٰى\u0026nbsp;ۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092336087002.mp3"
    },
    {
      "number": 3,
      "text": "وَالَّذِىۡ قَدَّرَ فَهَدٰى\u0026nbsp;ۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092404087003.mp3"
    },
    {
      "number": 4,
      "text": "وَالَّذِىۡۤ اَخۡرَجَ الۡمَرۡعٰى\u0026nbsp;ۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092437087004.mp3"
    },
    {
      "number": 5,
      "text": "\u0026nbsp;فَجَعَلَهٗ غُثَآءً اَحۡوٰىؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092512087005.mp3"
    },
    {
      "number": 6,
      "text": "\u0026nbsp;سَنُقۡرِئُكَ فَلَا تَنۡسٰٓىۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092544087006.mp3"
    },
    {
      "number": 7,
      "text": "\u0026nbsp;اِلَّا مَا شَآءَ اللّٰهُ\u0026zwnj;ؕ اِنَّهٗ يَعۡلَمُ الۡجَهۡرَ وَمَا يَخۡفٰىؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092624087007.mp3"
    },
    {
      "number": 8,
      "text": "وَنُيَسِّرُكَ لِلۡيُسۡرٰى\u0026nbsp;\u0026zwnj;ۖ\u0026zwnj;ۚ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092653087008.mp3"
    },
    {
      "number": 9,
      "text": "\u0026nbsp;فَذَكِّرۡ اِنۡ نَّفَعَتِ الذِّكۡرٰىؕ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092733087009.mp3"
    },
    {
      "number": 10,
      "text": "سَيَذَّكَّرُ مَنۡ يَّخۡشٰىۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092802087010.mp3"
    },
    {
      "number": 11,
      "text": "\u0026nbsp;\u0026nbsp;وَيَتَجَنَّبُهَا الۡاَشۡقَىۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092842087011.mp3"
    },
    {
      "number": 12,
      "text": "\u0026nbsp;الَّذِىۡ يَصۡلَى النَّارَ الۡكُبۡرٰى\u0026zwnj;ۚ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092918087012.mp3"
    },
    {
      "number": 13,
      "text": "\u0026nbsp;ثُمَّ لَا يَمُوۡتُ فِيۡهَا وَلَا يَحۡيٰىؕ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092954087013.mp3"
    },
    {
      "number": 14,
      "text": "\u0026nbsp;قَدۡ اَفۡلَحَ مَنۡ تَزَكّٰىۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "093023087014.mp3"
    },
    {
      "number": 15,
      "text": "\u0026nbsp;وَذَكَرَ اسۡمَ رَبِّهٖ فَصَلّٰى\u0026zwnj;\u0026nbsp;ؕ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "093107087015.mp3"
    },
    {
      "number": 16,
      "text": "بَلۡ تُؤۡثِرُوۡنَ الۡحَيٰوةَ الدُّنۡيَا\u0026emsp;ۖ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "093139087016.mp3"
    },
    {
      "number": 17,
      "text": "\u0026nbsp;وَالۡاٰخِرَةُ خَيۡرٌ وَّ اَبۡقٰىؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "093222087017.mp3"
    },
    {
      "number": 18,
      "text": "اِنَّ هٰذَا لَفِى الصُّحُفِ الۡاُوۡلٰ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "093254087018.mp3"
    },
    {
      "number": 19,
      "text": "\u0026nbsp;صُحُفِ اِبۡرٰهِيۡمَ وَمُوۡسٰى\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "093328087019.mp3"
    }
  ]
}