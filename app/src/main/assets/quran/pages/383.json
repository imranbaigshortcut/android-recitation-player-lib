  "suraStart": true,
  "suraNo": 36,
  "ayatStart": 1,
  "ayatEnd": 12,
  "pageNo": 383,
  "ayatList": [
    {
      "number": 1,
      "text": "يٰسٓ ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversttelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "190516036001.mp3"
    },
    {
      "number": 2,
      "text": "وَالۡقُرۡاٰنِ الۡحَكِيۡمِ\u0026nbsp;ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "190642036002.mp3"
    },
    {
      "number": 3,
      "text": "اِنَّكَ لَمِنَ الۡمُرۡسَلِيۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "190747036003.mp3"
    },
    {
      "number": 4,
      "text": "عَلٰى صِرَاطٍ مُّسۡتَقِيۡمٍؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "191037036004.mp3"
    },
    {
      "number": 5,
      "text": "تَنۡزِيۡلَ الۡعَزِيۡزِ الرَّحِيۡمِ\u0026nbsp;ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "191157036005.mp3"
    },
    {
      "number": 6,
      "text": "لِتُنۡذِرَ قَوۡمًا مَّاۤ اُنۡذِرَ اٰبَآؤُهُمۡ فَهُمۡ غٰفِلُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "191259036006.mp3"
    },
    {
      "number": 7,
      "text": "لَقَدۡ حَقَّ الۡقَوۡلُ عَلٰٓى اَكۡثَرِهِمۡ فَهُمۡ لَا يُؤۡمِنُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "191414036007.mp3"
    },
    {
      "number": 8,
      "text": "اِنَّا جَعَلۡنَا فِىۡۤ اَعۡنَاقِهِمۡ اَغۡلٰلًا فَهِىَ اِلَى الۡاَ ذۡقَانِ فَهُمۡ مُّقۡمَحُوۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "191535036008.mp3"
    },
    {
      "number": 9,
      "text": "وَجَعَلۡنَا مِنۡۢ بَيۡنِ اَيۡدِيۡهِمۡ سَدًّا وَّمِنۡ خَلۡفِهِمۡ سَدًّا فَاَغۡشَيۡنٰهُمۡ فَهُمۡ لَا يُبۡصِرُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "191643036009.mp3"
    },
    {
      "number": 10,
      "text": "وَسَوَآءٌ عَلَيۡهِمۡ ءَاَنۡذَرۡتَهُمۡ اَمۡ لَمۡ تُنۡذِرۡهُمۡ لَا يُؤۡمِنُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "191806036010.mp3"
    },
    {
      "number": 11,
      "text": "اِنَّمَا تُنۡذِرُ مَنِ اتَّبَعَ الذِّكۡرَ وَخَشِىَ الرَّحۡمٰنَ بِالۡغَيۡبِۚ فَبَشِّرۡهُ بِمَغۡفِرَةٍ وَّاَجۡرٍ كَرِيۡمٍ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "192010036011.mp3"
    },
    {
      "number": 12,
      "text": "اِنَّا نَحۡنُ نُحۡىِ الۡمَوۡتٰى وَنَكۡتُبُ مَا قَدَّمُوۡا وَاٰثَارَهُمۡؕؔ وَكُلَّ شَىۡءٍ اَحۡصَيۡنٰهُ فِىۡۤ اِمَامٍ مُّبِيۡنٍ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "192122036012.mp3"
    }
  ]
}