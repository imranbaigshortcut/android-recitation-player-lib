{
  "maps": {},
  "suraStart": true,
  "suraNo": 78,
  "ayatStart": 1,
  "ayatEnd": 30,
  "pageNo": 520,
  "ayatList": [
    {
      "number": 1,
      "text": "عَمَّ يَتَسَآءَلُوۡنَ\u0026zwnj;ۚ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "182547078001.mp3"
    },
    {
      "number": 2,
      "text": "\u0026nbsp;عَنِ النَّبَاِ الۡعَظِيۡمِۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "182737078002.mp3"
    },
    {
      "number": 3,
      "text": "\u0026nbsp;\u0026nbsp;الَّذِىۡ هُمۡ فِيۡهِ مُخۡتَلِفُوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "183031078003.mp3"
    },
    {
      "number": 4,
      "text": "\u0026nbsp;\u0026nbsp;كَلَّا سَيَعۡلَمُوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "183146078004.mp3"
    },
    {
      "number": 5,
      "text": "\u0026nbsp;\u0026nbsp;ثُمَّ كَلَّا سَيَعۡلَمُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "183247078005.mp3"
    },
    {
      "number": 6,
      "text": "\u0026nbsp;\u0026nbsp;اَلَمۡ نَجۡعَلِ الۡاَرۡضَ مِهٰدًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "183355078006.mp3"
    },
    {
      "number": 7,
      "text": "\u0026nbsp;\u0026nbsp;وَّالۡجِبَالَ اَوۡتَادًا\u0026nbsp;ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "183544078007.mp3"
    },
    {
      "number": 8,
      "text": "\u0026nbsp;\u0026nbsp;وَّخَلَقۡنٰكُمۡ اَزۡوَاجًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "183658078008.mp3"
    },
    {
      "number": 9,
      "text": "\u0026nbsp;\u0026nbsp;وَّجَعَلۡنَا نَوۡمَكُمۡ سُبَاتًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "183809078009.mp3"
    },
    {
      "number": 10,
      "text": "\u0026nbsp;\u0026nbsp;وَّجَعَلۡنَا الَّيۡلَ لِبَاسًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "183918078010.mp3"
    },
    {
      "number": 11,
      "text": "\u0026nbsp;\u0026nbsp;وَّجَعَلۡنَا النَّهَارَ مَعَاشًا\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "184205078011.mp3"
    },
    {
      "number": 12,
      "text": "\u0026nbsp;\u0026nbsp;وَّبَنَيۡنَا فَوۡقَكُمۡ سَبۡعًا شِدَادًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "190545078012.mp3"
    },
    {
      "number": 13,
      "text": "\u0026nbsp;\u0026nbsp;وَّ جَعَلۡنَا سِرَاجًا وَّهَّاجًا\u0026nbsp;ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "190659078013.mp3"
    },
    {
      "number": 14,
      "text": "\u0026nbsp;\u0026nbsp;وَّاَنۡزَلۡنَا مِنَ الۡمُعۡصِرٰتِ مَآءً ثَجَّاجًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "190818078014.mp3"
    },
    {
      "number": 15,
      "text": "\u0026nbsp;\u0026nbsp;لِّـنُخۡرِجَ بِهٖ حَبًّا وَّنَبَاتًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "190913078015.mp3"
    },
    {
      "number": 16,
      "text": "\u0026nbsp;\u0026nbsp;وَّجَنّٰتٍ اَلۡفَافًا ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "191141078016.mp3"
    },
    {
      "number": 17,
      "text": "\u0026nbsp;\u0026nbsp;اِنَّ يَوۡمَ الۡفَصۡلِ كَانَ مِيۡقَاتًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "191303078017.mp3"
    },
    {
      "number": 18,
      "text": "\u0026nbsp;\u0026nbsp;يَّوۡمَ يُنۡفَخُ فِى الصُّوۡرِ فَتَاۡتُوۡنَ اَفۡوَاجًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "191500078018.mp3"
    },
    {
      "number": 19,
      "text": "\u0026nbsp;\u0026nbsp;وَّفُتِحَتِ السَّمَآءُ فَكَانَتۡ اَبۡوَابًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "191702078019.mp3"
    },
    {
      "number": 20,
      "text": "\u0026nbsp;\u0026nbsp;وَّ سُيِّرَتِ الۡجِبَالُ فَكَانَتۡ سَرَابًا ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "191747078020.mp3"
    },
    {
      "number": 21,
      "text": "\u0026nbsp;\u0026nbsp;اِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادًا\u0026nbsp;ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192320078021.mp3"
    },
    {
      "number": 22,
      "text": "\u0026nbsp;\u0026nbsp;لِّلطّٰغِيۡنَ مَاٰبًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192411078022.mp3"
    },
    {
      "number": 23,
      "text": "\u0026nbsp;\u0026nbsp;لّٰبِثِيۡنَ فِيۡهَاۤ اَحۡقَابًا\u0026zwnj; ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192454078023.mp3"
    },
    {
      "number": 24,
      "text": "\u0026nbsp;\u0026nbsp;لَا يَذُوۡقُوۡنَ فِيۡهَا بَرۡدًا وَّلَا شَرَابًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192539078024.mp3"
    },
    {
      "number": 25,
      "text": "\u0026nbsp;\u0026nbsp;اِلَّا حَمِيۡمًا وَّغَسَّاقًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192648078025.mp3"
    },
    {
      "number": 26,
      "text": "\u0026nbsp;\u0026nbsp;جَزَآءً وِّفَاقًا ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192738078026.mp3"
    },
    {
      "number": 27,
      "text": "\u0026nbsp;\u0026nbsp;اِنَّهُمۡ كَانُوۡا لَا يَرۡجُوۡنَ حِسَابًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192834078027.mp3"
    },
    {
      "number": 28,
      "text": "\u0026nbsp;\u0026nbsp;وَّكَذَّبُوۡا بِاٰيٰتِنَا كِذَّابًا ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192921078028.mp3"
    },
    {
      "number": 29,
      "text": "\u0026nbsp;\u0026nbsp;وَكُلَّ شَىۡءٍ اَحۡصَيۡنٰهُ كِتٰبًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193020078029.mp3"
    },
    {
      "number": 30,
      "text": "\u0026nbsp;\u0026nbsp;فَذُوۡقُوۡا فَلَنۡ نَّزِيۡدَكُمۡ اِلَّا عَذَابًا\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193102078030.mp3"
    }
  ]
}