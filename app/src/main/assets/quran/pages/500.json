{
  "maps": {},
  "suraStart": true,
  "suraNo": 68,
  "ayatStart": 1,
  "ayatEnd": 33,
  "pageNo": 500,
  "ayatList": [
    {
      "number": 1,
      "text": "نٓ\u0026zwnj; وَالۡقَلَمِ وَمَا يَسۡطُرُوۡنَۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "211934068001.mp3"
    },
    {
      "number": 2,
      "text": "مَاۤ اَنۡتَ بِـنِعۡمَةِ رَبِّكَ بِمَجۡنُوۡنٍ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "093605068002.mp3"
    },
    {
      "number": 3,
      "text": "وَاِنَّ لَڪَ لَاَجۡرًا غَيۡرَ مَمۡنُوۡنٍ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "093747068003.mp3"
    },
    {
      "number": 4,
      "text": "وَاِنَّكَ لَعَلٰى خُلُقٍ عَظِيۡمٍ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "093848068004.mp3"
    },
    {
      "number": 5,
      "text": "فَسَتُبۡصِرُ وَيُبۡصِرُوۡنَۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "094003068005.mp3"
    },
    {
      "number": 6,
      "text": "\u0026nbsp;بِاَيِّٮكُمُ الۡمَفۡتُوۡنُ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "094151068006.mp3"
    },
    {
      "number": 7,
      "text": "اِنَّ رَبَّكَ هُوَ اَعۡلَمُ بِمَنۡ ضَلَّ عَنۡ سَبِيۡلِهٖ وَهُوَ اَعۡلَمُ بِالۡمُهۡتَدِيۡنَ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "094333068007.mp3"
    },
    {
      "number": 8,
      "text": "\u0026nbsp;فَلَا تُطِعِ الۡمُكَذِّبِيۡنَ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "094558068008.mp3"
    },
    {
      "number": 9,
      "text": "وَدُّوۡا لَوۡ تُدۡهِنُ فَيُدۡهِنُوۡنَ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "094702068009.mp3"
    },
    {
      "number": 10,
      "text": "وَلَا تُطِعۡ كُلَّ حَلَّافٍ مَّهِيۡنٍۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "094850068010.mp3"
    },
    {
      "number": 11,
      "text": "هَمَّازٍ مَّشَّآءٍۢ بِنَمِيۡمٍۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "095037068011.mp3"
    },
    {
      "number": 12,
      "text": "مَّنَّاعٍ لِّلۡخَيۡرِ مُعۡتَدٍ اَثِيۡمٍۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "095227068012.mp3"
    },
    {
      "number": 13,
      "text": "عُتُلٍّ ۢ بَعۡدَ ذٰلِكَ زَنِيۡمٍۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "095327068013.mp3"
    },
    {
      "number": 14,
      "text": "اَنۡ كَانَ ذَا مَالٍ وَّبَنِيۡنَؕ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "095420068014.mp3"
    },
    {
      "number": 15,
      "text": "اِذَا تُتۡلٰى عَلَيۡهِ اٰيٰتُنَا قَالَ اَسَاطِيۡرُ الۡاَوَّلِيۡنَ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "095518068015.mp3"
    },
    {
      "number": 16,
      "text": "سَنَسِمُهٗ عَلَى الۡخُـرۡطُوۡمِ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "095737068016.mp3"
    },
    {
      "number": 17,
      "text": "اِنَّا بَلَوۡنٰهُمۡ كَمَا بَلَوۡنَاۤ اَصۡحٰبَ الۡجَـنَّةِ\u0026zwnj; ۚ اِذۡ اَقۡسَمُوۡا لَيَصۡرِمُنَّهَا مُصۡبِحِيۡنَ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "095912068017.mp3"
    },
    {
      "number": 18,
      "text": "وَلَا يَسۡتَثۡنُوۡنَ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "100005068018.mp3"
    },
    {
      "number": 19,
      "text": "فَطَافَ عَلَيۡهَا طَآٮِٕفٌ مِّنۡ رَّبِّكَ وَهُمۡ نَآٮِٕمُوۡنَ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "100109068019.mp3"
    },
    {
      "number": 20,
      "text": "فَاَصۡبَحَتۡ كَالصَّرِيۡمِۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "100242068020.mp3"
    },
    {
      "number": 21,
      "text": "فَتَـنَادَوۡا مُصۡبِحِيۡنَۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "100500068021.mp3"
    },
    {
      "number": 22,
      "text": "اَنِ اغۡدُوۡا عَلٰى حَرۡثِكُمۡ اِنۡ كُنۡتُمۡ صٰرِمِيۡنَ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "100659068022.mp3"
    },
    {
      "number": 23,
      "text": "فَانۡطَلَقُوۡا وَهُمۡ يَتَخَافَتُوۡنَۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "100845068023.mp3"
    },
    {
      "number": 24,
      "text": "اَنۡ لَّا يَدۡخُلَنَّهَا الۡيَوۡمَ عَلَيۡكُمۡ مِّسۡكِيۡنٌۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "101021068024.mp3"
    },
    {
      "number": 25,
      "text": "وَّغَدَوۡا عَلٰى حَرۡدٍ قٰدِرِيۡنَ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "101152068025.mp3"
    },
    {
      "number": 26,
      "text": "فَلَمَّا رَاَوۡهَا قَالُوۡۤا اِنَّا لَـضَآلُّوۡنَۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "101246068026.mp3"
    },
    {
      "number": 27,
      "text": "بَلۡ نَحۡنُ مَحۡرُوۡمُوۡنَ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "101353068027.mp3"
    },
    {
      "number": 28,
      "text": "قَالَ اَوۡسَطُهُمۡ اَلَمۡ اَقُلۡ لَّكُمۡ لَوۡلَا تُسَبِّحُوۡنَ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "101452068028.mp3"
    },
    {
      "number": 29,
      "text": "قَالُوۡا سُبۡحٰنَ رَبِّنَاۤ اِنَّا كُنَّا ظٰلِمِيۡنَ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "101547068029.mp3"
    },
    {
      "number": 30,
      "text": "فَاَقۡبَلَ بَعۡضُهُمۡ عَلٰى بَعۡضٍ يَّتَلَاوَمُوۡنَ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "101738068030.mp3"
    },
    {
      "number": 31,
      "text": "قَالُوۡا يٰوَيۡلَنَاۤ اِنَّا كُنَّا طٰغِيۡنَ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "101919068031.mp3"
    },
    {
      "number": 32,
      "text": "عَسٰى رَبُّنَاۤ اَنۡ يُّبۡدِلَـنَا خَيۡرًا مِّنۡهَاۤ اِنَّاۤ اِلٰى رَبِّنَا رٰغِبُوۡنَ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "102033068032.mp3"
    },
    {
      "number": 33,
      "text": "كَذٰلِكَ الۡعَذَابُ\u0026zwnj;ؕ وَلَعَذَابُ الۡاٰخِرَةِ اَكۡبَرُ \u0026zwnj;ۘ لَوۡ كَانُوۡا يَعۡلَمُوۡنَ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "102201068033.mp3"
    }
  ]
}