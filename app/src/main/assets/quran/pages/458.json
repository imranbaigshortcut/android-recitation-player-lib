{
  "maps": {},
  "suraStart": false,
  "suraNo": 51,
  "ayatStart": 24,
  "ayatEnd": 46,
  "pageNo": 458,
  "ayatList": [
    {
      "number": 24,
      "text": "\u0026nbsp;هَلۡ اَتٰٮكَ حَدِيۡثُ ضَيۡفِ اِبۡرٰهِيۡمَ الۡمُكۡرَمِيۡنَ\u0026zwnj;ۘ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "001750051024.mp3"
    },
    {
      "number": 25,
      "text": "اِذۡ دَخَلُوۡا عَلَيۡهِ فَقَالُوۡا سَلٰمًا\u0026zwnj;ؕ قَالَ سَلٰمٌ\u0026nbsp;ۚ قَوۡمٌ مُّنۡكَرُوۡنَ\u0026zwnj;\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "001841051025.mp3"
    },
    {
      "number": 26,
      "text": "فَرَاغَ اِلٰٓى اَهۡلِهٖ فَجَآءَ بِعِجۡلٍ سَمِيۡنٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "001947051026.mp3"
    },
    {
      "number": 27,
      "text": "فَقَرَّبَهٗۤ اِلَيۡهِمۡ قَالَ اَلَا تَاۡكُلُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "002058051027.mp3"
    },
    {
      "number": 28,
      "text": "فَاَوۡجَسَ مِنۡهُمۡ خِيۡفَةً\u0026nbsp;\u0026nbsp;\u0026zwnj;ؕ قَالُوۡا لَا تَخَفۡ\u0026zwnj;\u0026nbsp;ؕ وَبَشَّرُوۡهُ بِغُلٰمٍ عَلِيۡمٍ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "002200051028.mp3"
    },
    {
      "number": 29,
      "text": "فَاَقۡبَلَتِ امۡرَاَتُهٗ فِىۡ صَرَّةٍ فَصَكَّتۡ وَجۡهَهَا وَقَالَتۡ عَجُوۡزٌ عَقِيۡمٌ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "002252051029.mp3"
    },
    {
      "number": 30,
      "text": "قَالُوۡا كَذٰلِكِ\u0026nbsp;ۙ قَالَ رَبُّكِ\u0026zwnj;ؕ اِنَّهٗ هُوَ الۡحَكِيۡمُ الۡعَلِيۡمُ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "002355051030.mp3"
    },
    {
      "number": 31,
      "text": "قَالَ فَمَا خَطۡبُكُمۡ اَيُّهَا الۡمُرۡسَلُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "002538051031.mp3"
    },
    {
      "number": 32,
      "text": "قَالُـوۡۤا اِنَّاۤ اُرۡسِلۡنَاۤ اِلٰى قَوۡمٍ مُّجۡرِمِيۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "002753051032.mp3"
    },
    {
      "number": 33,
      "text": "لِنُرۡسِلَ عَلَيۡهِمۡ حِجَارَةً مِّنۡ طِيۡنٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "002916051033.mp3"
    },
    {
      "number": 34,
      "text": "مُّسَوَّمَةً عِنۡدَ رَبِّكَ لِلۡمُسۡرِفِيۡنَ",
      "translationNo": "Her kommer norsk oversettlse",
      "commentary": "",
      "audioTalawat": "003214051034.mp3"
    },
    {
      "number": 35,
      "text": "فَاَخۡرَجۡنَا مَنۡ كَانَ فِيۡهَا مِنَ الۡمُؤۡمِنِيۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "003538051035.mp3"
    },
    {
      "number": 36,
      "text": "فَمَا وَجَدۡنَا فِيۡهَا غَيۡرَ بَيۡتٍ مِّنَ الۡمُسۡلِمِيۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "003645051036.mp3"
    },
    {
      "number": 37,
      "text": "وَتَرَكۡنَا فِيۡهَاۤ اٰيَةً لِّـلَّذِيۡنَ يَخَافُوۡنَ الۡعَذَابَ الۡاَلِيۡمَؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "003753051037.mp3"
    },
    {
      "number": 38,
      "text": "وَفِىۡ مُوۡسٰۤی اِذۡ اَرۡسَلۡنٰهُ اِلٰى فِرۡعَوۡنَ بِسُلۡطٰنٍ مُّبِيۡنٍ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "003911051038.mp3"
    },
    {
      "number": 39,
      "text": "فَتَوَلّٰى بِرُكۡنِهٖ وَقَالَ سٰحِرٌ اَوۡ مَجۡنُوۡنٌ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "004338051039.mp3"
    },
    {
      "number": 40,
      "text": "فَاَخَذۡنٰهُ وَجُنُوۡدَهٗ فَنَبَذۡنٰهُمۡ فِى الۡيَمِّ وَهُوَ مُلِيۡمٌؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "004508051040.mp3"
    },
    {
      "number": 41,
      "text": "وَفِىۡ عَادٍ اِذۡ اَرۡسَلۡنَا عَلَيۡهِمُ الرِّيۡحَ الۡعَقِيۡمَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "004636051041.mp3"
    },
    {
      "number": 42,
      "text": "مَا تَذَرُ مِنۡ شَىۡءٍ اَتَتۡ عَلَيۡهِ اِلَّا جَعَلَتۡهُ كَالرَّمِيۡمِؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "004743051042.mp3"
    },
    {
      "number": 43,
      "text": "وَفِىۡ ثَمُوۡدَ اِذۡ قِيۡلَ لَهُمۡ تَمَتَّعُوۡا حَتّٰى حِيۡنٍ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "004906051043.mp3"
    },
    {
      "number": 44,
      "text": "فَعَتَوۡا عَنۡ اَمۡرِ رَبِّهِمۡ فَاَخَذَتۡهُمُ الصّٰعِقَةُ وَ هُمۡ يَنۡظُرُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "005009051044.mp3"
    },
    {
      "number": 45,
      "text": "فَمَا اسۡتَطَاعُوۡا مِنۡ قِيَامٍ وَّمَا كَانُوۡا مُنۡتَصِرِيۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "005117051045.mp3"
    },
    {
      "number": 46,
      "text": "وَقَوۡمَ نُوۡحٍ مِّنۡ قَبۡلُ\u0026zwnj;ؕ اِنَّهُمۡ كَانُوۡا قَوۡمًا فٰسِقِيۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "005213051046.mp3"
    }
  ]
}