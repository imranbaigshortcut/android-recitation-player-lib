{
  "maps": {},
  "suraStart": true,
  "suraNo": 51,
  "ayatStart": 1,
  "ayatEnd": 23,
  "pageNo": 457,
  "ayatList": [
    {
      "number": 1,
      "text": "وَالذّٰرِيٰتِ ذَرۡوًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "234818051001.mp3"
    },
    {
      "number": 2,
      "text": "فَالۡحٰمِلٰتِ وِقۡرًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "234903051002.mp3"
    },
    {
      "number": 3,
      "text": "فَالۡجٰرِيٰتِ يُسۡرًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "234951051003.mp3"
    },
    {
      "number": 4,
      "text": "فَالۡمُقَسِّمٰتِ اَمۡرًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "235436051004.mp3"
    },
    {
      "number": 5,
      "text": "اِنَّمَا تُوۡعَدُوۡنَ لَصَادِقٌ\u0026ensp;ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "235532051005.mp3"
    },
    {
      "number": 6,
      "text": "وَّاِنَّ الدِّيۡنَ لوَاقِعٌ\u0026ensp;ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "235621051006.mp3"
    },
    {
      "number": 7,
      "text": "وَالسَّمَآءِ ذَاتِ الۡحُـبُكِ ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "235709051007.mp3"
    },
    {
      "number": 8,
      "text": "اِنَّـكُمۡ لَفِىۡ قَوۡلٍ مُّخۡتَلِفٍ ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "235756051008.mp3"
    },
    {
      "number": 9,
      "text": "يُّـؤۡفَكُ عَنۡهُ مَنۡ اُفِكَ ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "235851051009.mp3"
    },
    {
      "number": 10,
      "text": "قُتِلَ الۡخَـرّٰصُوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "235939051010.mp3"
    },
    {
      "number": 11,
      "text": "الَّذِيۡنَ هُمۡ فِىۡ غَمۡرَةٍ سَاهُوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "000118051011.mp3"
    },
    {
      "number": 12,
      "text": "يَسۡـَٔــلُوۡنَ اَيَّانَ يَوۡمُ الدِّيۡنِؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "000236051012.mp3"
    },
    {
      "number": 13,
      "text": "يَوۡمَ هُمۡ عَلَى النَّارِ يُفۡتَنُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "000350051013.mp3"
    },
    {
      "number": 14,
      "text": "ذُوۡقُوۡا فِتۡنَتَكُمۡؕ هٰذَا الَّذِىۡ كُنۡتُمۡ بِهٖ تَسۡتَعۡجِلُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "000445051014.mp3"
    },
    {
      "number": 15,
      "text": "اِنَّ الۡمُتَّقِيۡنَ فِىۡ جَنّٰتٍ وَّعُيُوۡنٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "000530051015.mp3"
    },
    {
      "number": 16,
      "text": "اٰخِذِيۡنَ مَاۤ اٰتٰٮهُمۡ رَبُّهُمۡ\u0026zwnj;ؕ اِنَّهُمۡ كَانُوۡا قَبۡلَ ذٰلِكَ مُحۡسِنِيۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "000700051016.mp3"
    },
    {
      "number": 17,
      "text": "كَانُوۡا قَلِيۡلًا مِّنَ الَّيۡلِ مَا يَهۡجَعُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "000823051017.mp3"
    },
    {
      "number": 18,
      "text": "وَبِالۡاَسۡحَارِ هُمۡ يَسۡتَغۡفِرُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "001025051018.mp3"
    },
    {
      "number": 19,
      "text": "وَفِىۡۤ اَمۡوَالِهِمۡ حَقٌّ لِّلسَّآٮِٕلِ وَالۡمَحۡرُوۡمِ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "001200051019.mp3"
    },
    {
      "number": 20,
      "text": "وَفِى الۡاَرۡضِ اٰيٰتٌ لِّلۡمُوۡقِنِيۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "001252051020.mp3"
    },
    {
      "number": 21,
      "text": "وَفِىۡۤ اَنۡفُسِكُمۡ\u0026zwnj;ؕ اَفَلَا تُبۡصِرُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "001346051021.mp3"
    },
    {
      "number": 22,
      "text": "وَفِى السَّمَآءِ رِزۡقُكُمۡ وَمَا تُوۡعَدُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "001437051022.mp3"
    },
    {
      "number": 23,
      "text": "فَوَرَبِّ السَّمَآءِ وَالۡاَرۡضِ اِنَّهٗ لَحَـقٌّ مِّثۡلَ مَاۤ اَنَّكُمۡ تَنۡطِقُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "001540051023.mp3"
    }
  ]
}