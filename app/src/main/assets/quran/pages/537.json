{
  "maps": {},
  "suraStart": true,
  "suraNo": 93,
  "ayatStart": 1,
  "ayatEnd": 11,
  "pageNo": 537,
  "ayatList": [
    {
      "number": 1,
      "text": "وَالضُّحٰىۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "191203093001.mp3"
    },
    {
      "number": 2,
      "text": "\u0026nbsp;\u0026nbsp;وَالَّيۡلِ اِذَا سَجٰىۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "191255093002.mp3"
    },
    {
      "number": 3,
      "text": "\u0026nbsp;\u0026nbsp;مَا وَدَّعَكَ رَبُّكَ وَمَا قَلٰىؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "191505093003.mp3"
    },
    {
      "number": 4,
      "text": "\u0026nbsp;\u0026nbsp;وَلَـلۡاٰخِرَةُ خَيۡرٌ لَّكَ مِنَ الۡاُوۡلٰىؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "191601093004.mp3"
    },
    {
      "number": 5,
      "text": "\u0026nbsp;\u0026nbsp;وَلَسَوۡفَ يُعۡطِيۡكَ رَبُّكَ فَتَرۡضٰىؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "191648093005.mp3"
    },
    {
      "number": 6,
      "text": "\u0026nbsp;\u0026nbsp;اَلَمۡ يَجِدۡكَ يَتِيۡمًا فَاٰوٰى\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "191809093006.mp3"
    },
    {
      "number": 7,
      "text": "\u0026nbsp;\u0026nbsp;وَوَجَدَكَ ضَآ لًّا فَهَدٰى\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "191848093007.mp3"
    },
    {
      "number": 8,
      "text": "\u0026nbsp;\u0026nbsp;وَوَجَدَكَ عَآٮِٕلًا فَاَغۡنٰىؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "191950093008.mp3"
    },
    {
      "number": 9,
      "text": "\u0026nbsp;\u0026nbsp;فَاَمَّا الۡيَتِيۡمَ فَلَا تَقۡهَرۡؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192412093009.mp3"
    },
    {
      "number": 10,
      "text": "\u0026nbsp;\u0026nbsp;وَاَمَّا السَّآٮِٕلَ فَلَا تَنۡهَرۡؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192848093010.mp3"
    },
    {
      "number": 11,
      "text": "وَاَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194805093011.mp3"
    }
  ]
}