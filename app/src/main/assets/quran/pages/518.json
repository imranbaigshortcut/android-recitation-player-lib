{
  "maps": {},
  "suraStart": true,
  "suraNo": 77,
  "ayatStart": 1,
  "ayatEnd": 40,
  "pageNo": 518,
  "ayatList": [
    {
      "number": 1,
      "text": "وَالۡمُرۡسَلٰتِ عُرۡفًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "224724077001.mp3"
    },
    {
      "number": 2,
      "text": "\u0026nbsp;فَالۡعٰصِفٰتِ عَصۡفًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "224914077002.mp3"
    },
    {
      "number": 3,
      "text": "وَّالنّٰشِرٰتِ نَشۡرًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "225138077003.mp3"
    },
    {
      "number": 4,
      "text": "فَالۡفٰرِقٰتِ فَرۡقًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "225255077004.mp3"
    },
    {
      "number": 5,
      "text": "فَالۡمُلۡقِيٰتِ ذِكۡرًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "225343077005.mp3"
    },
    {
      "number": 6,
      "text": "عُذۡرًا اَوۡ نُذۡرًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "225431077006.mp3"
    },
    {
      "number": 7,
      "text": "اِنَّمَا تُوۡعَدُوۡنَ لَوَاقِعٌ\u0026ensp;ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "225528077007.mp3"
    },
    {
      "number": 8,
      "text": "\u0026nbsp;فَاِذَا النُّجُوۡمُ طُمِسَتۡۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "225654077008.mp3"
    },
    {
      "number": 9,
      "text": "وَ اِذَا السَّمَآءُ فُرِجَتۡۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "225809077009.mp3"
    },
    {
      "number": 10,
      "text": "وَاِذَا الۡجِبَالُ نُسِفَتۡۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "225856077010.mp3"
    },
    {
      "number": 11,
      "text": "وَاِذَا الرُّسُلُ اُقِّتَتۡؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "225944077011.mp3"
    },
    {
      "number": 12,
      "text": "﻿\u0026nbsp;لِاَىِّ يَوۡمٍ اُجِّلَتۡؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "230101077012.mp3"
    },
    {
      "number": 13,
      "text": "لِيَوۡمِ الۡفَصۡلِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "230154077013.mp3"
    },
    {
      "number": 14,
      "text": "وَمَاۤ اَدۡرٰٮكَ مَا يَوۡمُ الۡفَصۡلِؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "230305077014.mp3"
    },
    {
      "number": 15,
      "text": "وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "230658077015.mp3"
    },
    {
      "number": 16,
      "text": "اَلَمۡ نُهۡلِكِ الۡاَوَّلِيۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "230753077016.mp3"
    },
    {
      "number": 17,
      "text": "ثُمَّ نُتۡبِعُهُمُ الۡاٰخِرِيۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "230845077017.mp3"
    },
    {
      "number": 18,
      "text": "كَذٰلِكَ نَفۡعَلُ بِالۡمُجۡرِمِيۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "230950077018.mp3"
    },
    {
      "number": 19,
      "text": "وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "231109077019.mp3"
    },
    {
      "number": 20,
      "text": "اَلَمۡ نَخۡلُقۡكُّمۡ مِّنۡ مَّآءٍ مَّهِيۡنٍۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "231219077020.mp3"
    },
    {
      "number": 21,
      "text": "فَجَعَلۡنٰهُ فِىۡ قَرَارٍ مَّكِيۡنٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "231314077021.mp3"
    },
    {
      "number": 22,
      "text": "اِلٰى قَدَرٍ مَّعۡلُوۡمٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "231405077022.mp3"
    },
    {
      "number": 23,
      "text": "فَقَدَرۡنَا\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;ۖ فَنِعۡمَ الۡقٰدِرُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "231449077023.mp3"
    },
    {
      "number": 24,
      "text": "وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "231633077024.mp3"
    },
    {
      "number": 25,
      "text": "اَلَمۡ نَجۡعَلِ الۡاَرۡضَ كِفَاتًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "231731077025.mp3"
    },
    {
      "number": 26,
      "text": "اَحۡيَآءً وَّاَمۡوَاتًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "231844077026.mp3"
    },
    {
      "number": 27,
      "text": "وَّجَعَلۡنَا فِيۡهَا رَوَاسِىَ شٰمِخٰتٍ وَّ اَسۡقَيۡنٰكُمۡ مَّآءً فُرَاتًا ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "232041077027.mp3"
    },
    {
      "number": 28,
      "text": "وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "232135077028.mp3"
    },
    {
      "number": 29,
      "text": "اِنْطَلِقُوۡۤا اِلٰى مَا كُنۡتُمۡ بِهٖ تُكَذِّبُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "232255077029.mp3"
    },
    {
      "number": 30,
      "text": "اِنْطَلِقُوۡۤا اِلٰى ظِلٍّ ذِىۡ ثَلٰثِ شُعَبٍۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "232409077030.mp3"
    },
    {
      "number": 31,
      "text": "لَّا ظَلِيۡلٍ وَّلَا يُغۡنِىۡ مِنَ اللَّهَبِؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "100825077031.mp3"
    },
    {
      "number": 32,
      "text": "اِنَّهَا تَرۡمِىۡ بِشَرَرٍ كَالۡقَصۡرِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "101206077032.mp3"
    },
    {
      "number": 33,
      "text": "كَاَنَّهٗ جِمٰلَتٌ صُفۡرٌ ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "101335077033.mp3"
    },
    {
      "number": 34,
      "text": "وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "101452077034.mp3"
    },
    {
      "number": 35,
      "text": "هٰذَا يَوۡمُ لَا يَنۡطِقُوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "101553077035.mp3"
    },
    {
      "number": 36,
      "text": "وَلَا يُؤۡذَنُ لَهُمۡ فَيَـعۡتَذِرُوۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "101659077036.mp3"
    },
    {
      "number": 37,
      "text": "وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "101903077037.mp3"
    },
    {
      "number": 38,
      "text": "هٰذَا يَوۡمُ الۡفَصۡلِ\u0026zwnj;ۚ جَمَعۡنٰكُمۡ وَالۡاَوَّلِيۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "102015077038.mp3"
    },
    {
      "number": 39,
      "text": "فَاِنۡ كَانَ لَـكُمۡ كَيۡدٌ فَكِيۡدُوۡنِ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "102115077039.mp3"
    },
    {
      "number": 40,
      "text": "وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "102216077040.mp3"
    }
  ]
}