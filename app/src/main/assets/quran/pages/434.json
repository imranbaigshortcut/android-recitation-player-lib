  "ayatList": [
    {
      "number": 30,
      "text": "وَلَقَدۡ نَجَّيۡنَا بَنِىۡۤ اِسۡرَآءِيۡلَ مِنَ الۡعَذَابِ الۡمُهِيۡنِۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "174738044030.mp3"
    },
    {
      "number": 31,
      "text": "مِنۡ فِرۡعَوۡنَ\u0026zwnj;ؕ اِنَّهٗ كَانَ عَالِيًا مِّنَ الۡمُسۡرِفِيۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "175225044031.mp3"
    },
    {
      "number": 32,
      "text": "وَلَقَدِ اخۡتَرۡنٰهُمۡ عَلٰى عِلۡمٍ عَلَى الۡعٰلَمِيۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "175316044032.mp3"
    },
    {
      "number": 33,
      "text": "وَاٰتَيۡنٰهُمۡ مِّنَ الۡاٰيٰتِ مَا فِيۡهِ بَلٰٓؤٌا مُّبِيۡنٌ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "175426044033.mp3"
    },
    {
      "number": 34,
      "text": "اِنَّ هٰٓؤُلَاۤءِ لَيَقُوۡلُوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "175520044034.mp3"
    },
    {
      "number": 35,
      "text": "اِنۡ هِىَ اِلَّا مَوۡتَتُنَا الۡاُوۡلٰى وَمَا نَحۡنُ بِمُنۡشَرِيۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "175623044035.mp3"
    },
    {
      "number": 36,
      "text": "فَاۡتُوۡا بِاٰبَآٮِٕنَاۤ اِنۡ كُنۡتُمۡ صٰدِقِيۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "175718044036.mp3"
    },
    {
      "number": 37,
      "text": "اَهُمۡ خَيۡرٌ اَمۡ قَوۡمُ تُبَّعٍۙ وَّ الَّذِيۡنَ مِنۡ قَبۡلِهِمۡ\u0026zwnj;ؕ اَهۡلَكۡنٰهُمۡ\u0026zwnj; اِنَّهُمۡ كَانُوۡا مُجۡرِمِيۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "175815044037.mp3"
    },
    {
      "number": 38,
      "text": "وَمَا خَلَقۡنَا السَّمٰوٰتِ وَالۡاَرۡضَ وَمَا بَيۡنَهُمَا لٰعِبِيۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "175913044038.mp3"
    },
    {
      "number": 39,
      "text": "مَا خَلَقۡنٰهُمَاۤ اِلَّا بِالۡحَقِّ وَلٰكِنَّ اَكۡثَرَهُمۡ لَا يَعۡلَمُوۡنَ\u0026rlm; ",
      "translationNo": "Her komemr norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "180017044039.mp3"
    },
    {
      "number": 40,
      "text": "اِنَّ يَوۡمَ الۡفَصۡلِ مِيۡقَاتُهُمۡ اَجۡمَعِيۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "180122044040.mp3"
    },
    {
      "number": 41,
      "text": "يَوۡمَ لَا يُغۡنِىۡ مَوۡلًى عَنۡ مَّوۡلًى شَيۡــًٔا وَّلَا هُمۡ يُنۡصَرُوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "185529044041.mp3"
    },
    {
      "number": 42,
      "text": "اِلَّا مَنۡ رَّحِمَ اللّٰهُ\u0026zwnj;ؕ اِنَّهٗ هُوَ الۡعَزِيۡزُ الرَّحِيۡمُ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "185735044042.mp3"
    }
  ]
}