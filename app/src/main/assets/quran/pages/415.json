  "ayatList": [
    {
      "number": 1,
      "text": "حٰمٓ\u0026zwnj; ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "132601041001.mp3"
    },
    {
      "number": 2,
      "text": "تَنۡزِيۡلٌ مِّنَ الرَّحۡمٰنِ الرَّحِيۡمِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "132640041002.mp3"
    },
    {
      "number": 3,
      "text": "كِتٰبٌ فُصِّلَتۡ اٰيٰتُهٗ قُرۡاٰنًا عَرَبِيًّا لِّقَوۡمٍ يَّعۡلَمُوۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "132744041003.mp3"
    },
    {
      "number": 4,
      "text": "بَشِيۡرًا وَّنَذِيۡرًا\u0026zwnj; ۚ فَاَعۡرَضَ اَكۡثَرُهُمۡ فَهُمۡ لَا يَسۡمَعُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "132820041004.mp3"
    },
    {
      "number": 5,
      "text": "وَقَالُوۡا قُلُوۡبُنَا فِىۡۤ اَكِنَّةٍ مِّمَّا تَدۡعُوۡنَاۤ اِلَيۡهِ وَفِىۡۤ اٰذَانِنَا وَقۡرٌ وَّمِنۡۢ بَيۡنِنَا وَبَيۡنِكَ حِجَابٌ فَاعۡمَلۡ اِنَّنَا عٰمِلُوۡنَ\u0026rlm;",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "150130041005.mp3"
    },
    {
      "number": 6,
      "text": "قُلۡ اِنَّمَاۤ اَنَا بَشَرٌ مِّثۡلُكُمۡ يُوۡحٰٓى اِلَىَّ اَنَّمَاۤ اِلٰهُكُمۡ اِلٰـهٌ وَّاحِدٌ فَاسۡتَقِيۡمُوۡۤا اِلَيۡهِ وَاسۡتَغۡفِرُوۡهُ\u0026zwnj; ؕ وَوَيۡلٌ لِّلۡمُشۡرِكِيۡنَ ۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "133034041006.mp3"
    },
    {
      "number": 7,
      "text": "الَّذِيۡنَ لَا يُؤۡتُوۡنَ الزَّكٰوةَ وَهُمۡ بِالۡاٰخِرَةِ هُمۡ كٰفِرُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "133114041007.mp3"
    },
    {
      "number": 8,
      "text": "اِنَّ الَّذِيۡنَ اٰمَنُوۡا وَعَمِلُوا الصّٰلِحٰتِ لَهُمۡ اَجۡرٌ غَيۡرُ مَمۡنُوۡنٍ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "133153041008.mp3"
    }
  ]
}