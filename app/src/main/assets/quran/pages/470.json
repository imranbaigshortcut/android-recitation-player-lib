  "ayatList": [
    {
      "number": 46,
      "text": "وَلِمَنۡ خَافَ مَقَامَ رَبِّهٖ جَنَّتٰنِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
