      "audioTalawat": "181326055046.mp3"
    },
    {
      "number": 47,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "181418055047.mp3"
    },
    {
      "number": 48,
      "text": "ذَوَاتَاۤ اَفۡنَانٍ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "181459055048.mp3"
    },
    {
      "number": 49,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "181546055049.mp3"
    },
    {
      "number": 50,
      "text": "فِيۡهِمَا عَيۡنٰنِ تَجۡرِيٰنِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "181634055050.mp3"
    },
    {
      "number": 51,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "181717055051.mp3"
    },
    {
      "number": 52,
      "text": "فِيۡهِمَا مِنۡ كُلِّ فَاكِهَةٍ زَوۡجٰنِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "181807055052.mp3"
    },
    {
      "number": 53,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "181850055053.mp3"
    },
    {
      "number": 54,
      "text": "مُتَّكِـــِٕيۡنَ عَلٰى فُرُشٍۢ بَطَآٮِٕنُهَا مِنۡ اِسۡتَبۡرَقٍ\u0026zwnj;ؕ وَجَنَی الۡجَـنَّتَيۡنِ دَانٍ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "181938055054.mp3"
    },
    {
      "number": 55,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "182024055055.mp3"
    },
    {
      "number": 56,
      "text": "فِيۡهِنَّ قٰصِرٰتُ الطَّرۡفِۙ لَمۡ يَطۡمِثۡهُنَّ اِنۡسٌ قَبۡلَهُمۡ وَلَا جَآنٌّ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "182110055056.mp3"
    },
    {
      "number": 57,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "182152055057.mp3"
    },
    {
      "number": 58,
      "text": "كَاَنَّهُنَّ الۡيَاقُوۡتُ وَالۡمَرۡجَانُ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "182238055058.mp3"
    },
    {
      "number": 59,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ\u0026rlm;",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "182323055059.mp3"
    },
    {
      "number": 60,
      "text": "هَلۡ جَزَآءُ الْاِحۡسَانِ اِلَّا الۡاِحۡسَانُ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "182404055060.mp3"
    },
    {
      "number": 61,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "182458055061.mp3"
    },
    {
      "number": 62,
      "text": "وَمِنۡ دُوۡنِهِمَا جَنَّتٰنِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "182542055062.mp3"
    },
    {
      "number": 63,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "182623055063.mp3"
    },
    {
      "number": 64,
      "text": "مُدۡهَآمَّتٰنِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "182708055064.mp3"
    },
    {
      "number": 65,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "182758055065.mp3"
    },
    {
      "number": 66,
      "text": "فِيۡهِمَا عَيۡنٰنِ نَضَّاخَتٰنِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "182841055066.mp3"
    },
    {
      "number": 67,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "182926055067.mp3"
    },
    {
      "number": 68,
      "text": "فِيۡهِمَا فَاكِهَةٌ وَّنَخۡلٌ وَّرُمَّانٌ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "183011055068.mp3"
    },
    {
      "number": 69,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "183102055069.mp3"
    },
    {
      "number": 70,
      "text": "فِيۡهِنَّ خَيۡرٰتٌ حِسَانٌ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "183143055070.mp3"
    },
    {
      "number": 71,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "183222055071.mp3"
    },
    {
      "number": 72,
      "text": "حُوۡرٌ مَّقۡصُوۡرٰتٌ فِى الۡخِيَامِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
