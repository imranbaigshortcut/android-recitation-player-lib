{
  "maps": {},
  "suraStart": true,
  "suraNo": 43,
  "ayatStart": 1,
  "ayatEnd": 15,
  "pageNo": 426,
  "ayatList": [
    {
      "number": 1,
      "text": "حٰمٓ\u0026ensp;\u0026zwnj; ۛ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "152703043001.mp3"
    },
    {
      "number": 2,
      "text": "وَالۡكِتٰبِ الۡمُبِيۡنِ\u0026ensp;\u0026zwnj; ۛ\u0026zwnj;ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "152820043002.mp3"
    },
    {
      "number": 3,
      "text": "اِنَّا جَعَلۡنٰهُ قُرۡءٰنًا عَرَبِيًّا لَّعَلَّكُمۡ تَعۡقِلُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "152928043003.mp3"
    },
    {
      "number": 4,
      "text": "وَاِنَّهٗ فِىۡۤ اُمِّ الۡكِتٰبِ لَدَيۡنَا لَعَلِىٌّ حَكِيۡمٌؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "153007043004.mp3"
    },
    {
      "number": 5,
      "text": "اَفَنَضۡرِبُ عَنۡكُمُ الذِّكۡرَ صَفۡحًا اَنۡ كُنۡتُمۡ قَوۡمًا مُّسۡرِفِيۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "153057043005.mp3"
    },
    {
      "number": 6,
      "text": "وَكَمۡ اَرۡسَلۡنَا مِنۡ نَّبِىٍّ فِى الۡاَوَّلِيۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "153159043006.mp3"
    },
    {
      "number": 7,
      "text": "وَمَا يَاۡتِيۡهِمۡ مِّنۡ نَّبِىٍّ اِلَّا كَانُوۡا بِهٖ يَسۡتَهۡزِءُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "153241043007.mp3"
    },
    {
      "number": 8,
      "text": "فَاَهۡلَـكۡنَاۤ اَشَدَّ مِنۡهُمۡ بَطۡشًا وَّمَضٰى مَثَلُ الۡاَوَّلِيۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "153333043008.mp3"
    },
    {
      "number": 9,
      "text": "وَلَٮِٕنۡ سَاَلۡتَهُمۡ مَّنۡ خَلَقَ السَّمٰوٰتِ وَالۡاَرۡضَ لَيَقُوۡلُنَّ خَلَقَهُنَّ الۡعَزِيۡزُ الۡعَلِيۡمُۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "153420043009.mp3"
    },
    {
      "number": 10,
      "text": "الَّذِىۡ جَعَلَ لَـكُمُ الۡاَرۡضَ مَهۡدًا وَّ جَعَلَ لَكُمۡ فِيۡهَا سُبُلًا لَّعَلَّكُمۡ تَهۡتَدُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "153531043010.mp3"
    },
    {
      "number": 11,
      "text": "وَالَّذِىۡ نَزَّلَ مِنَ السَّمَآءِ مَآءًۢ بِقَدَرٍ\u0026zwnj;ۚ فَاَنۡشَرۡنَا بِهٖ بَلۡدَةً مَّيۡتًا\u0026zwnj;\u0026nbsp;ۚ كَذٰلِكَ تُخۡرَجُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "153710043011.mp3"
    },
    {
      "number": 12,
      "text": "وَالَّذِىۡ خَلَقَ الۡاَزۡوَاجَ كُلَّهَا وَجَعَلَ لَكُمۡ مِّنَ الۡفُلۡكِ وَالۡاَنۡعَامِ مَا تَرۡكَبُوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "153751043012.mp3"
    },
    {
      "number": 13,
      "text": "لِتَسۡتَوٗا عَلٰى ظُهُوۡرِهٖ ثُمَّ تَذۡكُرُوۡا نِعۡمَةَ رَبِّكُمۡ اِذَا اسۡتَوَيۡتُمۡ عَلَيۡهِ وَتَقُوۡلُوۡا سُبۡحٰنَ الَّذِىۡ سَخَّرَ لَنَا هٰذَا وَمَا كُنَّا لَهٗ مُقۡرِنِيۡنَۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "154016043013.mp3"
    },
    {
      "number": 14,
      "text": "وَاِنَّاۤ اِلٰى رَبِّنَا لَمُنۡقَلِبُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "154148043014.mp3"
    },
    {
      "number": 15,
      "text": "وَجَعَلُوۡا لَهٗ مِنۡ عِبَادِهٖ جُزۡءًا\u0026zwnj; ؕ اِنَّ الۡاِنۡسَانَ لَـكَفُوۡرٌ مُّبِيۡنٌ\u0026ensp;ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "154251043015.mp3"
    }
  ]
}