{
  "maps": {},
  "suraStart": true,
  "suraNo": 73,
  "ayatStart": 1,
  "ayatEnd": 19,
  "pageNo": 510,
  "ayatList": [
    {
      "number": 1,
      "text": "يٰۤاَيُّهَا الۡمُزَّمِّلُۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "172347073001.mp3"
    },
    {
      "number": 2,
      "text": "قُمِ الَّيۡلَ اِلَّا قَلِيۡلًا ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "172504073002.mp3"
    },
    {
      "number": 3,
      "text": "نِّصۡفَهٗۤ اَوِ انْقُصۡ مِنۡهُ قَلِيۡلًا ۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "172603073003.mp3"
    },
    {
      "number": 4,
      "text": "اَوۡ زِدۡ عَلَيۡهِ وَرَتِّلِ الۡقُرۡاٰنَ تَرۡتِيۡلًا ؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "172729073004.mp3"
    },
    {
      "number": 5,
      "text": "اِنَّا سَنُلۡقِىۡ عَلَيۡكَ قَوۡلًا ثَقِيۡلًا",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "172818073005.mp3"
    },
    {
      "number": 6,
      "text": "اِنَّ نَاشِئَةَ الَّيۡلِ هِىَ اَشَدُّ وَطۡـاً وَّاَقۡوَمُ قِيۡلًا ؕ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173032073006.mp3"
    },
    {
      "number": 7,
      "text": "اِنَّ لَـكَ فِى النَّهَارِ سَبۡحًا طَوِيۡلًا ؕ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173137073007.mp3"
    },
    {
      "number": 8,
      "text": "وَاذۡكُرِ اسۡمَ رَبِّكَ وَتَبَتَّلۡ اِلَيۡهِ تَبۡتِيۡلًا ؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173341073008.mp3"
    },
    {
      "number": 9,
      "text": "رَبُّ الۡمَشۡرِقِ وَالۡمَغۡرِبِ لَاۤ اِلٰهَ اِلَّا هُوَ فَاتَّخِذۡهُ وَكِيۡلً",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173507073009.mp3"
    },
    {
      "number": 10,
      "text": "\u0026nbsp;وَاصۡبِرۡ عَلٰى مَا يَقُوۡلُوۡنَ وَاهۡجُرۡهُمۡ هَجۡرًا جَمِيۡلً",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173615073010.mp3"
    },
    {
      "number": 11,
      "text": "وَذَرۡنِىۡ وَالۡمُكَذِّبِيۡنَ اُولِى النَّعۡمَةِ وَمَهِّلۡهُمۡ قَلِيۡلًا",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173703073011.mp3"
    },
    {
      "number": 12,
      "text": "اِنَّ لَدَيۡنَاۤ اَنۡـكَالًا وَّجَحِيۡمًا ۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173756073012.mp3"
    },
    {
      "number": 13,
      "text": "\u0026nbsp;وَّطَعَامًا ذَا غُصَّةٍ وَّعَذَابًا اَلِيۡمًا\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "174213073013.mp3"
    },
    {
      "number": 14,
      "text": "يَوۡمَ تَرۡجُفُ الۡاَرۡضُ وَالۡجِبَالُ وَكَانَتِ الۡجِبَالُ كَثِيۡبًا مَّهِيۡلًا\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "174422073014.mp3"
    },
    {
      "number": 15,
      "text": "\u0026nbsp;اِنَّاۤ اَرۡسَلۡنَاۤ اِلَيۡكُمۡ رَسُوۡلًا\u0026ensp;ۙ شَاهِدًا عَلَيۡكُمۡ كَمَاۤ اَرۡسَلۡنَاۤ اِلٰى فِرۡعَوۡنَ رَسُوۡلًا ؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "174639073015.mp3"
    },
    {
      "number": 16,
      "text": "\u0026nbsp;فَعَصٰى فِرۡعَوۡنُ الرَّسُوۡلَ فَاَخَذۡنٰهُ اَخۡذًا وَّبِيۡلًا",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "174753073016.mp3"
    },
    {
      "number": 17,
      "text": "فَكَيۡفَ تَتَّقُوۡنَ اِنۡ كَفَرۡتُمۡ يَوۡمًا يَّجۡعَلُ الۡوِلۡدَانَ شِيۡبَا \u0026ensp;ۖ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "174958073017.mp3"
    },
    {
      "number": 18,
      "text": "اۨلسَّمَآءُ مُنۡفَطِرٌ ۢ بِهٖ\u0026zwnj;ؕ كَانَ وَعۡدُهٗ مَفۡعُوۡلً",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "175128073018.mp3"
    },
    {
      "number": 19,
      "text": "\u0026nbsp;اِنَّ هٰذِهٖ تَذۡكِرَةٌ \u0026zwnj; ۚ فَمَنۡ شَآءَ اتَّخَذَ اِلٰى رَبِّهٖ سَبِيۡلًا\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "175308073019.mp3"
    }
  ]
}