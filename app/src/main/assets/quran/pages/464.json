{
  "maps": {},
  "suraStart": false,
  "suraNo": 53,
  "ayatStart": 33,
  "ayatEnd": 62,
  "pageNo": 464,
  "ayatList": [
    {
      "number": 33,
      "text": "اَفَرَءَيۡتَ الَّذِىۡ تَوَلّٰىۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "233542053033.mp3"
    },
    {
      "number": 34,
      "text": "وَاَعۡطٰى قَلِيۡلًا وَّاَكۡدٰى\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "233658053034.mp3"
    },
    {
      "number": 35,
      "text": "اَعِنۡدَهٗ عِلۡمُ الۡغَيۡبِ فَهُوَ يَرٰى",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "233756053035.mp3"
    },
    {
      "number": 36,
      "text": "\u0026nbsp;اَمۡ لَمۡ يُنَبَّاۡ بِمَا فِىۡ صُحُفِ مُوۡسٰىۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "233912053036.mp3"
    },
    {
      "number": 37,
      "text": "﻿\u0026nbsp; وَاِبۡرٰهِيۡمَ الَّذِىۡ وَفّٰىٓ \u0026ensp;ۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "234036053037.mp3"
    },
    {
      "number": 38,
      "text": "اَلَّا تَزِرُ وَازِرَةٌ وِّزۡرَ اُخۡرٰىۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "234127053038.mp3"
    },
    {
      "number": 39,
      "text": "وَاَنۡ لَّيۡسَ لِلۡاِنۡسَانِ اِلَّا مَا سَعٰىۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "234234053039.mp3"
    },
    {
      "number": 40,
      "text": "﻿\u0026nbsp; وَاَنَّ سَعۡيَهٗ سَوۡفَ يُرٰى\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "234341053040.mp3"
    },
    {
      "number": 41,
      "text": "ثُمَّ يُجۡزٰٮهُ الۡجَزَآءَ الۡاَوۡفٰىۙ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "234507053041.mp3"
    },
    {
      "number": 42,
      "text": "وَاَنَّ اِلٰى رَبِّكَ الۡمُنۡتَهٰىۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "072534053042.mp3"
    },
    {
      "number": 43,
      "text": "\u0026nbsp;وَاَنَّهٗ هُوَ اَضۡحَكَ وَاَبۡكٰىۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "072635053043.mp3"
    },
    {
      "number": 44,
      "text": "﻿\u0026nbsp; وَاَنَّهٗ هُوَ اَمَاتَ وَ اَحۡيَا ۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "072748053044.mp3"
    },
    {
      "number": 45,
      "text": "وَاَنَّهٗ خَلَقَ الزَّوۡجَيۡنِ الذَّكَرَ وَالۡاُنۡثٰىۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "072849053045.mp3"
    },
    {
      "number": 46,
      "text": "مِنۡ نُّطۡفَةٍ اِذَا تُمۡنٰى\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "072948053046.mp3"
    },
    {
      "number": 47,
      "text": "\u0026nbsp;وَاَنَّ عَلَيۡهِ النَّشۡاَةَ الۡاُخۡرٰىۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "073054053047.mp3"
    },
    {
      "number": 48,
      "text": "\u0026nbsp;وَاَنَّهٗ هُوَ اَغۡنٰى وَ اَقۡنٰىۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "073205053048.mp3"
    },
    {
      "number": 49,
      "text": "وَاَنَّهٗ هُوَ رَبُّ الشِّعۡرٰىۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "073308053049.mp3"
    },
    {
      "number": 50,
      "text": "وَاَنَّهٗۤ اَهۡلَكَ عَادَا۟ اۨلۡـٮُٔـوْلٰى ۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "073413053050.mp3"
    },
    {
      "number": 51,
      "text": "وَثَمُوۡدَا۟ فَمَاۤ اَبۡقٰىۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "073529053051.mp3"
    },
    {
      "number": 52,
      "text": "\u0026nbsp;وَقَوۡمَ نُوۡحٍ مِّنۡ قَبۡلُ\u0026zwnj;ؕ اِنَّهُمۡ كَانُوۡا هُمۡ اَظۡلَمَ وَاَطۡغٰىؕ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "073633053052.mp3"
    },
    {
      "number": 53,
      "text": "وَالۡمُؤۡتَفِكَةَ اَهۡوٰىۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "073727053053.mp3"
    },
    {
      "number": 54,
      "text": "\u0026nbsp;فَغَشّٰٮهَا مَا غَشّٰى\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "073842053054.mp3"
    },
    {
      "number": 55,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكَ تَتَمَارٰى\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "074000053055.mp3"
    },
    {
      "number": 56,
      "text": "هٰذَا نَذِيۡرٌ مِّنَ النُّذُرِ الۡاُوۡلٰٓى",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "074100053056.mp3"
    },
    {
      "number": 57,
      "text": "اَزِفَتِ الۡاٰزِفَةُ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "074158053057.mp3"
    },
    {
      "number": 58,
      "text": "\u0026nbsp;لَيۡسَ لَهَا مِنۡ دُوۡنِ اللّٰهِ كَاشِفَةٌ\u0026ensp;ؕ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "074333053058.mp3"
    },
    {
      "number": 59,
      "text": "اَفَمِنۡ هٰذَا الۡحَدِيۡثِ تَعۡجَبُوۡنَۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "074428053059.mp3"
    },
    {
      "number": 60,
      "text": "وَتَضۡحَكُوۡنَ وَلَا تَبۡكُوۡنَۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "074520053060.mp3"
    },
    {
      "number": 61,
      "text": "وَاَنۡتُمۡ سٰمِدُوۡنَ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "074624053061.mp3"
    },
    {
      "number": 62,
      "text": "فَاسۡجُدُوۡا لِلّٰهِ وَاعۡبُدُوۡا ۩\u0026rlm;",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "192508053062.mp3"
    }
  ]
}