{
  "maps": {},
  "suraStart": false,
  "suraNo": 54,
  "ayatStart": 23,
  "ayatEnd": 40,
  "pageNo": 466,
  "ayatList": [
    {
      "number": 23,
      "text": "كَذَّبَتۡ ثَمُوۡدُ بِالنُّذُرِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "101047054023.mp3"
    },
    {
      "number": 24,
      "text": "فَقَالُـوۡۤا اَبَشَرًا مِّنَّا وَاحِدًا نَّتَّبِعُهٗۤ\u0026nbsp;\u0026nbsp;ۙ اِنَّاۤ اِذًا لَّفِىۡ ضَلٰلٍ وَّسُعُرٍ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "101134054024.mp3"
    },
    {
      "number": 25,
      "text": "ءَاُلۡقِىَ الذِّكۡرُ عَلَيۡهِ مِنۡۢ بَيۡنِنَا بَلۡ هُوَ كَذَّابٌ اَشِرٌ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "101225054025.mp3"
    },
    {
      "number": 26,
      "text": "سَيَعۡلَمُوۡنَ غَدًا مَّنِ الۡكَذَّابُ الۡاَشِرُ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "101311054026.mp3"
    },
    {
      "number": 27,
      "text": "اِنَّا مُرۡسِلُوا النَّاقَةِ فِتۡنَةً لَّهُمۡ فَارۡتَقِبۡهُمۡ وَاصۡطَبِرۡ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "171328054027.mp3"
    },
    {
      "number": 28,
      "text": "وَنَبِّئۡهُمۡ اَنَّ الۡمَآءَ قِسۡمَةٌ\u0026nbsp;\u0026nbsp;ۢ بَيۡنَهُمۡ\u0026zwnj;ۚ كُلُّ شِرۡبٍ مُّحۡتَضَرٌ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "101525054028.mp3"
    },
    {
      "number": 29,
      "text": "فَنَادَوۡا صَاحِبَهُمۡ فَتَعَاطٰى فَعَقَرَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "101616054029.mp3"
    },
    {
      "number": 30,
      "text": "فَكَيۡفَ كَانَ عَذَابِىۡ وَنُذُرِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "101658054030.mp3"
    },
    {
      "number": 31,
      "text": "اِنَّاۤ اَرۡسَلۡنَا عَلَيۡهِمۡ صَيۡحَةً وَّاحِدَةً فَكَانُوۡا كَهَشِيۡمِ الۡمُحۡتَظِرِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "101743054031.mp3"
    },
    {
      "number": 32,
      "text": "وَلَقَدۡ يَسَّرۡنَا الۡقُرۡاٰنَ لِلذِّكۡرِ فَهَلۡ مِنۡ مُّدَّكِرٍ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "101828054032.mp3"
    },
    {
      "number": 33,
      "text": "كَذَّبَتۡ قَوۡمُ لُوۡطٍ\u0026nbsp;ۢ بِالنُّذُرِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "101912054033.mp3"
    },
    {
      "number": 34,
      "text": "اِنَّاۤ اَرۡسَلۡنَا عَلَيۡهِمۡ حَاصِبًا اِلَّاۤ اٰلَ لُوۡطٍ\u0026zwnj;ؕ نَّجَّيۡنٰهُمۡ بِسَحَرٍۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "102004054034.mp3"
    },
    {
      "number": 35,
      "text": "نِّعۡمَةً مِّنۡ عِنۡدِنَا\u0026zwnj;ؕ كَذٰلِكَ نَجۡزِىۡ مَنۡ شَكَرَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "102047054035.mp3"
    },
    {
      "number": 36,
      "text": "وَلَقَدۡ اَنۡذَرَهُمۡ بَطۡشَتَـنَا فَتَمَارَوۡا بِالنُّذُرِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "102130054036.mp3"
    },
    {
      "number": 37,
      "text": "وَلَقَدۡ رَاوَدُوۡهُ عَنۡ ضَيۡفِهٖ فَطَمَسۡنَاۤ اَعۡيُنَهُمۡ فَذُوۡقُوۡا عَذَابِىۡ وَنُذُرِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "102217054037.mp3"
    },
    {
      "number": 38,
      "text": "وَلَقَدۡ صَبَّحَهُمۡ بُكۡرَةً عَذَابٌ مُّسۡتَقِرٌّ\u0026zwnj;\u0026ensp;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "102300054038.mp3"
    },
    {
      "number": 39,
      "text": "فَذُوۡقُوۡا عَذَابِىۡ وَنُذُرِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "102350054039.mp3"
    },
    {
      "number": 40,
      "text": "وَلَقَدۡ يَسَّرۡنَا الۡقُرۡاٰنَ لِلذِّكۡرِ فَهَلۡ مِنۡ مُّدَّكِرٍ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "102439054040.mp3"
    }
  ]
}