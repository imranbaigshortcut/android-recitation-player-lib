{
  "maps": {},
  "suraStart": true,
  "suraNo": 76,
  "ayatStart": 1,
  "ayatEnd": 22,
  "pageNo": 516,
  "ayatList": [
    {
      "number": 1,
      "text": "هَلۡ اَتٰى عَلَى الۡاِنۡسَانِ حِيۡنٌ مِّنَ الدَّهۡرِ لَمۡ يَكُنۡ شَيۡـٴً۬ـا مَّذۡكُوۡرًا\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "220000076001.mp3"
    },
    {
      "number": 2,
      "text": "اِنَّا خَلَقۡنَا الۡاِنۡسَانَ مِنۡ نُّطۡفَةٍ اَمۡشَاجٍۖ نَّبۡتَلِيۡهِ فَجَعَلۡنٰهُ سَمِيۡعًۢا بَصِيۡرًا\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "220134076002.mp3"
    },
    {
      "number": 3,
      "text": "اِنَّا هَدَيۡنٰهُ السَّبِيۡلَ اِمَّا شَاكِرًا وَّاِمَّا كَفُوۡرًا",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "220305076003.mp3"
    },
    {
      "number": 4,
      "text": "اِنَّاۤ اَعۡتَدۡنَا لِلۡكٰفِرِيۡنَ سَلٰسِلَا۟ وَاَغۡلٰلًا وَّسَعِيۡرًا",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "220405076004.mp3"
    },
    {
      "number": 5,
      "text": "اِنَّ الۡاَبۡرَارَ يَشۡرَبُوۡنَ مِنۡ كَاۡسٍ كَانَ مِزَاجُهَا كَافُوۡرًا\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "220939076005.mp3"
    },
    {
      "number": 6,
      "text": "عَيۡنًا يَّشۡرَبُ بِهَا عِبَادُ اللّٰهِ يُفَجِّرُوۡنَهَا تَفۡجِيۡرًا\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "221037076006.mp3"
    },
    {
      "number": 7,
      "text": "يُوۡفُوۡنَ بِالنَّذۡرِ وَيَخَافُوۡنَ يَوۡمًا كَانَ شَرُّهٗ مُسۡتَطِيۡرًا",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "221135076007.mp3"
    },
    {
      "number": 8,
      "text": "وَيُطۡعِمُوۡنَ الطَّعَامَ عَلٰى حُبِّهٖ مِسۡكِيۡنًا وَّيَتِيۡمًا وَّاَسِيۡرًا",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "221231076008.mp3"
    },
    {
      "number": 9,
      "text": "\u0026nbsp;اِنَّمَا نُطۡعِمُكُمۡ لِـوَجۡهِ اللّٰهِ لَا نُرِيۡدُ مِنۡكُمۡ جَزَآءً وَّلَا شُكُوۡرًا",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "221338076009.mp3"
    },
    {
      "number": 10,
      "text": "اِنَّا نَخَافُ مِنۡ رَّبِّنَا يَوۡمًا عَبُوۡسًا قَمۡطَرِيۡرًا\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "221447076010.mp3"
    },
    {
      "number": 11,
      "text": "فَوَقٰٮهُمُ اللّٰهُ شَرَّ ذٰلِكَ الۡيَوۡمِ وَ لَقّٰٮهُمۡ نَضۡرَةً وَّسُرُوۡرًا\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "221620076011.mp3"
    },
    {
      "number": 12,
      "text": "\u0026nbsp;وَجَزٰٮهُمۡ بِمَا صَبَرُوۡا جَنَّةً وَّحَرِيۡرًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "221726076012.mp3"
    },
    {
      "number": 13,
      "text": "﻿\u0026nbsp;مُّتَّكِـِٕـيۡنَ فِيۡهَا عَلَى الۡاَرَآٮِٕكِ\u0026zwnj;ۚ لَا يَرَوۡنَ فِيۡهَا شَمۡسًا وَّلَا زَمۡهَرِيۡرًا\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "221826076013.mp3"
    },
    {
      "number": 14,
      "text": "وَدَانِيَةً عَلَيۡهِمۡ ظِلٰلُهَا وَذُلِّلَتۡ قُطُوۡفُهَا تَذۡلِيۡلًا",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "221928076014.mp3"
    },
    {
      "number": 15,
      "text": "وَيُطَافُ عَلَيۡهِمۡ بِاٰنِيَةٍ مِّنۡ فِضَّةٍ وَّاَكۡوَابٍ كَانَتۡ قَوَارِيۡرَا۟ؔ\u0026ensp;ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "222024076015.mp3"
    },
    {
      "number": 16,
      "text": "\u0026nbsp;قَوَارِيۡرَا۟ؔ مِنۡ فِضَّةٍ قَدَّرُوۡهَا تَقۡدِيۡرًا\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "222141076016.mp3"
    },
    {
      "number": 17,
      "text": "وَيُسۡقَوۡنَ فِيۡهَا كَاۡسًا كَانَ مِزَاجُهَا زَنۡجَبِيۡلًا ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "222247076017.mp3"
    },
    {
      "number": 18,
      "text": "عَيۡنًا فِيۡهَا تُسَمّٰى سَلۡسَبِيۡلًا",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "222348076018.mp3"
    },
    {
      "number": 19,
      "text": "وَيَطُوۡفُ عَلَيۡهِمۡ وِلۡدَانٌ مُّخَلَّدُوۡنَ\u0026zwnj;ۚ اِذَا رَاَيۡتَهُمۡ حَسِبۡتَهُمۡ لُـؤۡلُـؤًا مَّنۡثُوۡرًا\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "222535076019.mp3"
    },
    {
      "number": 20,
      "text": "وَاِذَا رَاَيۡتَ ثَمَّ رَاَيۡتَ نَعِيۡمًا وَّمُلۡكًا كَبِيۡرًا",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "222647076020.mp3"
    },
    {
      "number": 21,
      "text": "عٰلِيَهُمۡ ثِيَابُ سُنۡدُسٍ خُضۡرٌ وَّاِسۡتَبۡرَقٌ\u0026zwnj; وَّحُلُّوۡۤا اَسَاوِرَ مِنۡ فِضَّةٍ \u0026zwnj;ۚوَسَقٰٮهُمۡ رَبُّهُمۡ شَرَابًا طَهُوۡرًا",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "222916076021.mp3"
    },
    {
      "number": 22,
      "text": "﻿\u0026nbsp; اِنَّ هٰذَا كَانَ لَـكُمۡ جَزَآءً وَّكَانَ سَعۡيُكُمۡ مَّشۡكُوۡرًا\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "223014076022.mp3"
    }
  ]
}