{
  "maps": {},
  "suraStart": true,
  "suraNo": 69,
  "ayatStart": 1,
  "ayatEnd": 37,
  "pageNo": 502,
  "ayatList": [
    {
      "number": 1,
      "text": "\u003cp\u003e\u0026nbsp;اَلۡحَـآقَّةُ ۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "140933069001.mp3"
    },
    {
      "number": 2,
      "text": "مَا الۡحَـآقَّةُ\u0026zwnj; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "141626069002.mp3"
    },
    {
      "number": 3,
      "text": "وَمَاۤ اَدۡرٰٮكَ مَا الۡحَــآقَّةُ ؕ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "141808069003.mp3"
    },
    {
      "number": 4,
      "text": "كَذَّبَتۡ ثَمُوۡدُ وَعَادٌۢ بِالۡقَارِعَةِ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "174654069004.mp3"
    },
    {
      "number": 5,
      "text": "فَاَمَّا ثَمُوۡدُ فَاُهۡلِكُوۡا بِالطَّاغِيَةِ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "174912069005.mp3"
    },
    {
      "number": 6,
      "text": "\u0026nbsp;وَاَمَّا عَادٌ فَاُهۡلِكُوۡا بِرِيۡحٍ صَرۡصَرٍ عَاتِيَةٍۙ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "175150069006.mp3"
    },
    {
      "number": 7,
      "text": "سَخَّرَهَا عَلَيۡهِمۡ سَبۡعَ لَيَالٍ وَّثَمٰنِيَةَ اَيَّامٍۙ حُسُوۡمًا ۙ فَتَرَى الۡقَوۡمَ فِيۡهَا صَرۡعٰىۙ كَاَنَّهُمۡ اَعۡجَازُ نَخۡلٍ خَاوِيَةٍ\u0026zwnj;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "175308069007.mp3"
    },
    {
      "number": 8,
      "text": "فَهَلۡ تَرٰى لَهُمۡ مِّنۡۢ بَاقِيَةٍ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "175512069008.mp3"
    },
    {
      "number": 9,
      "text": "وَجَآءَ فِرۡعَوۡنُ وَمَنۡ قَبۡلَهٗ وَالۡمُؤۡتَفِكٰتُ بِالۡخَـاطِئَةِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "202518069009.mp3"
    },
    {
      "number": 10,
      "text": "فَعَصَوۡا رَسُوۡلَ رَبِّهِمۡ فَاَخَذَهُمۡ اَخۡذَةً رَّابِيَةً",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "202606069010.mp3"
    },
    {
      "number": 11,
      "text": "\u0026nbsp;اِنَّا لَمَّا طَغَا الۡمَآءُ حَمَلۡنٰكُمۡ فِى الۡجَارِيَةِ ۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "202702069011.mp3"
    },
    {
      "number": 12,
      "text": "لِنَجۡعَلَهَا لَـكُمۡ تَذۡكِرَةً وَّتَعِيَهَاۤ اُذُنٌ وَّاعِيَةٌ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "202759069012.mp3"
    },
    {
      "number": 13,
      "text": "فَاِذَا نُفِخَ فِى الصُّوۡرِ نَفۡخَةٌ وَّاحِدَةٌ\u0026ensp;ۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "202853069013.mp3"
    },
    {
      "number": 14,
      "text": "وَحُمِلَتِ الۡاَرۡضُ وَ الۡجِبَالُ فَدُكَّتَا دَكَّةً وَّاحِدَةً\u0026ensp;ۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "202952069014.mp3"
    },
    {
      "number": 15,
      "text": "فَيَوۡمَٮِٕذٍ وَّقَعَتِ الۡوَاقِعَةُ ۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "203106069015.mp3"
    },
    {
      "number": 16,
      "text": "وَانْشَقَّتِ السَّمَآءُ فَهِىَ يَوۡمَٮِٕذٍ وَّاهِيَةٌ ۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "203217069016.mp3"
    },
    {
      "number": 17,
      "text": "وَّالۡمَلَكُ عَلٰٓى اَرۡجَآٮِٕهَا \u0026zwnj;ؕ وَيَحۡمِلُ عَرۡشَ رَبِّكَ فَوۡقَهُمۡ يَوۡمَٮِٕذٍ ثَمٰنِيَةٌ\u0026ensp;ؕ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "203331069017.mp3"
    },
    {
      "number": 18,
      "text": "يَوۡمَٮِٕذٍ تُعۡرَضُوۡنَ لَا تَخۡفٰى مِنۡكُمۡ خَافِيَةٌ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "203536069018.mp3"
    },
    {
      "number": 19,
      "text": "فَاَمَّا مَنۡ اُوۡتِىَ كِتٰبَهٗ بِيَمِيۡنِهٖۙ فَيَقُوۡلُ هَآؤُمُ اقۡرَءُوۡا كِتٰبِيَهۡ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "203727069019.mp3"
    },
    {
      "number": 20,
      "text": "اِنِّىۡ ظَنَنۡتُ اَنِّىۡ مُلٰقٍ حِسَابِيَهۡ\u0026zwnj;ۚ\u0026rlm; \r\n\r\n\u0026nbsp;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "203943069020.mp3"
    },
    {
      "number": 21,
      "text": "فَهُوَ فِىۡ عِيۡشَةٍ رَّاضِيَةٍۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "204119069021.mp3"
    },
    {
      "number": 22,
      "text": "فِىۡ جَنَّةٍ عَالِيَةٍۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "204227069022.mp3"
    },
    {
      "number": 23,
      "text": "قُطُوۡفُهَا دَانِيَةٌ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "204329069023.mp3"
    },
    {
      "number": 24,
      "text": "كُلُوۡا وَاشۡرَبُوۡا هَنِيۡٓـــًٔا ۢ بِمَاۤ اَسۡلَفۡتُمۡ فِى الۡاَيَّامِ الۡخَـالِيَةِ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "204422069024.mp3"
    },
    {
      "number": 25,
      "text": "وَاَمَّا مَنۡ اُوۡتِىَ كِتٰبَهٗ بِشِمَالِهٖ \u0026emsp;ۙ فَيَقُوۡلُ يٰلَيۡتَنِىۡ لَمۡ اُوۡتَ كِتٰبِيَهۡ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "204550069025.mp3"
    },
    {
      "number": 26,
      "text": "وَلَمۡ اَدۡرِ مَا حِسَابِيَهۡ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "204908069026.mp3"
    },
    {
      "number": 27,
      "text": "يٰلَيۡتَهَا كَانَتِ الۡقَاضِيَةَ\u0026zwnj; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "205006069027.mp3"
    },
    {
      "number": 28,
      "text": "مَاۤ اَغۡنٰى عَنِّىۡ مَالِيَهۡۚ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "205106069028.mp3"
    },
    {
      "number": 29,
      "text": "هَلَكَ عَنِّىۡ سُلۡطٰنِيَهۡ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "205154069029.mp3"
    },
    {
      "number": 30,
      "text": "خُذُوۡهُ فَغُلُّوۡهُ ۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "205244069030.mp3"
    },
    {
      "number": 31,
      "text": "ثُمَّ الۡجَحِيۡمَ صَلُّوۡهُ ۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "205339069031.mp3"
    },
    {
      "number": 32,
      "text": "\u0026nbsp;\u0026nbsp;ثُمَّ فِىۡ سِلۡسِلَةٍ ذَرۡعُهَا سَبۡعُوۡنَ ذِرَاعًا فَاسۡلُكُوۡهُ ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "205430069032.mp3"
    },
    {
      "number": 33,
      "text": "اِنَّهٗ كَانَ لَا يُؤۡمِنُ بِاللّٰهِ الۡعَظِيۡمِۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "205526069033.mp3"
    },
    {
      "number": 34,
      "text": "وَلَا يَحُضُّ عَلٰى طَعَامِ الۡمِسۡكِيۡنِؕ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "205618069034.mp3"
    },
    {
      "number": 35,
      "text": "فَلَيۡسَ لَـهُ الۡيَوۡمَ هٰهُنَا حَمِيۡمٌۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "205722069035.mp3"
    },
    {
      "number": 36,
      "text": "وَّلَا طَعَامٌ اِلَّا مِنۡ غِسۡلِيۡنٍۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "205819069036.mp3"
    },
    {
      "number": 37,
      "text": "\u0026nbsp;لَّا يَاۡكُلُهٗۤ اِلَّا الۡخٰطِئُوْنَ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "210020069037.mp3"
    }
  ]
}