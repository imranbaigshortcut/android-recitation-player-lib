{
  "maps": {},
  "suraStart": true,
  "suraNo": 81,
  "ayatStart": 1,
  "ayatEnd": 29,
  "pageNo": 525,
  "ayatList": [
    {
      "number": 1,
      "text": "اِذَا الشَّمۡسُ كُوِّرَتۡۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "191818081001.mp3"
    },
    {
      "number": 2,
      "text": "\u0026nbsp;\u0026nbsp;وَاِذَا النُّجُوۡمُ انْكَدَرَتۡۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "191851081002.mp3"
    },
    {
      "number": 3,
      "text": "\u0026nbsp;\u0026nbsp;وَاِذَا الۡجِبَالُ سُيِّرَتۡۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192028081003.mp3"
    },
    {
      "number": 4,
      "text": "\u0026nbsp;\u0026nbsp;وَاِذَا الۡعِشَارُ عُطِّلَتۡۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192104081004.mp3"
    },
    {
      "number": 5,
      "text": "\u0026nbsp;\u0026nbsp;وَاِذَا الۡوُحُوۡشُ حُشِرَتۡۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192135081005.mp3"
    },
    {
      "number": 6,
      "text": "\u0026nbsp;\u0026nbsp;وَاِذَا الۡبِحَارُ سُجِّرَتۡۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192210081006.mp3"
    },
    {
      "number": 7,
      "text": "\u0026nbsp;\u0026nbsp;وَاِذَا النُّفُوۡسُ زُوِّجَتۡۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192259081007.mp3"
    },
    {
      "number": 8,
      "text": "\u0026nbsp;\u0026nbsp;وَاِذَا الۡمَوۡءٗدَةُ سُٮِٕلَتۡۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192509081008.mp3"
    },
    {
      "number": 9,
      "text": "\u0026nbsp;\u0026nbsp;بِاَىِّ ذَنۡۢبٍ قُتِلَتۡ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192549081009.mp3"
    },
    {
      "number": 10,
      "text": "\u0026nbsp;\u0026nbsp;وَاِذَا الصُّحُفُ نُشِرَتۡۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192621081010.mp3"
    },
    {
      "number": 11,
      "text": "\u0026nbsp;\u0026nbsp;وَاِذَا السَّمَآءُ كُشِطَتۡۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192741081011.mp3"
    },
    {
      "number": 12,
      "text": "\u0026nbsp;\u0026nbsp;وَاِذَا الۡجَحِيۡمُ سُعِّرَتۡۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192809081012.mp3"
    },
    {
      "number": 13,
      "text": "\u0026nbsp;\u0026nbsp;وَاِذَا الۡجَـنَّةُ اُزۡلِفَتۡۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192840081013.mp3"
    },
    {
      "number": 14,
      "text": "\u0026nbsp;\u0026nbsp;عَلِمَتۡ نَفۡسٌ مَّاۤ اَحۡضَرَتۡؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192916081014.mp3"
    },
    {
      "number": 15,
      "text": "\u0026nbsp;فَلَاۤ اُقۡسِمُ بِالۡخُنَّسِۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192958081015.mp3"
    },
    {
      "number": 16,
      "text": "\u0026nbsp;\u0026nbsp;الۡجَوَارِ الۡكُنَّسِۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193041081016.mp3"
    },
    {
      "number": 17,
      "text": "\u0026nbsp;\u0026nbsp;وَالَّيۡلِ اِذَا عَسۡعَسَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193118081017.mp3"
    },
    {
      "number": 18,
      "text": "\u0026nbsp;وَالصُّبۡحِ اِذَا تَنَفَّسَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193202081018.mp3"
    },
    {
      "number": 19,
      "text": "\u0026nbsp;\u0026nbsp;اِنَّهٗ لَقَوۡلُ رَسُوۡلٍ كَرِيۡمٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193238081019.mp3"
    },
    {
      "number": 20,
      "text": "\u0026nbsp;\u0026nbsp;ذِىۡ قُوَّةٍ عِنۡدَ ذِى الۡعَرۡشِ مَكِيۡنٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193320081020.mp3"
    },
    {
      "number": 21,
      "text": "\u0026nbsp;\u0026nbsp;مُّطَاعٍ ثَمَّ اَمِيۡنٍؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193357081021.mp3"
    },
    {
      "number": 22,
      "text": "\u0026nbsp;\u0026nbsp;وَ مَا صَاحِبُكُمۡ بِمَجۡنُوۡنٍ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193433081022.mp3"
    },
    {
      "number": 23,
      "text": "\u0026nbsp;\u0026nbsp;وَلَقَدۡ رَاٰهُ بِالۡاُفُقِ الۡمُبِيۡنِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193511081023.mp3"
    },
    {
      "number": 24,
      "text": "\u0026nbsp;\u0026nbsp;وَمَا هُوَ عَلَى الۡغَيۡبِ بِضَنِيۡنٍ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193551081024.mp3"
    },
    {
      "number": 25,
      "text": "\u0026nbsp;وَمَا هُوَ بِقَوۡلِ شَيۡطٰنٍ رَّجِيۡمٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193621081025.mp3"
    },
    {
      "number": 26,
      "text": "\u0026nbsp;\u0026nbsp;فَاَيۡنَ تَذۡهَبُوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193650081026.mp3"
    },
    {
      "number": 27,
      "text": "\u0026nbsp;\u0026nbsp;اِنۡ هُوَ اِلَّا ذِكۡرٌ لِّلۡعٰلَمِيۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193725081027.mp3"
    },
    {
      "number": 28,
      "text": "\u0026nbsp;\u0026nbsp;لِمَنۡ شَآءَ مِنۡكُمۡ اَنۡ يَّسۡتَقِيۡمَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193757081028.mp3"
    },
    {
      "number": 29,
      "text": "\u0026nbsp;\u0026nbsp;وَمَا تَشَآءُوۡنَ اِلَّاۤ اَنۡ يَّشَآءَ اللّٰهُ رَبُّ الۡعٰلَمِيۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193830081029.mp3"
    }
  ]
}