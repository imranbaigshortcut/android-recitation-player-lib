{
  "maps": {},
  "suraStart": true,
  "suraNo": 70,
  "ayatStart": 1,
  "ayatEnd": 35,
  "pageNo": 504,
  "ayatList": [
    {
      "number": 1,
      "text": "سَاَلَ سَآٮِٕلٌ ۢ بِعَذَابٍ وَّاقِعٍۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "103640070001.mp3"
    },
    {
      "number": 2,
      "text": "لِّلۡكٰفِرِيۡنَ لَيۡسَ لَهٗ دَافِعٌ ۙ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "103905070002.mp3"
    },
    {
      "number": 3,
      "text": "مِّنَ اللّٰهِ ذِى الۡمَعَارِجِؕ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "104217070003.mp3"
    },
    {
      "number": 4,
      "text": "تَعۡرُجُ الۡمَلٰٓٮِٕكَةُ وَ الرُّوۡحُ اِلَيۡهِ فِىۡ يَوۡمٍ كَانَ مِقۡدَارُهٗ خَمۡسِيۡنَ اَلۡفَ سَنَةٍ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "104710070004.mp3"
    },
    {
      "number": 5,
      "text": "فَاصۡبِرۡ صَبۡرًا جَمِيۡلًا\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "104910070005.mp3"
    },
    {
      "number": 6,
      "text": "\u0026nbsp;اِنَّهُمۡ يَرَوۡنَهٗ بَعِيۡدًا ۙ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "105317070006.mp3"
    },
    {
      "number": 7,
      "text": "\u0026nbsp;وَّنَرٰٮهُ قَرِيۡبًا ؕ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "105507070007.mp3"
    },
    {
      "number": 8,
      "text": "\u0026nbsp;يَوۡمَ تَكُوۡنُ السَّمَآءُ كَالۡمُهۡلِۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "105643070008.mp3"
    },
    {
      "number": 9,
      "text": "وَتَكُوۡنُ الۡجِبَالُ كَالۡعِهۡنِۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "110015070009.mp3"
    },
    {
      "number": 10,
      "text": "\u0026nbsp;وَلَا يَسۡـَٔـلُ حَمِيۡمٌ حَمِيۡمًا\u0026ensp;ۖۚ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "110128070010.mp3"
    },
    {
      "number": 11,
      "text": "يُّبَصَّرُوۡنَهُمۡ\u0026zwnj;ؕ يَوَدُّ الۡمُجۡرِمُ لَوۡ يَفۡتَدِىۡ مِنۡ عَذَابِ يَوۡمِٮِٕذٍۢ بِبَنِيۡهِۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "110354070011.mp3"
    },
    {
      "number": 12,
      "text": "\u0026nbsp;وَ صَاحِبَتِهٖ وَاَخِيۡهِۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "110528070012.mp3"
    },
    {
      "number": 13,
      "text": "وَفَصِيۡلَتِهِ الَّتِىۡ تُــْٔوِيۡهِۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "110811070013.mp3"
    },
    {
      "number": 14,
      "text": "وَمَنۡ فِى الۡاَرۡضِ جَمِيۡعًا ۙ ثُمَّ يُنۡجِيۡهِۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "110945070014.mp3"
    },
    {
      "number": 15,
      "text": "كَلَّا\u0026nbsp;\u0026nbsp;ؕ اِنَّهَا لَظٰىۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "111129070015.mp3"
    },
    {
      "number": 16,
      "text": "\u0026nbsp;نَزَّاعَةً لِّلشَّوٰى\u0026zwnj;\u0026nbsp;ۖ\u0026zwnj;ۚ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "111352070016.mp3"
    },
    {
      "number": 17,
      "text": "\u0026nbsp;تَدۡعُوۡا مَنۡ اَدۡبَرَ وَتَوَلّٰىۙ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "111518070017.mp3"
    },
    {
      "number": 18,
      "text": "وَجَمَعَ فَاَوۡعٰى\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "111639070018.mp3"
    },
    {
      "number": 19,
      "text": "اِنَّ الۡاِنۡسَانَ خُلِقَ هَلُوۡعًا ۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "111740070019.mp3"
    },
    {
      "number": 20,
      "text": "\u0026nbsp;اِذَا مَسَّهُ الشَّرُّ جَزُوۡعًا ۙ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "111838070020.mp3"
    },
    {
      "number": 21,
      "text": "وَاِذَا مَسَّهُ الۡخَيۡرُ مَنُوۡعًا ۙ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "112020070021.mp3"
    },
    {
      "number": 22,
      "text": "اِلَّا الۡمُصَلِّيۡنَۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "112147070022.mp3"
    },
    {
      "number": 23,
      "text": "الَّذِيۡنَ هُمۡ عَلٰى صَلَاتِهِمۡ دَآٮِٕمُوۡنَۙ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "112321070023.mp3"
    },
    {
      "number": 24,
      "text": "\u0026nbsp;وَالَّذِيۡنَ فِىۡۤ اَمۡوَالِهِمۡ حَقٌّ مَّعۡلُوۡمٌۙ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "112506070024.mp3"
    },
    {
      "number": 25,
      "text": "لِّلسَّآٮِٕلِ وَالۡمَحۡرُوۡمِۙ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "112612070025.mp3"
    },
    {
      "number": 26,
      "text": "\u0026nbsp;وَالَّذِيۡنَ يُصَدِّقُوۡنَ بِيَوۡمِ الدِّيۡنِۙ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "113428070026.mp3"
    },
    {
      "number": 27,
      "text": "وَالَّذِيۡنَ هُمۡ مِّنۡ عَذَابِ رَبِّهِمۡ مُّشۡفِقُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "113536070027.mp3"
    },
    {
      "number": 28,
      "text": "اِنَّ عَذَابَ رَبِّهِمۡ غَيۡرُ مَاۡمُوۡنٍ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "113701070028.mp3"
    },
    {
      "number": 29,
      "text": "وَالَّذِيۡنَ هُمۡ لِفُرُوۡجِهِمۡ حٰفِظُوۡنَۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "113815070029.mp3"
    },
    {
      "number": 30,
      "text": "اِلَّا عَلٰٓى اَزۡوَاجِهِمۡ اَوۡ مَا مَلَـكَتۡ اَيۡمَانُهُمۡ فَاِنَّهُمۡ غَيۡرُ مَلُوۡمِيۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "113920070030.mp3"
    },
    {
      "number": 31,
      "text": "فَمَنِ ابۡتَغٰى وَرَآءَ ذٰلِكَ فَاُولٰٓٮِٕكَ هُمُ الۡعٰدُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "114030070031.mp3"
    },
    {
      "number": 32,
      "text": "\u0026nbsp;وَالَّذِيۡنَ هُمۡ لِاَمٰنٰتِهِمۡ وَعَهۡدِهِمۡ رٰعُوۡنَ ۙ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "114158070032.mp3"
    },
    {
      "number": 33,
      "text": "وَالَّذِيۡنَ هُمۡ بِشَهٰدٰتِهِمۡ قَآٮِٕمُوۡنَ\u0026nbsp;ۙ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "114347070033.mp3"
    },
    {
      "number": 34,
      "text": "وَالَّذِيۡنَ هُمۡ عَلٰى صَلَاتِهِمۡ يُحَافِظُوۡنَؕ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "114518070034.mp3"
    },
    {
      "number": 35,
      "text": "اُولٰٓٮِٕكَ فِىۡ جَنّٰتٍ مُّكۡرَمُوۡنَؕ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "114635070035.mp3"
    }
  ]
}