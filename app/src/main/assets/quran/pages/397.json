{
  "maps": {},
  "suraStart": false,
  "suraNo": 38,
  "ayatStart": 65,
  "ayatEnd": 88,
  "pageNo": 397,
  "ayatList": [
    {
      "number": 65,
      "text": "قُلۡ اِنَّمَاۤ اَنَا مُنۡذِرٌ \u0026zwnj;\u0026zwnj;ۖ  وَّمَا مِنۡ اِلٰهٍ اِلَّا اللّٰهُ الۡوَاحِدُ الۡقَهَّارُ\u0026zwnj; ۚ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "232701038065.mp3"
    },
    {
      "number": 66,
      "text": "\u0026nbsp;رَبُّ السَّمٰوٰتِ وَالۡاَرۡضِ وَمَا بَيۡنَهُمَا الۡعَزِيۡزُ الۡغَفَّارُ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "232756038066.mp3"
    },
    {
      "number": 67,
      "text": "قُلۡ هُوَ نَبَؤٌا عَظِيۡمٌۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "232901038067.mp3"
    },
    {
      "number": 68,
      "text": "اَنۡتُمۡ عَنۡهُ مُعۡرِضُوۡنَ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "232950038068.mp3"
    },
    {
      "number": 69,
      "text": "\u0026nbsp;مَا كَانَ لِىَ مِنۡ عِلۡمٍۢ بِالۡمَلَاِ الۡاَعۡلٰٓى اِذۡ يَخۡتَصِمُوۡنَ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "233046038069.mp3"
    },
    {
      "number": 70,
      "text": "اِنۡ يُّوۡحٰۤى اِلَىَّ اِلَّاۤ اَنَّمَاۤ اَنَا۟ نَذِيۡرٌ مُّبِيۡنٌ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "233145038070.mp3"
    },
    {
      "number": 71,
      "text": "اِذۡ قَالَ رَبُّكَ لِلۡمَلٰٓٮِٕكَةِ اِنِّىۡ خَالِـقٌ\u0026nbsp;ۢ بَشَرًا مِّنۡ طِيۡنٍ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "233241038071.mp3"
    },
    {
      "number": 72,
      "text": "فَاِذَا سَوَّيۡتُهٗ وَنَفَخۡتُ فِيۡهِ مِنۡ رُّوۡحِىۡ فَقَعُوۡا لَهٗ سٰجِدِيۡنَ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "233347038072.mp3"
    },
    {
      "number": 73,
      "text": "فَسَجَدَ الۡمَلٰٓٮِٕكَةُ كُلُّهُمۡ اَجۡمَعُوۡنَۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "233443038073.mp3"
    },
    {
      "number": 74,
      "text": "اِلَّاۤ اِبۡلِيۡسَؕ اِسۡتَكۡبَرَ وَكَانَ مِنَ الۡكٰفِرِيۡنَ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "233557038074.mp3"
    },
    {
      "number": 75,
      "text": "\u0026nbsp;قَالَ يٰۤـاِبۡلِيۡسُ مَا مَنَعَكَ اَنۡ تَسۡجُدَ لِمَا خَلَقۡتُ بِيَدَىَّ\u0026zwnj; ؕ اَسۡتَكۡبَرۡتَ اَمۡ كُنۡتَ مِنَ الۡعَالِيۡنَ\u0026rlm; \r\n\r\n\u0026nbsp;",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "233800038075.mp3"
    },
    {
      "number": 76,
      "text": "قَالَ اَنَا خَيۡرٌ مِّنۡهُ\u0026zwnj; ؕ خَلَقۡتَنِىۡ مِنۡ نَّارٍ وَّخَلَقۡتَهٗ مِنۡ طِيۡنٍ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "233904038076.mp3"
    },
    {
      "number": 77,
      "text": "قَالَ فَاخۡرُجۡ مِنۡهَا فَاِنَّكَ رَجِيۡمٌ\u0026ensp; ۖ\u0026zwnj; ۚ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "233959038077.mp3"
    },
    {
      "number": 78,
      "text": "وَّاِنَّ عَلَيۡكَ لَعۡنَتِىۡۤ اِلٰى يَوۡمِ الدِّيۡنِ\u0026rlm; \r\n\r\n\u0026nbsp;",
      "translationNo": "kommer snrt",
      "commentary": "",
      "audioTalawat": "234135038078.mp3"
    },
    {
      "number": 79,
      "text": "قَالَ رَبِّ فَاَنۡظِرۡنِىۡۤ اِلٰى يَوۡمِ يُبۡعَثُوۡنَ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "234318038079.mp3"
    },
    {
      "number": 80,
      "text": "\u0026nbsp;قَالَ فَاِنَّكَ مِنَ الۡمُنۡظَرِيۡنَۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "234410038080.mp3"
    },
    {
      "number": 81,
      "text": "اِلٰى يَوۡمِ الۡوَقۡتِ الۡمَعۡلُوۡمِ\r\n\r\n\u0026nbsp;",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "234511038081.mp3"
    },
    {
      "number": 82,
      "text": "قَالَ فَبِعِزَّتِكَ لَاُغۡوِيَنَّهُمۡ اَجۡمَعِيۡنَۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "234557038082.mp3"
    },
    {
      "number": 83,
      "text": "اِلَّا عِبَادَكَ مِنۡهُمُ الۡمُخۡلَصِيۡنَ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "234652038083.mp3"
    },
    {
      "number": 84,
      "text": "قَالَ فَالۡحَقُّ  وَالۡحَقَّ اَ قُوۡلُ\u0026zwnj; ۚ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "234743038084.mp3"
    },
    {
      "number": 85,
      "text": "لَاَمۡلَئَنَّ جَهَنَّمَ مِنۡكَ وَمِمَّنۡ تَبِعَكَ مِنۡهُمۡ اَجۡمَعِيۡنَ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "234835038085.mp3"
    },
    {
      "number": 86,
      "text": "قُلۡ مَاۤ اَسۡـَٔــلُكُمۡ عَلَيۡهِ مِنۡ اَجۡرٍ وَّمَاۤ اَنَا مِنَ الۡمُتَكَلِّفِيۡنَ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "234924038086.mp3"
    },
    {
      "number": 87,
      "text": "اِنۡ هُوَ اِلَّا ذِكۡرٌ لِّلۡعٰلَمِيۡنَ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "235014038087.mp3"
    },
    {
      "number": 88,
      "text": "\u0026nbsp;وَلَتَعۡلَمُنَّ نَبَاَهٗ بَعۡدَ حِيۡنِ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "235115038088.mp3"
    }
  ]
}