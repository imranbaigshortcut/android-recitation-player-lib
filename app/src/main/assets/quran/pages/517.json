  "ayatStart": 23,
  "ayatEnd": 31,
  "pageNo": 517,
  "ayatList": [
    {
      "number": 23,
      "text": "اِنَّا نَحۡنُ نَزَّلۡنَا عَلَيۡكَ الۡقُرۡاٰنَ تَنۡزِيۡلًا ۚ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "223124076023.mp3"
    },
    {
      "number": 24,
      "text": "فَاصۡبِرۡ لِحُكۡمِ رَبِّكَ وَلَا تُطِعۡ مِنۡهُمۡ اٰثِمًا اَوۡ كَفُوۡرًا\u0026zwnj;ۚ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "223320076024.mp3"
    },
    {
      "number": 25,
      "text": "﻿\u0026nbsp;وَاذۡكُرِ اسۡمَ رَبِّكَ بُكۡرَةً وَّاَصِيۡلًا ۚ \u0026ensp;ۖ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "223426076025.mp3"
    },
    {
      "number": 26,
      "text": "وَمِنَ الَّيۡلِ فَاسۡجُدۡ لَهٗ وَسَبِّحۡهُ لَيۡلًا طَوِيۡلًا\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "223529076026.mp3"
    },
    {
      "number": 27,
      "text": "اِنَّ هٰٓؤُلَاۤءِ يُحِبُّوۡنَ الۡعَاجِلَةَ وَيَذَرُوۡنَ وَرَآءَهُمۡ يَوۡمًا ثَقِيۡلًا",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "223623076027.mp3"
    },
    {
      "number": 28,
      "text": "\u0026nbsp;نَحۡنُ خَلَقۡنٰهُمۡ وَشَدَدۡنَاۤ اَسۡرَهُمۡ\u0026zwnj;ۚ وَاِذَا شِئۡنَا بَدَّلۡنَاۤ اَمۡثَالَهُمۡ تَبۡدِيۡلًا\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "223717076028.mp3"
    },
    {
      "number": 29,
      "text": "اِنَّ هٰذِهٖ تَذۡكِرَةٌ \u0026zwnj;ۚ فَمَنۡ شَآءَ اتَّخَذَ اِلٰى رَبِّهٖ سَبِيۡلًا",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "223815076029.mp3"
    },
    {
      "number": 30,
      "text": "وَمَا تَشَآءُوۡنَ اِلَّاۤ اَنۡ يَّشَآءَ اللّٰهُ \u0026zwnj;ؕ اِنَّ اللّٰهَ كَانَ عَلِيۡمًا حَكِيۡمًا \u0026ensp;ۖ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "223912076030.mp3"
    },
    {
      "number": 31,
      "text": "يُّدۡخِلُ مَنۡ يَّشَآءُ فِىۡ رَحۡمَتِهٖ\u0026zwnj;ؕ وَالظّٰلِمِيۡنَ اَعَدَّ لَهُمۡ عَذَابًا اَلِيۡمًا\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "224010076031.mp3"
    }
  ]
}