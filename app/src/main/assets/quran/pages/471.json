{
  "maps": {},
  "suraStart": true,
  "suraNo": 56,
  "ayatStart": 1,
  "ayatEnd": 38,
  "pageNo": 471,
  "ayatList": [
    {
      "number": 1,
      "text": "اِذَا وَقَعَتِ الۡوَاقِعَةُ\u0026ensp;ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "000146056001.mp3"
    },
    {
      "number": 2,
      "text": "لَيۡسَ لِـوَقۡعَتِهَا كَاذِبَةٌ\u0026zwnj;\u0026ensp;ۘ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "000232056002.mp3"
    },
    {
      "number": 3,
      "text": "خَافِضَةٌ رَّافِعَةٌ\u0026ensp;ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "000320056003.mp3"
    },
    {
      "number": 4,
      "text": "اِذَا رُجَّتِ الۡاَرۡضُ رَجًّا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "000419056004.mp3"
    },
    {
      "number": 5,
      "text": "وَّبُسَّتِ الۡجِبَالُ بَسًّا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "000509056005.mp3"
    },
    {
      "number": 6,
      "text": "فَكَانَتۡ هَبَآءً مُّنۡۢبَـثًّا\u0026ensp;ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "000555056006.mp3"
    },
    {
      "number": 7,
      "text": "وَّكُنۡـتُمۡ اَزۡوَاجًا ثَلٰـثَـةً\u0026ensp;ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "000644056007.mp3"
    },
    {
      "number": 8,
      "text": "فَاَصۡحٰبُ الۡمَيۡمَنَةِ\u0026ensp;ۙ مَاۤ اَصۡحٰبُ الۡمَيۡمَنَةِ ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "000736056008.mp3"
    },
    {
      "number": 9,
      "text": "وَاَصۡحٰبُ الۡمَشۡـَٔـمَةِ\u0026ensp;ۙ مَاۤ اَصۡحٰبُ الۡمَشۡـَٔـمَةِؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "000831056009.mp3"
    },
    {
      "number": 10,
      "text": "وَالسّٰبِقُوۡنَ السّٰبِقُوۡنَۚ \u0026ensp;ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "001002056010.mp3"
    },
    {
      "number": 11,
      "text": "اُولٰٓٮِٕكَ الۡمُقَرَّبُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "001105056011.mp3"
    },
    {
      "number": 12,
      "text": "فِىۡ جَنّٰتِ النَّعِيۡمِ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "001151056012.mp3"
    },
    {
      "number": 13,
      "text": "ثُلَّةٌ مِّنَ الۡاَوَّلِيۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "001248056013.mp3"
    },
    {
      "number": 14,
      "text": "وَقَلِيۡلٌ مِّنَ الۡاٰخِرِيۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "001338056014.mp3"
    },
    {
      "number": 15,
      "text": "عَلٰى سُرُرٍ مَّوۡضُوۡنَةٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "001427056015.mp3"
    },
    {
      "number": 16,
      "text": "مُّتَّكِـــِٕيۡنَ عَلَيۡهَا مُتَقٰبِلِيۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "001515056016.mp3"
    },
    {
      "number": 17,
      "text": "يَطُوۡفُ عَلَيۡهِمۡ وِلۡدَانٌ مُّخَلَّدُوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "001719056017.mp3"
    },
    {
      "number": 18,
      "text": "بِاَكۡوَابٍ وَّاَبَارِيۡقَ\u0026ensp;ۙ وَكَاۡسٍ مِّنۡ مَّعِيۡنٍۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "001810056018.mp3"
    },
    {
      "number": 19,
      "text": "\u0026nbsp; لَّا يُصَدَّعُوۡنَ عَنۡهَا وَلَا يُنۡزِفُوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "002010056019.mp3"
    },
    {
      "number": 20,
      "text": "وَفَاكِهَةٍ مِّمَّا يَتَخَيَّرُوۡنَۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "002119056020.mp3"
    },
    {
      "number": 21,
      "text": "وَلَحۡمِ طَيۡرٍ مِّمَّا يَشۡتَهُوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "002222056021.mp3"
    },
    {
      "number": 22,
      "text": "وَحُوۡرٌ عِيۡنٌۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "002326056022.mp3"
    },
    {
      "number": 23,
      "text": "كَاَمۡثَالِ اللُّـؤۡلُـوٴِالۡمَكۡنُوۡنِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "002434056023.mp3"
    },
    {
      "number": 24,
      "text": "جَزَآءًۢ بِمَا كَانُوۡا يَعۡمَلُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "002537056024.mp3"
    },
    {
      "number": 25,
      "text": "لَا يَسۡمَعُوۡنَ فِيۡهَا لَغۡوًا وَّلَا تَاۡثِيۡمًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "002712056025.mp3"
    },
    {
      "number": 26,
      "text": "اِلَّا قِيۡلًا سَلٰمًا سَلٰمًا",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "002817056026.mp3"
    },
    {
      "number": 27,
      "text": "وَاَصۡحٰبُ الۡيَمِيۡنِ\u0026ensp;ۙ مَاۤ اَصۡحٰبُ الۡيَمِيۡنِؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "002922056027.mp3"
    },
    {
      "number": 28,
      "text": "فِىۡ سِدۡرٍ مَّخۡضُوۡدٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "003008056028.mp3"
    },
    {
      "number": 29,
      "text": "وَّطَلۡحٍ مَّنۡضُوۡدٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "003107056029.mp3"
    },
    {
      "number": 30,
      "text": "وَّظِلٍّ مَّمۡدُوۡدٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "003203056030.mp3"
    },
    {
      "number": 31,
      "text": "وَّ مَآءٍ مَّسۡكُوۡبٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "003309056031.mp3"
    },
    {
      "number": 32,
      "text": "وَّفَاكِهَةٍ كَثِيۡرَةٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "003400056032.mp3"
    },
    {
      "number": 33,
      "text": "لَّا مَقۡطُوۡعَةٍ وَّلَا مَمۡنُوۡعَةٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "003538056033.mp3"
    },
    {
      "number": 34,
      "text": "وَّ فُرُشٍ مَّرۡفُوۡعَةٍؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "004514056034.mp3"
    },
    {
      "number": 35,
      "text": "اِنَّاۤ اَنۡشَاۡنٰهُنَّ اِنۡشَآءًۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "010301056035.mp3"
    },
    {
      "number": 36,
      "text": "فَجَعَلۡنٰهُنَّ اَبۡكَارًاۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "010351056036.mp3"
    },
    {
      "number": 37,
      "text": "عُرُبًا اَتۡرَابًاۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "010543056037.mp3"
    },
    {
      "number": 38,
      "text": "لِّاَصۡحٰبِ الۡيَمِيۡنِؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "010623056038.mp3"
    }
  ]
}