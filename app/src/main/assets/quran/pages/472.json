{
  "maps": {},
  "suraStart": false,
  "suraNo": 56,
  "ayatStart": 39,
  "ayatEnd": 74,
  "pageNo": 472,
  "ayatList": [
    {
      "number": 39,
      "text": "ثُلَّةٌ مِّنَ الۡاَوَّلِيۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "011214056039.mp3"
    },
    {
      "number": 40,
      "text": "وَثُلَّةٌ مِّنَ الۡاٰخِرِيۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "011309056040.mp3"
    },
    {
      "number": 41,
      "text": "وَاَصۡحٰبُ الشِّمَالِ\u0026ensp;ۙ مَاۤ اَصۡحٰبُ الشِّمَالِؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "011452056041.mp3"
    },
    {
      "number": 42,
      "text": "فِىۡ سَمُوۡمٍ وَّحَمِيۡمٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "011537056042.mp3"
    },
    {
      "number": 43,
      "text": "وَّظِلٍّ مِّنۡ يَّحۡمُوۡمٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "011618056043.mp3"
    },
    {
      "number": 44,
      "text": "لَّا بَارِدٍ وَّلَا كَرِيۡمٍ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "011717056044.mp3"
    },
    {
      "number": 45,
      "text": "اِنَّهُمۡ كَانُوۡا قَبۡلَ ذٰ لِكَ مُتۡرَفِيۡنَۚ \u0026ensp;ۖ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "011901056045.mp3"
    },
    {
      "number": 46,
      "text": "وَكَانُوۡا يُصِرُّوۡنَ عَلَى الۡحِنۡثِ الۡعَظِيۡمِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "012032056046.mp3"
    },
    {
      "number": 47,
      "text": "وَكَانُوۡا يَقُوۡلُوۡنَ\u0026ensp;ۙ اَٮِٕذَا مِتۡنَا وَكُنَّا تُرَابًا وَّعِظَامًا ءَاِنَّا لَمَبۡعُوۡثُوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "012121056047.mp3"
    },
    {
      "number": 48,
      "text": "اَوَاٰبَآؤُنَا الۡاَوَّلُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "012214056048.mp3"
    },
    {
      "number": 49,
      "text": "قُلۡ اِنَّ الۡاَوَّلِيۡنَ وَالۡاٰخِرِيۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "012308056049.mp3"
    },
    {
      "number": 50,
      "text": "لَمَجۡمُوۡعُوۡنَ\u0026ensp;ۙ اِلٰى مِيۡقَاتِ يَوۡمٍ مَّعۡلُوۡمٍ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "012357056050.mp3"
    },
    {
      "number": 51,
      "text": "ثُمَّ اِنَّكُمۡ اَيُّهَا الضَّآلُّوۡنَ الۡمُكَذِّبُوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "012511056051.mp3"
    },
    {
      "number": 52,
      "text": "لَاٰكِلُوۡنَ مِنۡ شَجَرٍ مِّنۡ زَقُّوۡمٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "012647056052.mp3"
    },
    {
      "number": 53,
      "text": "فَمٰلِــُٔوۡنَ مِنۡهَا الۡبُطُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "012738056053.mp3"
    },
    {
      "number": 54,
      "text": "فَشٰرِبُوۡنَ عَلَيۡهِ مِنَ الۡحَمِيۡمِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "012824056054.mp3"
    },
    {
      "number": 55,
      "text": "فَشٰرِبُوۡنَ شُرۡبَ الۡهِيۡمِؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "012927056055.mp3"
    },
    {
      "number": 56,
      "text": "هٰذَا نُزُلُهُمۡ يَوۡمَ الدِّيۡنِؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "013012056056.mp3"
    },
    {
      "number": 57,
      "text": "نَحۡنُ خَلَقۡنٰكُمۡ فَلَوۡلَا تُصَدِّقُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "013106056057.mp3"
    },
    {
      "number": 58,
      "text": "اَفَرَءَيۡتُمۡ مَّا تُمۡنُوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "013150056058.mp3"
    },
    {
      "number": 59,
      "text": "ءَاَنۡتُمۡ تَخۡلُقُوۡنَهٗۤ اَمۡ نَحۡنُ الۡخٰلِقُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "013258056059.mp3"
    },
    {
      "number": 60,
      "text": "نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ الۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوۡقِيۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "013343056060.mp3"
    },
    {
      "number": 61,
      "text": "عَلٰٓى اَنۡ نُّبَدِّلَ اَمۡثَالَـكُمۡ وَنُـنۡشِئَكُمۡ فِىۡ مَا لَا تَعۡلَمُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "013439056061.mp3"
    },
    {
      "number": 62,
      "text": "وَلَـقَدۡ عَلِمۡتُمُ النَّشۡاَةَ الۡاُوۡلٰى فَلَوۡلَا تَذَكَّرُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "013542056062.mp3"
    },
    {
      "number": 63,
      "text": "اَفَرَءَيۡتُمۡ مَّا تَحۡرُثُوۡنَؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "013630056063.mp3"
    },
    {
      "number": 64,
      "text": "ءَاَنۡتُمۡ تَزۡرَعُوۡنَهٗۤ اَمۡ نَحۡنُ الزّٰرِعُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "013715056064.mp3"
    },
    {
      "number": 65,
      "text": "لَوۡ نَشَآءُ لَجَـعَلۡنٰهُ حُطَامًا فَظَلۡتُمۡ تَفَكَّهُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "013806056065.mp3"
    },
    {
      "number": 66,
      "text": "اِنَّا لَمُغۡرَمُوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "013906056066.mp3"
    },
    {
      "number": 67,
      "text": "بَلۡ نَحۡنُ مَحۡرُوۡمُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "014009056067.mp3"
    },
    {
      "number": 68,
      "text": "اَفَرَءَيۡتُمُ الۡمَآءَ الَّذِىۡ تَشۡرَبُوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "014100056068.mp3"
    },
    {
      "number": 69,
      "text": "ءَاَنۡـتُمۡ اَنۡزَلۡـتُمُوۡهُ مِنَ الۡمُزۡنِ اَمۡ نَحۡنُ الۡمُنۡزِلُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "014146056069.mp3"
    },
    {
      "number": 70,
      "text": "لَوۡ نَشَآءُ جَعَلۡنٰهُ اُجَاجًا فَلَوۡلَا تَشۡكُرُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "014240056070.mp3"
    },
    {
      "number": 71,
      "text": "\u0026nbsp;اَفَرَءَيۡتُمُ النَّارَ الَّتِىۡ تُوۡرُوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "014409056071.mp3"
    },
    {
      "number": 72,
      "text": "ءَاَنۡتُمۡ اَنۡشَاۡتُمۡ شَجَرَتَهَاۤ اَمۡ نَحۡنُ الۡمُنۡشِـُٔـوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "014522056072.mp3"
    },
    {
      "number": 73,
      "text": "نَحۡنُ جَعَلۡنٰهَا تَذۡكِرَةً وَّمَتَاعًا لِّلۡمُقۡوِيۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "014605056073.mp3"
    },
    {
      "number": 74,
      "text": "فَسَبِّحۡ بِاسۡمِ رَبِّكَ الۡعَظِيۡمِ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "014658056074.mp3"
    }
  ]
}