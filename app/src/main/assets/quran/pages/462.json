{
  "maps": {},
  "suraStart": true,
  "suraNo": 53,
  "ayatStart": 1,
  "ayatEnd": 25,
  "pageNo": 462,
  "ayatList": [
    {
      "number": 1,
      "text": "وَالنَّجۡمِ اِذَا هَوٰىۙ\u0026rlm;",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "225945053001.mp3"
    },
    {
      "number": 2,
      "text": "مَا ضَلَّ صَاحِبُكُمۡ وَمَا غَوٰى\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "230041053002.mp3"
    },
    {
      "number": 3,
      "text": "وَمَا يَنۡطِقُ عَنِ الۡهَوٰىؕ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "230128053003.mp3"
    },
    {
      "number": 4,
      "text": "﻿\u0026nbsp; اِنۡ هُوَ اِلَّا وَحۡىٌ يُّوۡحٰىۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "230226053004.mp3"
    },
    {
      "number": 5,
      "text": "عَلَّمَهٗ شَدِيۡدُ الۡقُوٰىۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "230311053005.mp3"
    },
    {
      "number": 6,
      "text": "ذُوۡ مِرَّةٍؕ فَاسۡتَوٰىۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "230419053006.mp3"
    },
    {
      "number": 7,
      "text": "وَهُوَ بِالۡاُفُقِ الۡاَعۡلٰى ؕ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "230504053007.mp3"
    },
    {
      "number": 8,
      "text": "ثُمَّ دَنَا فَتَدَلّٰىۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "230628053008.mp3"
    },
    {
      "number": 9,
      "text": "﻿\u0026nbsp; فَكَانَ قَابَ قَوۡسَيۡنِ اَوۡ اَدۡنٰى\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "230734053009.mp3"
    },
    {
      "number": 10,
      "text": "﻿\u0026nbsp; فَاَوۡحٰۤى الٰى عَبۡدِهٖ مَاۤ اَوۡحٰىؕ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "230855053010.mp3"
    },
    {
      "number": 11,
      "text": "مَا كَذَبَ الۡفُؤَادُ مَا رَاٰى",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "230959053011.mp3"
    },
    {
      "number": 12,
      "text": "\u0026nbsp;اَفَتُمٰرُوۡنَهٗ عَلٰى مَا يَرٰى\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "231050053012.mp3"
    },
    {
      "number": 13,
      "text": "وَلَقَدۡ رَاٰهُ نَزۡلَةً اُخۡرٰىۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "231141053013.mp3"
    },
    {
      "number": 14,
      "text": "عِنۡدَ سِدۡرَةِ الۡمُنۡتَهٰى",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "231233053014.mp3"
    },
    {
      "number": 15,
      "text": "عِنۡدَهَا جَنَّةُ الۡمَاۡوٰىؕ\u0026rlm;\u0026nbsp;",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "231332053015.mp3"
    },
    {
      "number": 16,
      "text": "﻿\u0026nbsp; اِذۡ يَغۡشَى السِّدۡرَةَ مَا يَغۡشٰىۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "231434053016.mp3"
    },
    {
      "number": 17,
      "text": "﻿\u0026nbsp; مَا زَاغَ الۡبَصَرُ وَمَا طَغٰى",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "231547053017.mp3"
    },
    {
      "number": 18,
      "text": "﻿\u0026nbsp; لَقَدۡ رَاٰى مِنۡ اٰيٰتِ رَبِّهِ الۡكُبۡرٰى",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "231642053018.mp3"
    },
    {
      "number": 19,
      "text": "اَفَرَءَيۡتُمُ اللّٰتَ وَالۡعُزّٰىۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "231737053019.mp3"
    },
    {
      "number": 20,
      "text": "\u0026nbsp;وَمَنٰوةَ الثَّالِثَةَ الۡاُخۡرٰى\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "231841053020.mp3"
    },
    {
      "number": 21,
      "text": "اَلَـكُمُ الذَّكَرُ وَلَهُ الۡاُنۡثٰى",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "231937053021.mp3"
    },
    {
      "number": 22,
      "text": "تِلۡكَ اِذًا قِسۡمَةٌ ضِيۡزٰى",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "232040053022.mp3"
    },
    {
      "number": 23,
      "text": "اِنۡ هِىَ اِلَّاۤ اَسۡمَآءٌ سَمَّيۡتُمُوۡهَاۤ اَنۡتُمۡ وَاٰبَآؤُكُمۡ مَّاۤ اَنۡزَلَ اللّٰهُ بِهَا مِنۡ سُلۡطٰنٍ\u0026zwnj;ؕ اِنۡ يَّتَّبِعُوۡنَ اِلَّا الظَّنَّ وَمَا تَهۡوَى الۡاَنۡفُسُ\u0026zwnj;ۚ وَلَقَدۡ جَآءَهُمۡ مِّنۡ رَّبِّهِمُ الۡهُدٰىؕ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "232140053023.mp3"
    },
    {
      "number": 24,
      "text": "\u0026nbsp;اَمۡ لِلۡاِنۡسَانِ مَا تَمَنّٰى \u0026ensp; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "232248053024.mp3"
    },
    {
      "number": 25,
      "text": "فَلِلّٰهِ الۡاٰخِرَةُ وَالۡاُوۡلٰى\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "232358053025.mp3"
    }
  ]
}