  "ayatStart": 47,
  "ayatEnd": 60,
  "pageNo": 459,
  "ayatList": [
    {
      "number": 47,
      "text": "وَ السَّمَآءَ بَنَيۡنٰهَا بِاَيۡٮدٍ وَّاِنَّا لَمُوۡسِعُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "005440051047.mp3"
    },
    {
      "number": 48,
      "text": "وَالۡاَرۡضَ فَرَشۡنٰهَا فَنِعۡمَ الۡمٰهِدُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "005535051048.mp3"
    },
    {
      "number": 49,
      "text": "وَمِنۡ كُلِّ شَىۡءٍ خَلَقۡنَا زَوۡجَيۡنِ لَعَلَّكُمۡ تَذَكَّرُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "005633051049.mp3"
    },
    {
      "number": 50,
      "text": "فَفِرُّوۡۤا اِلَى اللّٰهِ\u0026zwnj;ؕ اِنِّىۡ لَـكُمۡ مِّنۡهُ نَذِيۡرٌ مُّبِيۡنٌ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "005734051050.mp3"
    },
    {
      "number": 51,
      "text": "وَلَا تَجۡعَلُوۡا مَعَ اللّٰهِ اِلٰهًا اٰخَرَ\u0026zwnj;ؕ اِنِّىۡ لَـكُمۡ مِّنۡهُ نَذِيۡرٌ مُّبِيۡنٌ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "005851051051.mp3"
    },
    {
      "number": 52,
      "text": "كَذٰلِكَ مَاۤ اَتَى الَّذِيۡنَ مِنۡ قَبۡلِهِمۡ مِّنۡ رَّسُوۡلٍ اِلَّا قَالُوۡا سَاحِرٌ اَوۡ مَجۡنُوۡنٌ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "010020051052.mp3"
    },
    {
      "number": 53,
      "text": "اَتَوَاصَوۡا بِهٖ\u0026zwnj;ۚ بَلۡ هُمۡ قَوۡمٌ طَاغُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "010107051053.mp3"
    },
    {
      "number": 54,
      "text": "فَتَوَلَّ عَنۡهُمۡ فَمَاۤ اَنۡتَ بِمَلُوۡمٍ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "010228051054.mp3"
    },
    {
      "number": 55,
      "text": "وَّذَكِّرۡ فَاِنَّ الذِّكۡرٰى تَنۡفَعُ الۡمُؤۡمِنِيۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "010315051055.mp3"
    },
    {
      "number": 56,
      "text": "وَمَا خَلَقۡتُ الۡجِنَّ وَالۡاِنۡسَ اِلَّا لِيَعۡبُدُوۡنِ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "010412051056.mp3"
    },
    {
      "number": 57,
      "text": "مَاۤ اُرِيۡدُ مِنۡهُمۡ مِّنۡ رِّزۡقٍ وَّمَاۤ اُرِيۡدُ اَنۡ يُّطۡعِمُوۡنِ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "010509051057.mp3"
    },
    {
      "number": 58,
      "text": "اِنَّ اللّٰهَ هُوَ الرَّزَّاقُ ذُو الۡقُوَّةِ الۡمَتِيۡنُ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "010610051058.mp3"
    },
    {
      "number": 59,
      "text": "فَاِنَّ لِلَّذِيۡنَ ظَلَمُوۡا ذَنُوۡبًا مِّثۡلَ ذَنُوۡبِ اَصۡحٰبِهِمۡ فَلَا يَسۡتَعۡجِلُوۡنِ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "010706051059.mp3"
    },
    {
      "number": 60,
      "text": "فَوَيۡلٌ لِّـلَّذِيۡنَ كَفَرُوۡا مِنۡ يَّوۡمِهِمُ الَّذِىۡ يُوۡعَدُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "010753051060.mp3"
    }
  ]
}