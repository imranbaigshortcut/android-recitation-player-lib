{
  "maps": {},
  "suraStart": false,
  "suraNo": 43,
  "ayatStart": 68,
  "ayatEnd": 89,
  "pageNo": 432,
  "ayatList": [
    {
      "number": 68,
      "text": "يٰعِبَادِ لَا خَوۡفٌ عَلَيۡكُمُ الۡيَوۡمَ وَلَاۤ اَنۡتُمۡ تَحۡزَنُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "171535043068.mp3"
    },
    {
      "number": 69,
      "text": "اَلَّذِيۡنَ اٰمَنُوۡا بِاٰيٰتِنَا وَكَانُوۡا مُسۡلِمِيۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "171655043069.mp3"
    },
    {
      "number": 70,
      "text": "اُدۡخُلُوا الۡجَنَّةَ اَنۡتُمۡ وَاَزۡوَاجُكُمۡ تُحۡبَرُوۡنَ\u0026zwnj;\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "171800043070.mp3"
    },
    {
      "number": 71,
      "text": "يُطَافُ عَلَيۡهِمۡ بِصِحَافٍ مِّنۡ ذَهَبٍ وَّاَكۡوَابٍ\u0026zwnj;ۚ وَفِيۡهَا مَا تَشۡتَهِيۡهِ الۡاَنۡفُسُ وَتَلَذُّ الۡاَعۡيُنُ\u0026zwnj;ۚ وَاَنۡتُمۡ فِيۡهَا خٰلِدُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "171957043071.mp3"
    },
    {
      "number": 72,
      "text": "وَتِلۡكَ الۡجَنَّةُ الَّتِىۡۤ اُوۡرِثۡتُمُوۡهَا بِمَا كُنۡتُمۡ تَعۡمَلُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "172116043072.mp3"
    },
    {
      "number": 73,
      "text": "لَكُمۡ فِيۡهَا فَاكِهَةٌ كَثِيۡرَةٌ مِّنۡهَا تَاۡكُلُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "172207043073.mp3"
    },
    {
      "number": 74,
      "text": "اِنَّ الۡمُجۡرِمِيۡنَ فِىۡ عَذَابِ جَهَنَّمَ خٰلِدُوۡنَ ۚ ۖ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "172254043074.mp3"
    },
    {
      "number": 75,
      "text": "لَا يُفَتَّرُ عَنۡهُمۡ وَهُمۡ فِيۡهِ مُبۡلِسُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "172348043075.mp3"
    },
    {
      "number": 76,
      "text": "وَمَا ظَلَمۡنٰهُمۡ وَ لٰـكِنۡ كَانُوۡا هُمُ الظّٰلِمِيۡنَ",
      "translationNo": "Her kommer norsk oversettslse",
      "commentary": "",
      "audioTalawat": "172445043076.mp3"
    },
    {
      "number": 77,
      "text": "وَنَادَوۡا يٰمٰلِكُ لِيَقۡضِ عَلَيۡنَا رَبُّكَ\u0026zwnj;ؕ قَالَ اِنَّكُمۡ مّٰكِثُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "104528043077.mp3"
    },
    {
      "number": 78,
      "text": "لَقَدۡ جِئۡنٰكُمۡ بِالۡحَـقِّ وَلٰـكِنَّ اَكۡثَرَكُمۡ لِلۡحَقِّ كٰرِهُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "172636043078.mp3"
    },
    {
      "number": 79,
      "text": "اَمۡ اَبۡرَمُوۡۤا اَمۡرًا فَاِنَّا مُبۡرِمُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "172724043079.mp3"
    },
    {
      "number": 80,
      "text": "اَمۡ يَحۡسَبُوۡنَ اَنَّا لَا نَسۡمَعُ سِرَّهُمۡ وَنَجۡوٰٮهُمۡ\u0026zwnj;ؕ بَلٰى وَرُسُلُنَا لَدَيۡهِمۡ يَكۡتُبُوۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "172825043080.mp3"
    },
    {
      "number": 81,
      "text": "قُلۡ اِنۡ كَانَ لِلرَّحۡمٰنِ وَلَدٌ\u0026nbsp;\u0026nbsp;ۖ فَاَنَا اَوَّلُ الۡعٰبِدِيۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "172939043081.mp3"
    },
    {
      "number": 82,
      "text": "سُبۡحٰنَ رَبِّ السَّمٰوٰتِ وَالۡاَرۡضِ رَبِّ الۡعَرۡشِ عَمَّا يَصِفُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173100043082.mp3"
    },
    {
      "number": 83,
      "text": "فَذَرۡهُمۡ يَخُوۡضُوۡا وَيَلۡعَبُوۡا حَتّٰى يُلٰقُوۡا يَوۡمَهُمُ الَّذِىۡ يُوۡعَدُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173219043083.mp3"
    },
    {
      "number": 84,
      "text": "وَهُوَ الَّذِىۡ فِى السَّمَآءِ اِلٰـهٌ وَّفِى الۡاَرۡضِ اِلٰـهٌ\u0026zwnj; ؕ وَهُوَ الۡحَكِيۡمُ الۡعَلِيۡمُ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173323043084.mp3"
    },
    {
      "number": 85,
      "text": "وَتَبٰـرَكَ الَّذِىۡ لَهٗ مُلۡكُ السَّمٰوٰتِ وَالۡاَرۡضِ وَمَا بَيۡنَهُمَا\u0026zwnj; ۚ وَعِنۡدَهٗ عِلۡمُ السَّاعَةِ\u0026zwnj; ۚ وَاِلَيۡهِ تُرۡجَعُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173410043085.mp3"
    },
    {
      "number": 86,
      "text": "وَلَا يَمۡلِكُ الَّذِيۡنَ يَدۡعُوۡنَ مِنۡ دُوۡنِهِ الشَّفَاعَةَ اِلَّا مَنۡ شَهِدَ بِالۡحَـقِّ وَهُمۡ يَعۡلَمُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173500043086.mp3"
    },
    {
      "number": 87,
      "text": "وَلَٮِٕنۡ سَاَلۡـتَهُمۡ مَّنۡ خَلَقَهُمۡ لَيَقُوۡلُنَّ اللّٰهُ\u0026zwnj; فَاَنّٰى يُؤۡفَكُوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173539043087.mp3"
    },
    {
      "number": 88,
      "text": "وَقِيۡلِهٖ يٰرَبِّ اِنَّ هٰٓؤُلَاۤءِ قَوۡمٌ لَّا يُؤۡمِنُوۡنَ\u0026zwnj;ۘ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173628043088.mp3"
    },
    {
      "number": 89,
      "text": "فَاصۡفَحۡ عَنۡهُمۡ وَقُلۡ سَلٰمٌ\u0026zwnj;ؕ فَسَوۡفَ يَعۡلَمُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173707043089.mp3"
    }
  ]
}