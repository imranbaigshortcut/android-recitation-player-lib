{
  "maps": {},
  "suraStart": false,
  "suraNo": 37,
  "ayatStart": 114,
  "ayatEnd": 138,
  "pageNo": 391,
  "ayatList": [
    {
      "number": 114,
      "text": "وَلَقَدۡ مَنَنَّا عَلٰى مُوۡسٰى وَهٰرُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "141511037114.mp3"
    },
    {
      "number": 115,
      "text": "وَنَجَّيۡنٰهُمَا وَقَوۡمَهُمَا مِنَ الۡكَرۡبِ الۡعَظِيۡمِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "141608037115.mp3"
    },
    {
      "number": 116,
      "text": "وَنَصَرۡنٰهُمۡ فَكَانُوۡا هُمُ الۡغٰلِبِيۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "141656037116.mp3"
    },
    {
      "number": 117,
      "text": "وَاٰتَيۡنٰهُمَا الۡكِتٰبَ الۡمُسۡتَبِيۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "141751037117.mp3"
    },
    {
      "number": 118,
      "text": "وَهَدَيۡنٰهُمَا الصِّرَاطَ الۡمُسۡتَقِيۡمَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "141845037118.mp3"
    },
    {
      "number": 119,
      "text": "وَتَرَكۡنَا عَلَيۡهِمَا فِى الۡاٰخِرِيۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "141952037119.mp3"
    },
    {
      "number": 120,
      "text": "سَلٰمٌ عَلٰى مُوۡسٰى وَهٰرُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "142058037120.mp3"
    },
    {
      "number": 121,
      "text": "اِنَّا كَذٰلِكَ نَجۡزِى الۡمُحۡسِنِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "142141037121.mp3"
    },
    {
      "number": 122,
      "text": "اِنَّهُمَا مِنۡ عِبَادِنَا الۡمُؤۡمِنِيۡنَ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "142234037122.mp3"
    },
    {
      "number": 123,
      "text": "وَاِنَّ اِلۡيَاسَ لَمِنَ الۡمُرۡسَلِيۡنَؕ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "142317037123.mp3"
    },
    {
      "number": 124,
      "text": "اِذۡ قَالَ لِقَوۡمِهٖۤ اَلَا تَتَّقُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "142409037124.mp3"
    },
    {
      "number": 125,
      "text": "اَتَدۡعُوۡنَ بَعۡلًا وَّتَذَرُوۡنَ اَحۡسَنَ الۡخٰلِقِيۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "142507037125.mp3"
    },
    {
      "number": 126,
      "text": "اللّٰهَ رَبَّكُمۡ وَرَبَّ اٰبَآٮِٕكُمُ الۡاَوَّلِيۡنَ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "142610037126.mp3"
    },
    {
      "number": 127,
      "text": "فَكَذَّبُوۡهُ فَاِنَّهُمۡ لَمُحۡضَرُوۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "142700037127.mp3"
    },
    {
      "number": 128,
      "text": "اِلَّا عِبَادَ اللّٰهِ الۡمُخۡلَصِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "142747037128.mp3"
    },
    {
      "number": 129,
      "text": "وَتَرَكۡنَا عَلَيۡهِ فِى الۡاٰخِرِيۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "142835037129.mp3"
    },
    {
      "number": 130,
      "text": "سَلٰمٌ عَلٰٓى اِلۡ يَاسِيۡنَ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "142921037130.mp3"
    },
    {
      "number": 131,
      "text": "اِنَّا كَذٰلِكَ نَجۡزِى الۡمُحۡسِنِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "143014037131.mp3"
    },
    {
      "number": 132,
      "text": "اِنَّهٗ مِنۡ عِبَادِنَا الۡمُؤۡمِنِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "143104037132.mp3"
    },
    {
      "number": 133,
      "text": "وَاِنَّ لُوۡطًا لَّمِنَ الۡمُرۡسَلِيۡنَؕ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "143149037133.mp3"
    },
    {
      "number": 134,
      "text": "اِذۡ نَجَّيۡنٰهُ وَاَهۡلَهٗۤ اَجۡمَعِيۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "143250037134.mp3"
    },
    {
      "number": 135,
      "text": "اِلَّا عَجُوۡزًا فِى الۡغٰبِرِيۡنَ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "143339037135.mp3"
    },
    {
      "number": 136,
      "text": "ثُمَّ دَمَّرۡنَا الۡاٰخَرِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "1614580370136.wav"
    },
    {
      "number": 137,
      "text": "وَاِنَّكُمۡ لَتَمُرُّوۡنَ عَلَيۡهِمۡ مُّصۡبِحِيۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "143846037137.mp3"
    },
    {
      "number": 138,
      "text": "وَبِالَّيۡلِ\u0026zwnj;ؕ اَفَلَا تَعۡقِلُوۡنَ\u0026zwnj;\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "143941037138.mp3"
    }
  ]
}