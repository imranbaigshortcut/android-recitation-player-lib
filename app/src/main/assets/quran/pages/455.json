{
  "maps": {},
  "suraStart": false,
  "suraNo": 50,
  "ayatStart": 16,
  "ayatEnd": 29,
  "pageNo": 455,
  "ayatList": [
    {
      "number": 16,
      "text": "وَلَقَدۡ خَلَقۡنَا الۡاِنۡسَانَ وَنَعۡلَمُ مَا تُوَسۡوِسُ بِهٖ نَفۡسُهٗ\u0026nbsp;\u0026nbsp;\u0026nbsp;ۖۚ وَنَحۡنُ اَقۡرَبُ اِلَيۡهِ مِنۡ حَبۡلِ الۡوَرِيۡدِ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "220737050016.mp3"
    },
    {
      "number": 17,
      "text": "﻿\u0026nbsp; اِذۡ يَتَلَقَّى الۡمُتَلَقِّيٰنِ عَنِ الۡيَمِيۡنِ وَعَنِ الشِّمَالِ قَعِيۡدٌ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "220852050017.mp3"
    },
    {
      "number": 18,
      "text": "مَا يَلۡفِظُ مِنۡ قَوۡلٍ اِلَّا لَدَيۡهِ رَقِيۡبٌ عَتِيۡدٌ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "220948050018.mp3"
    },
    {
      "number": 19,
      "text": "\u0026nbsp;وَ جَآءَتۡ سَكۡرَةُ الۡمَوۡتِ بِالۡحَـقِّ\u0026zwnj;ؕ ذٰلِكَ مَا كُنۡتَ مِنۡهُ تَحِيۡدُ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "221041050019.mp3"
    },
    {
      "number": 20,
      "text": "وَنُفِخَ فِى الصُّوۡرِ \u0026zwnj;ؕ ذٰ لِكَ يَوۡمُ الۡوَعِيۡدِ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "221137050020.mp3"
    },
    {
      "number": 21,
      "text": "\u0026nbsp;وَجَآءَتۡ كُلُّ نَفۡسٍ مَّعَهَا سَآٮِٕقٌ وَّشَهِيۡدٌ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "221329050021.mp3"
    },
    {
      "number": 22,
      "text": "\u0026nbsp;لَقَدۡ كُنۡتَ فِىۡ غَفۡلَةٍ مِّنۡ هٰذَا فَكَشَفۡنَا عَنۡكَ غِطَآءَكَ فَبَصَرُكَ الۡيَوۡمَ حَدِيۡدٌ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "221425050022.mp3"
    },
    {
      "number": 23,
      "text": "وَقَالَ قَرِيۡـنُهٗ هٰذَا مَا لَدَىَّ عَتِيۡدٌ\u0026ensp;ؕ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "221519050023.mp3"
    },
    {
      "number": 24,
      "text": "\u0026nbsp;اَلۡقِيَا فِىۡ جَهَنَّمَ كُلَّ كَفَّارٍ عَنِيۡدٍۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "221638050024.mp3"
    },
    {
      "number": 25,
      "text": "مَّنَّاعٍ لِّلۡخَيۡرِ مُعۡتَدٍ مُّرِيۡبِ ۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "221757050025.mp3"
    },
    {
      "number": 26,
      "text": "\u0026nbsp;اۨلَّذِىۡ جَعَلَ مَعَ اللّٰهِ اِلٰهًا اٰخَرَ فَاَ لۡقِيٰهُ فِى الۡعَذَابِ الشَّدِيۡدِ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "221857050026.mp3"
    },
    {
      "number": 27,
      "text": "\u0026nbsp;قَالَ قَرِيۡنُهٗ رَبَّنَا مَاۤ اَطۡغَيۡتُهٗ وَلٰـكِنۡ كَانَ فِىۡ ضَلٰلٍۢ بَعِيۡدٍ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "222002050027.mp3"
    },
    {
      "number": 28,
      "text": "قَالَ لَا تَخۡتَصِمُوۡا لَدَىَّ وَقَدۡ قَدَّمۡتُ اِلَيۡكُمۡ بِالۡوَعِيۡدِ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "222104050028.mp3"
    },
    {
      "number": 29,
      "text": "\u0026nbsp;مَا يُبَدَّلُ الۡقَوۡلُ لَدَىَّ وَمَاۤ اَنَا بِظَلَّامٍ لِّلۡعَبِيۡدِ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "222153050029.mp3"
    }
  ]
}