  "ayatEnd": 11,
  "pageNo": 544,
  "ayatList": [
    {
      "number": 1,
      "text": "وَالۡعٰدِيٰتِ ضَبۡحًا ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "100438100001.mp3"
    },
    {
      "number": 2,
      "text": "فَالۡمُوۡرِيٰتِ قَدۡحًا ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "163047100002.mp3"
    },
    {
      "number": 3,
      "text": "\u0026nbsp;فَالۡمُغِيۡرٰتِ صُبۡحًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "163152100003.mp3"
    },
    {
      "number": 4,
      "text": "\u0026nbsp;فَاَثَرۡنَ بِهٖ نَقۡعًا ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "163230100004.mp3"
    },
    {
      "number": 5,
      "text": "\u0026nbsp;فَوَسَطۡنَ بِهٖ جَمۡعًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "163337100005.mp3"
    },
    {
      "number": 6,
      "text": "اِنَّ الۡاِنۡسَانَ لِرَبِّهٖ لَـكَنُوۡدٌ ۚ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "163422100006.mp3"
    },
    {
      "number": 7,
      "text": "\u0026nbsp;وَاِنَّهٗ عَلٰى ذٰلِكَ لَشَهِيۡدٌ ۚ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "163510100007.mp3"
    },
    {
      "number": 8,
      "text": "\u0026nbsp;وَاِنَّهٗ لِحُبِّ الۡخَيۡرِ لَشَدِيۡدٌ ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "163549100008.mp3"
    },
    {
      "number": 9,
      "text": "\u0026nbsp;اَفَلَا يَعۡلَمُ اِذَا بُعۡثِرَ مَا فِى الۡقُبُوۡرِۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "163644100009.mp3"
    },
    {
      "number": 10,
      "text": "\u0026nbsp;وَحُصِّلَ مَا فِى الصُّدُوۡرِۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "163718100010.mp3"
    },
    {
      "number": 11,
      "text": "اِنَّ رَبَّهُمۡ بِهِمۡ يَوۡمَٮِٕذٍ لَّخَبِيۡرٌ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "163752100011.mp3"
    }
  ]
}