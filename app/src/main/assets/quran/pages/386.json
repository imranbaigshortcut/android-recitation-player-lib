{
  "maps": {},
  "suraStart": false,
  "suraNo": 36,
  "ayatStart": 47,
  "ayatEnd": 67,
  "pageNo": 386,
  "ayatList": [

    {
      "number": 51,
      "text": "وَنُفِخَ فِى الصُّوۡرِ فَاِذَا هُمۡ مِّنَ الۡاَجۡدَاثِ اِلٰى رَبِّهِمۡ يَنۡسِلُوۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "201343036051.mp3"
    },
    {
      "number": 52,
      "text": "قَالُوۡا يٰوَيۡلَنَا مَنۡۢ بَعَثَنَا مِنۡ مَّرۡقَدِنَاۘؔ؄هٰذَا مَا وَعَدَ الرَّحۡمٰنُ وَصَدَقَ الۡمُرۡسَلُوۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "201515036052.mp3"
    },
    {
      "number": 53,
      "text": "اِنۡ كَانَتۡ اِلَّا صَيۡحَةً وَّاحِدَةً فَاِذَا هُمۡ جَمِيۡعٌ لَّدَيۡنَا مُحۡضَرُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "201627036053.mp3"
    },
    {
      "number": 54,
      "text": "فَالۡيَوۡمَ لَا تُظۡلَمُ نَفۡسٌ شَيۡـــًٔا وَّلَا تُجۡزَوۡنَ اِلَّا مَا كُنۡتُمۡ تَعۡمَلُوۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "201730036054.mp3"
    },
    {
      "number": 55,
      "text": "اِنَّ اَصۡحٰبَ الۡجَـنَّةِ الۡيَوۡمَ فِىۡ شُغُلٍ فٰكِهُوۡنَ\u0026zwnj;ۚ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "201830036055.mp3"
    },
    {
      "number": 56,
      "text": "هُمۡ وَاَزۡوَاجُهُمۡ فِىۡ ظِلٰلٍ عَلَى الۡاَرَآٮِٕكِ مُتَّكِـــُٔوۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "201928036056.mp3"
    },
    {
      "number": 57,
      "text": "لَهُمۡ فِيۡهَا فَاكِهَةٌ وَّلَهُمۡ مَّا يَدَّعُوۡنَ\u0026zwnj;\u0026nbsp;ۖ\u0026zwnj;ۚ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "202028036057.mp3"
    },
    {
      "number": 58,
      "text": "سَلٰمٌ قَوۡلًا مِّنۡ رَّبٍّ رَّحِيۡمٍ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "202329036058.mp3"
    },
    {
      "number": 59,
      "text": "وَامۡتَازُوا الۡيَوۡمَ اَيُّهَا الۡمُجۡرِمُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "202451036059.mp3"
    },
    {
      "number": 60,
      "text": "اَلَمۡ اَعۡهَدۡ اِلَيۡكُمۡ يٰبَنِىۡۤ اٰدَمَ اَنۡ لَّا تَعۡبُدُوا الشَّيۡطٰنَ\u0026zwnj;\u0026zwnj;ۚ اِنَّهٗ لَـكُمۡ عَدُوٌّ مُّبِيۡنٌ ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "202542036060.mp3"
    },
    {
      "number": 61,
      "text": "وَّاَنِ اعۡبُدُوۡنِىۡ\u0026nbsp;\u0026nbsp;ؔ\u0026zwnj;ؕ هٰذَا صِرَاطٌ مُّسۡتَقِيۡمٌ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "202646036061.mp3"
    },
    {
      "number": 62,
      "text": "وَلَقَدۡ اَضَلَّ مِنۡكُمۡ جِبِلًّا كَثِيۡرًا\u0026zwnj; ؕ اَفَلَمۡ تَكُوۡنُوۡا تَعۡقِلُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "202756036062.mp3"
    },
    {
      "number": 63,
      "text": "هٰذِهٖ جَهَنَّمُ الَّتِىۡ كُنۡتُمۡ تُوۡعَدُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "202922036063.mp3"
    },
    {
      "number": 64,
      "text": "اِصۡلَوۡهَا الۡيَوۡمَ بِمَا كُنۡتُمۡ تَكۡفُرُوۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "203032036064.mp3"
    },
    {
      "number": 65,
      "text": "اَلۡيَوۡمَ نَخۡتِمُ عَلٰٓى اَفۡوَاهِهِمۡ وَتُكَلِّمُنَاۤ اَيۡدِيۡهِمۡ وَتَشۡهَدُ اَرۡجُلُهُمۡ بِمَا كَانُوۡا يَكۡسِبُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "203149036065.mp3"
    },
    {
      "number": 66,
      "text": "وَلَوۡ نَشَآءُ لَـطَمَسۡنَا عَلٰٓى اَعۡيُنِهِمۡ فَاسۡتَبَقُوا الصِّرَاطَ فَاَنّٰى يُبۡصِرُوۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "203333036066.mp3"
    },
    {
      "number": 67,
      "text": "وَلَوۡ نَشَآءُ لَمَسَخۡنٰهُمۡ عَلٰى مَكَانَتِهِمۡ فَمَا اسۡتَطَاعُوۡا مُضِيًّا وَّلَا يَرۡجِعُوۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "203436036067.mp3"
    }
  ]
}