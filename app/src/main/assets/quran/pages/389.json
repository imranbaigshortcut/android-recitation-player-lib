{
  "maps": {},
  "suraStart": false,
  "suraNo": 37,
  "ayatStart": 22,
  "ayatEnd": 74,
  "pageNo": 389,
  "ayatList": [
    {
      "number": 22,
      "text": "اُحۡشُرُوا الَّذِيۡنَ ظَلَمُوۡا وَاَزۡوَاجَهُمۡ وَمَا كَانُوۡا يَعۡبُدُوۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "103231037022.mp3"
    },
    {
      "number": 23,
      "text": "مِنۡ دُوۡنِ اللّٰهِ فَاهۡدُوۡهُمۡ اِلٰى صِرَاطِ الۡجَحِيۡمِ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "103353037023.mp3"
    },
    {
      "number": 24,
      "text": "وَقِفُوۡهُمۡ\u0026zwnj; اِنَّهُمۡ مَّسْـُٔـوۡلُوۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "103512037024.mp3"
    },
    {
      "number": 25,
      "text": "مَا لَـكُمۡ لَا تَنَاصَرُوۡنَ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "103617037025.mp3"
    },
    {
      "number": 26,
      "text": "بَلۡ هُمُ الۡيَوۡمَ مُسۡتَسۡلِمُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "103659037026.mp3"
    },
    {
      "number": 27,
      "text": "وَاَقۡبَلَ بَعۡضُهُمۡ عَلٰى بَعۡضٍ يَّتَسَآءَلُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "103749037027.mp3"
    },
    {
      "number": 28,
      "text": "قَالُوۡۤا اِنَّكُمۡ كُنۡتُمۡ تَاۡتُوۡنَنَا عَنِ الۡيَمِيۡنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "103849037028.mp3"
    },
    {
      "number": 29,
      "text": "قَالُوۡا بَلْ لَّمۡ تَكُوۡنُوۡا مُؤۡمِنِيۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "103944037029.mp3"
    },
    {
      "number": 30,
      "text": "وَمَا كَانَ لَنَا عَلَيۡكُمۡ مِّنۡ سُلۡطٰنِ\u0026zwnj;ۚ بَلۡ كُنۡتُمۡ قَوۡمًا طٰغِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "104035037030.mp3"
    },
    {
      "number": 31,
      "text": "فَحَقَّ عَلَيۡنَا قَوۡلُ رَبِّنَآ\u0026nbsp;\u0026nbsp;\u0026nbsp;ۖ اِنَّا لَذَآٮِٕقُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "104129037031.mp3"
    },
    {
      "number": 32,
      "text": "فَاَغۡوَيۡنٰكُمۡ اِنَّا كُنَّا غٰوِيۡنَ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "104217037032.mp3"
    },
    {
      "number": 33,
      "text": "فَاِنَّهُمۡ يَوۡمَٮِٕذٍ فِى الۡعَذَابِ مُشۡتَرِكُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "104357037033.mp3"
    },
    {
      "number": 34,
      "text": "اِنَّا كَذٰلِكَ نَفۡعَلُ بِالۡمُجۡرِمِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "104448037034.mp3"
    },
    {
      "number": 35,
      "text": "اِنَّهُمۡ كَانُوۡۤا اِذَا قِيۡلَ لَهُمۡ لَاۤ اِلٰهَ اِلَّا اللّٰهُۙ يَسۡتَكۡبِرُوۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "104627037035.mp3"
    },
    {
      "number": 36,
      "text": "وَيَقُوۡلُوۡنَ اَٮِٕنَّا لَتٰرِكُوۡۤا اٰلِهَـتِنَا لِشَاعِرٍ مَّجۡـنُوۡنٍ ؕ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "104721037036.mp3"
    },
    {
      "number": 37,
      "text": "بَلۡ جَآءَ بِالۡحَقِّ وَصَدَّقَ الۡمُرۡسَلِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "104814037037.mp3"
    },
    {
      "number": 38,
      "text": "اِنَّكُمۡ لَذَآٮِٕقُوا الۡعَذَابِ الۡاَلِيۡمِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "104902037038.mp3"
    },
    {
      "number": 39,
      "text": "وَمَا تُجۡزَوۡنَ اِلَّا مَا كُنۡتُمۡ تَعۡمَلُوۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "104955037039.mp3"
    },
    {
      "number": 40,
      "text": "اِلَّا عِبَادَ اللّٰهِ الۡمُخۡلَصِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "105047037040.mp3"
    },
    {
      "number": 41,
      "text": "اُولٰٓٮِٕكَ لَهُمۡ رِزۡقٌ مَّعۡلُوۡمٌۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "105133037041.mp3"
    },
    {
      "number": 42,
      "text": "فَوَاكِهُ\u0026zwnj;ۚ وَهُمۡ مُّكۡرَمُوۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "105223037042.mp3"
    },
    {
      "number": 43,
      "text": "فِىۡ جَنّٰتِ النَّعِيۡمِۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "105312037043.mp3"
    },
    {
      "number": 44,
      "text": "عَلٰى سُرُرٍ مُّتَقٰبِلِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "105359037044.mp3"
    },
    {
      "number": 45,
      "text": "يُطَافُ عَلَيۡهِمۡ بِكَاۡسٍ مِّنۡ مَّعِيۡنٍۢ\u0026nbsp;ۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "105448037045.mp3"
    },
    {
      "number": 46,
      "text": "بَيۡضَآءَ لَذَّةٍ لِّلشّٰرِبِيۡنَ\u0026zwnj;\u0026nbsp;ۖ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "105538037046.mp3"
    },
    {
      "number": 47,
      "text": "لَا فِيۡهَا غَوۡلٌ وَّلَا هُمۡ عَنۡهَا يُنۡزَفُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "105628037047.mp3"
    },
    {
      "number": 48,
      "text": "وَعِنۡدَهُمۡ قٰصِرٰتُ الطَّرۡفِ عِيۡنٌۙ\u0026rlm;",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "105732037048.mp3"
    },
    {
      "number": 49,
      "text": "كَاَنَّهُنَّ بَيۡضٌ مَّكۡنُوۡنٌ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "105825037049.mp3"
    },
    {
      "number": 50,
      "text": "فَاَقۡبَلَ بَعۡضُهُمۡ عَلٰى بَعۡضٍ يَّتَسَآءَلُوۡنَ\u0026rlm;",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "105918037050.mp3"
    },
    {
      "number": 51,
      "text": "قَالَ قَآٮِٕلٌ مِّنۡهُمۡ اِنِّىۡ كَانَ لِىۡ قَرِيۡنٌۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "110003037051.mp3"
    },
    {
      "number": 52,
      "text": "يَقُوۡلُ اَءِ نَّكَ لَمِنَ الۡمُصَدِّقِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "110058037052.mp3"
    },
    {
      "number": 53,
      "text": "ءَاِذَا مِتۡنَا وَكُنَّا تُرَابًا وَّعِظَامًا ءَاِنَّا لَمَدِيۡنُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "110151037053.mp3"
    },
    {
      "number": 54,
      "text": "قَالَ هَلۡ اَنۡتُمۡ مُّطَّلِعُوۡنَ\u0026rlm;",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "110239037054.mp3"
    },
    {
      "number": 55,
      "text": "فَاطَّلَعَ فَرَاٰهُ فِىۡ سَوَآءِ الۡجَحِيۡمِ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "110321037055.mp3"
    },
    {
      "number": 56,
      "text": "قَالَ تَاللّٰهِ اِنۡ كِدْتَّ لَـتُرۡدِيۡنِۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "110418037056.mp3"
    },
    {
      "number": 57,
      "text": "وَلَوۡلَا نِعۡمَةُ رَبِّىۡ لَـكُنۡتُ مِنَ الۡمُحۡضَرِيۡنَ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "110509037057.mp3"
    },
    {
      "number": 58,
      "text": "اَفَمَا نَحۡنُ بِمَيِّتِيۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "110953037058.mp3"
    },
    {
      "number": 59,
      "text": "اِلَّا مَوۡتَتَـنَا الۡاُوۡلٰى وَمَا نَحۡنُ بِمُعَذَّبِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "111040037059.mp3"
    },
    {
      "number": 60,
      "text": "اِنَّ هٰذَا لَهُوَ الۡفَوۡزُ الۡعَظِيۡمُ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "111135037060.mp3"
    },
    {
      "number": 61,
      "text": "لِمِثۡلِ هٰذَا فَلۡيَعۡمَلِ الۡعٰمِلُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "111242037061.mp3"
    },
    {
      "number": 62,
      "text": "اَذٰ لِكَ خَيۡرٌ نُّزُلًا اَمۡ شَجَرَةُ الزَّقُّوۡمِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "111330037062.mp3"
    },
    {
      "number": 63,
      "text": "اِنَّا جَعَلۡنٰهَا فِتۡنَةً لِّلظّٰلِمِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "111425037063.mp3"
    },
    {
      "number": 64,
      "text": "اِنَّهَا شَجَرَةٌ تَخۡرُجُ فِىۡۤ اَصۡلِ الۡجَحِيۡمِۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "111523037064.mp3"
    },
    {
      "number": 65,
      "text": "طَلۡعُهَا كَاَنَّهٗ رُءُوۡسُ الشَّيٰطِيۡنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "111617037065.mp3"
    },
    {
      "number": 66,
      "text": "فَاِنَّهُمۡ لَاٰكِلُوۡنَ مِنۡهَا فَمٰلِــُٔــوۡنَ مِنۡهَا الۡبُطُوۡنَ ؕ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "111714037066.mp3"
    },
    {
      "number": 67,
      "text": "ثُمَّ اِنَّ لَهُمۡ عَلَيۡهَا لَشَوۡبًا مِّنۡ حَمِيۡمٍ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "130101037067.mp3"
    },
    {
      "number": 68,
      "text": "ثُمَّ اِنَّ مَرۡجِعَهُمۡ لَا۟اِلَى الۡجَحِيۡمِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "130146037068.mp3"
    },
    {
      "number": 69,
      "text": "اِنَّهُمۡ اَلۡفَوۡا اٰبَآءَهُمۡ ضَآلِّيۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "130240037069.mp3"
    },
    {
      "number": 70,
      "text": "فَهُمۡ عَلٰٓى اٰثٰرِهِمۡ يُهۡرَعُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "130323037070.mp3"
    },
    {
      "number": 71,
      "text": "وَلَـقَدۡ ضَلَّ قَبۡلَهُمۡ اَكۡثَرُ الۡاَوَّلِيۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "130417037071.mp3"
    },
    {
      "number": 72,
      "text": "وَلَقَدۡ اَرۡسَلۡنَا فِيۡهِمۡ مُّنۡذِرِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "130517037072.mp3"
    },
    {
      "number": 73,
      "text": "فَانْظُرۡ كَيۡفَ كَانَ عَاقِبَةُ الۡمُنۡذَرِيۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "130606037073.mp3"
    },
    {
      "number": 74,
      "text": "اِلَّا عِبَادَ اللّٰهِ الۡمُخۡلَصِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "130656037074.mp3"
    }
  ]
}