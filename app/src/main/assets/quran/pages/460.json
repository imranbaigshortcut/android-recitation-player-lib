{
  "maps": {},
  "suraStart": true,
  "suraNo": 52,
  "ayatStart": 1,
  "ayatEnd": 28,
  "pageNo": 460,
  "ayatList": [
    {
      "number": 1,
      "text": "وَالطُّوۡرِۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "192455052001.mp3"
    },
    {
      "number": 2,
      "text": "وَكِتٰبٍ مَّسۡطُوۡرٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "192605052002.mp3"
    },
    {
      "number": 3,
      "text": "فِىۡ رَقٍّ مَّنۡشُوۡرٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "192713052003.mp3"
    },
    {
      "number": 4,
      "text": "وَالۡبَيۡتِ الۡمَعۡمُوۡرِۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "192800052004.mp3"
    },
    {
      "number": 5,
      "text": "وَالسَّقۡفِ الۡمَرۡفُوۡعِۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "192841052005.mp3"
    },
    {
      "number": 6,
      "text": "وَالۡبَحۡرِ الۡمَسۡجُوۡرِۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "192927052006.mp3"
    },
    {
      "number": 7,
      "text": "اِنَّ عَذَابَ رَبِّكَ لوَاقِعٌ\u0026ensp;ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "193050052007.mp3"
    },
    {
      "number": 8,
      "text": "مَّا لَهٗ مِنۡ دَافِعٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "193136052008.mp3"
    },
    {
      "number": 9,
      "text": "يَّوۡمَ تَمُوۡرُ السَّمَآءُ مَوۡرًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "193226052009.mp3"
    },
    {
      "number": 10,
      "text": "وَّتَسِيۡرُ الۡجِبَالُ سَيۡرًا ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "193330052010.mp3"
    },
    {
      "number": 11,
      "text": "فَوَيۡلٌ يَّوۡمَٮِٕذٍ لِّـلۡمُكَذِّبِيۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "193423052011.mp3"
    },
    {
      "number": 12,
      "text": "الَّذِيۡنَ هُمۡ فِىۡ خَوۡضٍ يَّلۡعَبُوۡنَ\u0026zwnj;ۘ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "193513052012.mp3"
    },
    {
      "number": 13,
      "text": "يَوۡمَ يُدَعُّوۡنَ اِلٰى نَارِ جَهَنَّمَ دَعًّا",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "193604052013.mp3"
    },
    {
      "number": 14,
      "text": "هٰذِهِ النَّارُ الَّتِىۡ كُنۡتُمۡ بِهَا تُكَذِّبُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "193706052014.mp3"
    },
    {
      "number": 15,
      "text": "اَفَسِحۡرٌ هٰذَاۤ اَمۡ اَنۡتُمۡ لَا تُبۡصِرُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "193814052015.mp3"
    },
    {
      "number": 16,
      "text": "اِصۡلَوۡهَا فَاصۡبِرُوۡۤا اَوۡ لَا تَصۡبِرُوۡا\u0026zwnj;ۚ سَوَآءٌ عَلَيۡكُمۡ\u0026zwnj;ؕ اِنَّمَا تُجۡزَوۡنَ مَا كُنۡتُمۡ تَعۡمَلُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "193903052016.mp3"
    },
    {
      "number": 17,
      "text": "اِنَّ الۡمُتَّقِيۡنَ فِىۡ جَنّٰتٍ وَّنَعِيۡمٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "194001052017.mp3"
    },
    {
      "number": 18,
      "text": "فٰكِهِيۡنَ بِمَاۤ اٰتٰٮهُمۡ رَبُّهُمۡ\u0026zwnj;ۚ وَوَقٰٮهُمۡ رَبُّهُمۡ عَذَابَ الۡجَحِيۡمِ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "194051052018.mp3"
    },
    {
      "number": 19,
      "text": "كُلُوۡا وَاشۡرَبُوۡا هَـنِٓـيـْئًا ۢ بِمَا كُنۡـتُمۡ تَعۡمَلُوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "194215052019.mp3"
    },
    {
      "number": 20,
      "text": "مُتَّكِـــِٕيۡنَ عَلٰى سُرُرٍ مَّصۡفُوۡفَةٍ\u0026zwnj; ۚ وَزَوَّجۡنٰهُمۡ بِحُوۡرٍ عِيۡنٍ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "194311052020.mp3"
    },
    {
      "number": 21,
      "text": "وَالَّذِيۡنَ اٰمَنُوۡا وَاتَّبَعَتۡهُمۡ ذُرِّيَّتُهُمۡ بِاِيۡمَانٍ اَلۡحَـقۡنَا بِهِمۡ ذُرِّيَّتَهُمۡ وَمَاۤ اَلَـتۡنٰهُمۡ مِّنۡ عَمَلِهِمۡ مِّنۡ شَىۡءٍ\u0026zwnj;ؕ كُلُّ امۡرِیءٍۢ بِمَا كَسَبَ رَهِيۡنٌ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "194410052021.mp3"
    },
    {
      "number": 22,
      "text": "\u0026nbsp;وَاَمۡدَدۡنٰهُمۡ بِفَاكِهَةٍ وَّلَحۡمٍ مِّمَّا يَشۡتَهُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "194551052022.mp3"
    },
    {
      "number": 23,
      "text": "يَـتَـنَازَعُوۡنَ فِيۡهَا كَاۡسًا لَّا لَغۡوٌ فِيۡهَا وَلَا تَاۡثِيۡمٌ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "194723052023.mp3"
    },
    {
      "number": 24,
      "text": "وَيَطُوۡفُ عَلَيۡهِمۡ غِلۡمَانٌ لَّهُمۡ كَاَنَّهُمۡ لُـؤۡلُـؤٌ مَّكۡنُوۡنٌ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "194816052024.mp3"
    },
    {
      "number": 25,
      "text": "وَاَقۡبَلَ بَعۡضُهُمۡ عَلٰى بَعۡضٍ يَّتَسَآءَلُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "194913052025.mp3"
    },
    {
      "number": 26,
      "text": "قَالُـوۡۤا اِنَّا كُـنَّا قَبۡلُ فِىۡۤ اَهۡلِنَا مُشۡفِقِيۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195057052026.mp3"
    },
    {
      "number": 27,
      "text": "فَمَنَّ اللّٰهُ عَلَيۡنَا وَوَقٰٮنَا عَذَابَ السَّمُوۡمِ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195155052027.mp3"
    },
    {
      "number": 28,
      "text": "\u0026nbsp;اِنَّا كُـنَّا مِنۡ قَبۡلُ نَدۡعُوۡهُ\u0026zwnj; ؕ اِنَّهٗ هُوَ الۡبَـرُّ الرَّحِيۡمُ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195255052028.mp3"
    }
  ]
}