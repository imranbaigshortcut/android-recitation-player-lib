  "maps": {},
  "suraStart": false,
  "suraNo": 78,
  "ayatStart": 31,
  "ayatEnd": 40,
  "pageNo": 521,
  "ayatList": [
    {
      "number": 31,
      "text": "\u0026nbsp;\u0026nbsp;اِنَّ لِلۡمُتَّقِيۡنَ مَفَازًا ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193142078031.mp3"
    },
    {
      "number": 32,
      "text": "\u0026nbsp;\u0026nbsp;حَدَآٮِٕقَ وَاَعۡنَابًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193756078032.mp3"
    },
    {
      "number": 33,
      "text": "\u0026nbsp;\u0026nbsp;وَّكَوَاعِبَ اَتۡرَابًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193832078033.mp3"
    },
    {
      "number": 34,
      "text": "\u0026nbsp;\u0026nbsp;وَّكَاۡسًا دِهَاقًا ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193922078034.mp3"
    },
    {
      "number": 35,
      "text": "\u0026nbsp;\u0026nbsp;لَا يَسۡمَعُوۡنَ فِيۡهَا لَـغۡوًا وَّلَا كِذّٰبًا\u0026zwnj; ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194006078035.mp3"
    },
    {
      "number": 36,
      "text": "\u0026nbsp;\u0026nbsp;جَزَآءً مِّنۡ رَّبِّكَ عَطَآءً حِسَابًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194048078036.mp3"
    },
    {
      "number": 37,
      "text": "\u0026nbsp;\u0026nbsp;رَّبِّ السَّمٰوٰتِ وَالۡاَرۡضِ وَمَا بَيۡنَهُمَا الرَّحۡمٰنِ\u0026zwnj; لَا يَمۡلِكُوۡنَ مِنۡهُ خِطَابًا\u0026zwnj; ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194135078037.mp3"
    },
    {
      "number": 38,
      "text": "\u0026nbsp;\u0026nbsp;يَوۡمَ يَقُوۡمُ الرُّوۡحُ وَالۡمَلٰٓٮِٕكَةُ صَفًّا\u0026nbsp;\u0026nbsp;\u0026nbsp;ؕۙ لَّا يَتَكَلَّمُوۡنَ اِلَّا مَنۡ اَذِنَ لَهُ الرَّحۡمٰنُ وَقَالَ صَوَابًا\u0026zwnj;\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194226078038.mp3"
    },
    {
      "number": 39,
      "text": "\u0026nbsp;\u0026nbsp;ذٰلِكَ الۡيَوۡمُ الۡحَـقُّ\u0026zwnj;\u0026nbsp;ۚ فَمَنۡ شَآءَ اتَّخَذَ اِلٰى رَبِّهٖ مَاٰبًا\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194324078039.mp3"
    },
    {
      "number": 40,
      "text": "\u0026nbsp;\u0026nbsp;اِنَّاۤ اَنۡذَرۡنٰـكُمۡ عَذَابًا قَرِيۡبًا\u0026ensp;ۖۚ\u0026ensp; يَّوۡمَ يَنۡظُرُ الۡمَرۡءُ مَا قَدَّمَتۡ يَدٰهُ وَيَقُوۡلُ الۡـكٰفِرُ يٰلَيۡتَنِىۡ كُنۡتُ تُرٰبًا\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194400078040.mp3"
    }
  ]
}