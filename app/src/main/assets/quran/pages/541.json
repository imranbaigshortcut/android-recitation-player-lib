      "number": 1,
      "text": "اِنَّاۤ اَنۡزَلۡنٰهُ فِىۡ لَيۡلَةِ الۡقَدۡرِ\u0026ensp;ۖ ۚ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "170215097001.mp3"
    },
    {
      "number": 2,
      "text": "وَمَاۤ اَدۡرٰٮكَ مَا لَيۡلَةُ الۡقَدۡرِؕ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "170248097002.mp3"
    },
    {
      "number": 3,
      "text": "لَيۡلَةُ الۡقَدۡرِ \u0026ensp;ۙ خَيۡرٌ مِّنۡ اَلۡفِ شَهۡرٍؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "170329097003.mp3"
    },
    {
      "number": 4,
      "text": "تَنَزَّلُ الۡمَلٰٓٮِٕكَةُ وَالرُّوۡحُ فِيۡهَا بِاِذۡنِ رَبِّهِمۡ\u0026zwnj;ۚ مِّنۡ كُلِّ اَمۡرٍ\u0026ensp;ۛۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "170444097004.mp3"
    },
    {
      "number": 5,
      "text": "\u0026nbsp;سَلٰمٌ\u0026ensp; \u0026ensp;ۛهِىَ حَتّٰى مَطۡلَعِ الۡفَجۡرِ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
