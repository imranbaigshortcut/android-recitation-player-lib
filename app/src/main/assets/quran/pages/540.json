{
  "maps": {},
  "suraStart": true,
  "suraNo": 96,
  "ayatStart": 1,
  "ayatEnd": 19,
  "pageNo": 540,
  "ayatList": [
    {
      "number": 1,
      "text": "اِقۡرَاۡ بِاسۡمِ رَبِّكَ الَّذِىۡ خَلَقَ\u0026zwnj;ۚ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "185227096001.mp3"
    },
    {
      "number": 2,
      "text": "خَلَقَ الۡاِنۡسَانَ مِنۡ عَلَقٍ\u0026zwnj;ۚ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "185833096002.mp3"
    },
    {
      "number": 3,
      "text": "اِقۡرَاۡ وَرَبُّكَ الۡاَكۡرَمُۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "190906096003.mp3"
    },
    {
      "number": 4,
      "text": "\u0026nbsp;\u0026nbsp;الَّذِىۡ عَلَّمَ بِالۡقَلَمِۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "191204096004.mp3"
    },
    {
      "number": 5,
      "text": "عَلَّمَ الۡاِنۡسَانَ مَا لَمۡ يَعۡلَمۡؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "191506096005.mp3"
    },
    {
      "number": 6,
      "text": "كَلَّاۤ اِنَّ الۡاِنۡسَانَ لَيَطۡغٰٓىۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "191653096006.mp3"
    },
    {
      "number": 7,
      "text": "اَنۡ رَّاٰهُ اسۡتَغۡنٰىؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "191900096007.mp3"
    },
    {
      "number": 8,
      "text": "اِنَّ اِلٰى رَبِّكَ الرُّجۡعٰىؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192045096008.mp3"
    },
    {
      "number": 9,
      "text": "اَرَءَيۡتَ الَّذِىۡ يَنۡهٰىؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192428096009.mp3"
    },
    {
      "number": 10,
      "text": "عَبۡدًا اِذَا صَلّٰىؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192727096010.mp3"
    },
    {
      "number": 11,
      "text": "اَرَءَيۡتَ اِنۡ كَانَ عَلَى الۡهُدٰٓىۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193353096011.mp3"
    },
    {
      "number": 12,
      "text": "اَوۡ اَمَرَ بِالتَّقۡوٰىۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193520096012.mp3"
    },
    {
      "number": 13,
      "text": "اَرَءَيۡتَ اِنۡ كَذَّبَ وَتَوَلّٰىؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193652096013.mp3"
    },
    {
      "number": 14,
      "text": "\u0026nbsp;اَلَمۡ يَعۡلَمۡ بِاَنَّ اللّٰهَ يَرٰىؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193839096014.mp3"
    },
    {
      "number": 15,
      "text": "\u0026nbsp;كَلَّا لَٮِٕنۡ لَّمۡ يَنۡتَهِ\u0026emsp; ۙ لَنَسۡفَعًۢا بِالنَّاصِيَةِۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194128096015.mp3"
    },
    {
      "number": 16,
      "text": "نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍ\u0026zwnj; ۚ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194324096016.mp3"
    },
    {
      "number": 17,
      "text": "فَلۡيَدۡعُ نَادِيَهٗ ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194516096017.mp3"
    },
    {
      "number": 18,
      "text": "سَنَدۡعُ الزَّبَانِيَةَ ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "194847096018.mp3"
    },
    {
      "number": 19,
      "text": "كَلَّا\u0026nbsp;ؕ لَا تُطِعۡهُ وَاسۡجُدۡ وَاقۡتَرِبْ۩\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "195038096019.mp3"
    }
  ]
}