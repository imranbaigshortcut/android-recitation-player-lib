{
  "maps": {},
  "suraStart": false,
  "suraNo": 74,
  "ayatStart": 32,
  "ayatEnd": 56,
  "pageNo": 513,
  "ayatList": [
    {
      "number": 32,
      "text": "كَلَّا وَالۡقَمَرِۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091946074032.mp3"
    },
    {
      "number": 33,
      "text": "وَالَّيۡلِ اِذۡ اَدۡبَرَۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092113074033.mp3"
    },
    {
      "number": 34,
      "text": "\u0026nbsp;وَالصُّبۡحِ اِذَاۤ اَسۡفَرَۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092202074034.mp3"
    },
    {
      "number": 35,
      "text": "اِنَّهَا لَاِحۡدَى الۡكُبَرِۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092240074035.mp3"
    },
    {
      "number": 36,
      "text": "نَذِيۡرًا لِّلۡبَشَرِۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092312074036.mp3"
    },
    {
      "number": 37,
      "text": "لِمَنۡ شَآءَ مِنۡكُمۡ اَنۡ يَّتَقَدَّمَ اَوۡ يَتَاَخَّرَؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092352074037.mp3"
    },
    {
      "number": 38,
      "text": "\u0026nbsp;كُلُّ نَفۡسٍ ۢ بِمَا كَسَبَتۡ رَهِيۡنَةٌ ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092433074038.mp3"
    },
    {
      "number": 39,
      "text": "اِلَّاۤ اَصۡحٰبَ الۡيَمِيۡنِۛ ؕ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092508074039.mp3"
    },
    {
      "number": 40,
      "text": "\u0026nbsp;فِىۡ جَنّٰتٍ ۛ يَتَسَآءَلُوۡنَۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092548074040.mp3"
    },
    {
      "number": 41,
      "text": "عَنِ الۡمُجۡرِمِيۡنَۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092620074041.mp3"
    },
    {
      "number": 42,
      "text": "مَا سَلَـكَكُمۡ فِىۡ سَقَرَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092657074042.mp3"
    },
    {
      "number": 43,
      "text": "قَالُوۡا لَمۡ نَكُ مِنَ الۡمُصَلِّيۡنَۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "092757074043.mp3"
    },
    {
      "number": 44,
      "text": "وَلَمۡ نَكُ نُطۡعِمُ الۡمِسۡكِيۡنَۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "093041074044.mp3"
    },
    {
      "number": 45,
      "text": "وَكُنَّا نَخُوۡضُ مَعَ الۡخَـآٮِٕضِيۡنَۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "090129074045.mp3"
    },
    {
      "number": 46,
      "text": "\u0026nbsp;وَ كُنَّا نُكَذِّبُ بِيَوۡمِ الدِّيۡنِۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "085751074046.mp3"
    },
    {
      "number": 47,
      "text": "حَتّٰٓى اَتٰٮنَا الۡيَقِيۡنُؕ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "093219074047.mp3"
    },
    {
      "number": 48,
      "text": "فَمَا تَنۡفَعُهُمۡ شَفَاعَةُ الشّٰفِعِيۡنَؕ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "093255074048.mp3"
    },
    {
      "number": 49,
      "text": "فَمَا لَهُمۡ عَنِ التَّذۡكِرَةِ مُعۡرِضِيۡنَۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "093340074049.mp3"
    },
    {
      "number": 50,
      "text": "كَاَنَّهُمۡ حُمُرٌ مُّسۡتَنۡفِرَةٌ\u0026ensp;ۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "093413074050.mp3"
    },
    {
      "number": 51,
      "text": "فَرَّتۡ مِنۡ قَسۡوَرَةٍ ؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "093446074051.mp3"
    },
    {
      "number": 52,
      "text": "بَلۡ يُرِيۡدُ كُلُّ امۡرِىٴٍ مِّنۡهُمۡ اَنۡ يُّؤۡتٰى صُحُفًا مُّنَشَّرَةً\u0026ensp;ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "093521074052.mp3"
    },
    {
      "number": 53,
      "text": "كَلَّا \u0026zwnj;ؕ بَلۡ لَّا يَخَافُوۡنَ الۡاٰخِرَةَ ؕ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "093606074053.mp3"
    },
    {
      "number": 54,
      "text": "\u0026nbsp;كَلَّاۤ اِنَّهٗ تَذۡكِرَةٌ\u0026zwnj; ۚ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "093641074054.mp3"
    },
    {
      "number": 55,
      "text": "فَمَنۡ شَآءَ ذَكَرَهٗ ؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "093713074055.mp3"
    },
    {
      "number": 56,
      "text": "وَمَا يَذۡكُرُوۡنَ اِلَّاۤ اَنۡ يَّشَآءَ اللّٰهُ\u0026zwnj; ؕ هُوَ اَهۡلُ التَّقۡوٰى وَاَهۡلُ الۡمَغۡفِرَةِ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "093746074056.mp3"
    }
  ]
}