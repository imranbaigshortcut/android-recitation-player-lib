{
  "maps": {},
  "suraStart": false,
  "suraNo": 69,
  "ayatStart": 38,
  "ayatEnd": 52,
  "pageNo": 503,
  "ayatList": [
    {
      "number": 38,
      "text": "فَلَاۤ اُقۡسِمُ بِمَا تُبۡصِرُوۡنَۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "210120069038.mp3"
    },
    {
      "number": 39,
      "text": "وَمَا لَا تُبۡصِرُوۡنَۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "210219069039.mp3"
    },
    {
      "number": 40,
      "text": "اِنَّهٗ لَقَوۡلُ رَسُوۡلٍ كَرِيۡمٍۚ ۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "210306069040.mp3"
    },
    {
      "number": 41,
      "text": "وَّمَا هُوَ بِقَوۡلِ شَاعِرٍ\u0026zwnj;ؕ قَلِيۡلًا مَّا تُؤۡمِنُوۡنَۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "210407069041.mp3"
    },
    {
      "number": 42,
      "text": "وَلَا بِقَوۡلِ كَاهِنٍ\u0026zwnj;ؕ قَلِيۡلًا مَّا تَذَكَّرُوۡنَؕ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "210456069042.mp3"
    },
    {
      "number": 43,
      "text": "تَنۡزِيۡلٌ مِّنۡ رَّبِّ الۡعٰلَمِيۡنَ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "210548069043.mp3"
    },
    {
      "number": 44,
      "text": "وَلَوۡ تَقَوَّلَ عَلَيۡنَا بَعۡضَ الۡاَقَاوِيۡلِۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "210641069044.mp3"
    },
    {
      "number": 45,
      "text": "لَاَخَذۡنَا مِنۡهُ بِالۡيَمِيۡنِۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "210729069045.mp3"
    },
    {
      "number": 46,
      "text": "ثُمَّ لَقَطَعۡنَا مِنۡهُ الۡوَتِيۡنَ \u0026emsp;ۖ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "210822069046.mp3"
    },
    {
      "number": 47,
      "text": "فَمَا مِنۡكُمۡ مِّنۡ اَحَدٍ عَنۡهُ حَاجِزِيۡنَ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "210935069047.mp3"
    },
    {
      "number": 48,
      "text": "وَاِنَّهٗ لَتَذۡكِرَةٌ لِّلۡمُتَّقِيۡنَ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "211035069048.mp3"
    },
    {
      "number": 49,
      "text": "وَاِنَّا لَنَعۡلَمُ اَنَّ مِنۡكُمۡ مُّكَذِّبِيۡنَ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "211130069049.mp3"
    },
    {
      "number": 50,
      "text": "وَاِنَّهٗ لَحَسۡرَةٌ عَلَى الۡكٰفِرِيۡنَ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "211222069050.mp3"
    },
    {
      "number": 51,
      "text": "وَاِنَّهٗ لَحَـقُّ الۡيَقِيۡنِ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "211316069051.mp3"
    },
    {
      "number": 52,
      "text": "فَسَبِّحۡ بِاسۡمِ رَبِّكَ الۡعَظِيۡمِ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "211425069052.mp3"
    }
  ]
}