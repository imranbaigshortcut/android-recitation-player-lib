{
  "maps": {},
  "suraStart": true,
  "suraNo": 85,
  "ayatStart": 1,
  "ayatEnd": 22,
  "pageNo": 529,
  "ayatList": [
    {
      "number": 1,
      "text": "وَالسَّمَآءِ ذَاتِ الۡبُرُوۡجِۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "072650085001.mp3"
    },
    {
      "number": 2,
      "text": "\u0026nbsp;وَالۡيَوۡمِ الۡمَوۡعُوۡدِۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "072730085002.mp3"
    },
    {
      "number": 3,
      "text": "وَشَاهِدٍ وَّمَشۡهُوۡدٍؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "072814085003.mp3"
    },
    {
      "number": 4,
      "text": "قُتِلَ اَصۡحٰبُ الۡاُخۡدُوۡدِۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "072848085004.mp3"
    },
    {
      "number": 5,
      "text": "\u0026nbsp;النَّارِ ذَاتِ الۡوَقُوۡدِۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "072930085005.mp3"
    },
    {
      "number": 6,
      "text": "\u0026nbsp;اِذۡ هُمۡ عَلَيۡهَا قُعُوۡدٌ ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "073002085006.mp3"
    },
    {
      "number": 7,
      "text": "\u0026nbsp;وَّهُمۡ عَلٰى مَا يَفۡعَلُوۡنَ بِالۡمُؤۡمِنِيۡنَ شُهُوۡدٌ ؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "073046085007.mp3"
    },
    {
      "number": 8,
      "text": "وَمَا نَقَمُوۡا مِنۡهُمۡ اِلَّاۤ اَنۡ يُّؤۡمِنُوۡا بِاللّٰهِ الۡعَزِيۡزِ الۡحَمِيۡدِۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "073119085008.mp3"
    },
    {
      "number": 9,
      "text": "\u0026nbsp;الَّذِىۡ لَهٗ مُلۡكُ السَّمٰوٰتِ وَالۡاَرۡضِ\u0026zwnj;ؕ وَ اللّٰهُ عَلٰى كُلِّ شَىۡءٍ شَهِيۡدٌ\u0026ensp;ؕ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "073200085009.mp3"
    },
    {
      "number": 10,
      "text": "\u0026nbsp;اِنَّ الَّذِيۡنَ فَتَـنُوا الۡمُؤۡمِنِيۡنَ وَ الۡمُؤۡمِنٰتِ ثُمَّ لَمۡ يَتُوۡبُوۡا فَلَهُمۡ عَذَابُ جَهَنَّمَ وَلَهُمۡ عَذَابُ الۡحَرِيۡقِؕ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "073231085010.mp3"
    },
    {
      "number": 11,
      "text": "\u0026nbsp;اِنَّ الَّذِيۡنَ اٰمَنُوۡا وَعَمِلُوا الصّٰلِحٰتِ لَهُمۡ جَنّٰتٌ تَجۡرِىۡ مِنۡ تَحۡتِهَا الۡاَنۡهٰرُ ؕؔ ذٰلِكَ الۡفَوۡزُ الۡكَبِيۡرُؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "073305085011.mp3"
    },
    {
      "number": 12,
      "text": "\u0026nbsp;اِنَّ بَطۡشَ رَبِّكَ لَشَدِيۡدٌ\u0026ensp;ؕ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "073340085012.mp3"
    },
    {
      "number": 13,
      "text": "اِنَّهٗ هُوَ يُبۡدِئُ وَيُعِيۡدُ\u0026zwnj; ۚ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "073410085013.mp3"
    },
    {
      "number": 14,
      "text": "\u0026nbsp;وَهُوَ الۡغَفُوۡرُ الۡوَدُوۡدُۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "073455085014.mp3"
    },
    {
      "number": 15,
      "text": "\u0026nbsp;ذُو الۡعَرۡشِ الۡمَجِيۡدُ ۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "073526085015.mp3"
    },
    {
      "number": 16,
      "text": "\u0026nbsp;فَعَّالٌ لِّمَا يُرِيۡدُ ؕ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "073639085016.mp3"
    },
    {
      "number": 17,
      "text": "هَلۡ اَتٰٮكَ حَدِيۡثُ الۡجُـنُوۡدِۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "073713085017.mp3"
    },
    {
      "number": 18,
      "text": "\u0026nbsp;فِرۡعَوۡنَ وَثَمُوۡدَؕ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "073751085018.mp3"
    },
    {
      "number": 19,
      "text": "بَلِ الَّذِيۡنَ كَفَرُوۡا فِىۡ تَكۡذِيۡبٍۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "073844085019.mp3"
    },
    {
      "number": 20,
      "text": "\u0026nbsp;وَّاللّٰهُ مِنۡ وَّرَآٮِٕهِمۡ مُّحِيۡطٌۚ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "073923085020.mp3"
    },
    {
      "number": 21,
      "text": "بَلۡ هُوَ قُرۡاٰنٌ مَّجِيۡدٌ ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "073957085021.mp3"
    },
    {
      "number": 22,
      "text": "\u0026nbsp;فِىۡ لَوۡحٍ مَّحۡفُوۡظٍ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "074028085022.mp3"
    }
  ]
}