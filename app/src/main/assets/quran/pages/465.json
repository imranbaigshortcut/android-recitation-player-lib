{
  "maps": {},
  "suraStart": true,
  "suraNo": 54,
  "ayatStart": 1,
  "ayatEnd": 22,
  "pageNo": 465,
  "ayatList": [
    {
      "number": 1,
      "text": "اِقۡتَـرَبَتِ السَّاعَةُ وَانْشَقَّ الۡقَمَرُ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "095049054001.mp3"
    },
    {
      "number": 2,
      "text": "وَاِنۡ يَّرَوۡا اٰيَةً يُّعۡرِضُوۡا وَيَقُوۡلُوۡا سِحۡرٌ مُّسۡتَمِرٌّ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "095128054002.mp3"
    },
    {
      "number": 3,
      "text": "وَكَذَّبُوۡا وَاتَّبَعُوۡۤا اَهۡوَآءَهُمۡ\u0026zwnj; وَكُلُّ اَمۡرٍ مُّسۡتَقِرٌّ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "095203054003.mp3"
    },
    {
      "number": 4,
      "text": "وَلَقَدۡ جَآءَهُمۡ مِّنَ الۡاَنۡۢبَآءِ مَا فِيۡهِ مُزۡدَجَرٌۙ\u0026rlm;",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "095243054004.mp3"
    },
    {
      "number": 5,
      "text": "حِكۡمَةٌ\u0026nbsp;\u0026nbsp;ۢ بَالِغَةٌ\u0026zwnj; فَمَا تُغۡنِ النُّذُرُۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "095335054005.mp3"
    },
    {
      "number": 6,
      "text": "فَتَوَلَّ عَنۡهُمۡ\u0026zwnj;ۘ يَوۡمَ يَدۡعُ الدَّاعِ اِلٰى شَىۡءٍ نُّكُرٍۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "095417054006.mp3"
    },
    {
      "number": 7,
      "text": "خُشَّعًا اَبۡصَارُهُمۡ يَخۡرُجُوۡنَ مِنَ الۡاَجۡدَاثِ كَاَنَّهُمۡ جَرَادٌ مُّنۡتَشِرٌۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "095501054007.mp3"
    },
    {
      "number": 8,
      "text": "مُّهۡطِعِيۡنَ اِلَى الدَّاعِ\u0026zwnj;ؕ يَقُوۡلُ الۡكٰفِرُوۡنَ هٰذَا يَوۡمٌ عَسِرٌ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "095550054008.mp3"
    },
    {
      "number": 9,
      "text": "كَذَّبَتۡ قَبۡلَهُمۡ قَوۡمُ نُوۡحٍ فَكَذَّبُوۡا عَبۡدَنَا وَقَالُوۡا مَجۡنُوۡنٌ وَّازۡدُجِرَ\u0026rlm;",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "095630054009.mp3"
    },
    {
      "number": 10,
      "text": "فَدَعَا رَبَّهٗۤ اَنِّىۡ مَغۡلُوۡبٌ فَانْـتَصِرۡ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "095718054010.mp3"
    },
    {
      "number": 11,
      "text": "فَفَتَحۡنَاۤ اَبۡوَابَ السَّمَآءِ بِمَآءٍ مُّنۡهَمِرٍ\u0026ensp;ۖ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "095807054011.mp3"
    },
    {
      "number": 12,
      "text": "وَّفَجَّرۡنَا الۡاَرۡضَ عُيُوۡنًا فَالۡتَقَى الۡمَآءُ عَلٰٓى اَمۡرٍ قَدۡ قُدِرَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "095900054012.mp3"
    },
    {
      "number": 13,
      "text": "وَحَمَلۡنٰهُ عَلٰى ذَاتِ اَلۡوَاحٍ وَّدُسُرٍۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "095943054013.mp3"
    },
    {
      "number": 14,
      "text": "تَجۡرِىۡ بِاَعۡيُنِنَا\u0026zwnj;ۚ جَزَآءً لِّمَنۡ كَانَ كُفِرَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "100033054014.mp3"
    },
    {
      "number": 15,
      "text": "وَلَقَدْ تَّرَكۡنٰهَاۤ اٰيَةً فَهَلۡ مِنۡ مُّدَّكِرٍ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "100115054015.mp3"
    },
    {
      "number": 16,
      "text": "فَكَيۡفَ كَانَ عَذَابِىۡ وَنُذُرِ\u0026rlm;",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "100223054016.mp3"
    },
    {
      "number": 17,
      "text": "وَلَقَدۡ يَسَّرۡنَا الۡقُرۡاٰنَ لِلذِّكۡرِ فَهَلۡ مِنۡ مُّدَّكِرٍ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "100359054017.mp3"
    },
    {
      "number": 18,
      "text": "كَذَّبَتۡ عَادٌ فَكَيۡفَ كَانَ عَذَابِىۡ وَنُذُرِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "100535054018.mp3"
    },
    {
      "number": 19,
      "text": "اِنَّاۤ اَرۡسَلۡنَا عَلَيۡهِمۡ رِيۡحًا صَرۡصَرًا فِىۡ يَوۡمِ نَحۡسٍ مُّسۡتَمِرٍّۙ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "100704054019.mp3"
    },
    {
      "number": 20,
      "text": "تَنۡزِعُ النَّاسَۙ كَاَنَّهُمۡ اَعۡجَازُ نَخۡلٍ مُّنۡقَعِرٍ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "100810054020.mp3"
    },
    {
      "number": 21,
      "text": "فَكَيۡفَ كَانَ عَذَابِىۡ وَنُذُرِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "100904054021.mp3"
    },
    {
      "number": 22,
      "text": "وَلَقَدۡ يَسَّرۡنَا الۡقُرۡاٰنَ لِلذِّكۡرِ فَهَلۡ مِنۡ مُّدَّكِرٍ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "101000054022.mp3"
    }
  ]
}