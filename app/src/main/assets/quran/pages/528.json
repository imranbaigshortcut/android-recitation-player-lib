{
  "maps": {},
  "suraStart": true,
  "suraNo": 84,
  "ayatStart": 1,
  "ayatEnd": 25,
  "pageNo": 528,
  "ayatList": [
    {
      "number": 1,
      "text": "اِذَا السَّمَآءُ انْشَقَّتۡۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "075518084001.mp3"
    },
    {
      "number": 2,
      "text": "وَاَذِنَتۡ لِرَبِّهَا وَحُقَّتۡۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "075551084002.mp3"
    },
    {
      "number": 3,
      "text": "وَاِذَا الۡاَرۡضُ مُدَّتۡؕ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "081223084003.mp3"
    },
    {
      "number": 4,
      "text": "وَاَلۡقَتۡ مَا فِيۡهَا وَتَخَلَّتۡۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "075654084004.mp3"
    },
    {
      "number": 5,
      "text": "\u0026nbsp;وَاَذِنَتۡ لِرَبِّهَا وَحُقَّتۡؕ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "075722084005.mp3"
    },
    {
      "number": 6,
      "text": "يٰۤاَيُّهَا الۡاِنۡسَانُ اِنَّكَ كَادِحٌ اِلٰى رَبِّكَ كَدۡحًا فَمُلٰقِيۡهِ\u0026zwnj;ۚ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "075803084006.mp3"
    },
    {
      "number": 7,
      "text": "\u0026nbsp;فَاَمَّا مَنۡ اُوۡتِىَ كِتٰبَهٗ بِيَمِيۡنِهٖۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "075845084007.mp3"
    },
    {
      "number": 8,
      "text": "فَسَوۡفَ يُحَاسَبُ حِسَابًا يَّسِيۡرًا ۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "075916084008.mp3"
    },
    {
      "number": 9,
      "text": "وَّيَنۡقَلِبُ اِلٰٓى اَهۡلِهٖ مَسۡرُوۡرًا ؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "075952084009.mp3"
    },
    {
      "number": 10,
      "text": "وَاَمَّا مَنۡ اُوۡتِىَ كِتٰبَهٗ وَرَآءَ ظَهۡرِهٖۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "080050084010.mp3"
    },
    {
      "number": 11,
      "text": "فَسَوۡفَ يَدۡعُوۡا ثُبُوۡرًا ۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "080119084011.mp3"
    },
    {
      "number": 12,
      "text": "وَّيَصۡلٰى سَعِيۡرًا ؕ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "080154084012.mp3"
    },
    {
      "number": 13,
      "text": "اِنَّهٗ كَانَ فِىۡۤ اَهۡلِهٖ مَسۡرُوۡرًا ؕ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "080243084013.mp3"
    },
    {
      "number": 14,
      "text": "\u0026nbsp;\u0026nbsp;اِنَّهٗ ظَنَّ اَنۡ لَّنۡ يَّحُوۡرَ\u0026ensp;ۛۚ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "080313084014.mp3"
    },
    {
      "number": 15,
      "text": "بَلٰٓى ۛۚ اِنَّ رَبَّهٗ كَانَ بِهٖ بَصِيۡرًا\u0026ensp;ؕ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "080345084015.mp3"
    },
    {
      "number": 16,
      "text": "فَلَاۤ اُقۡسِمُ بِالشَّفَقِۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "080430084016.mp3"
    },
    {
      "number": 17,
      "text": "وَالَّيۡلِ وَمَا وَسَقَۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "080503084017.mp3"
    },
    {
      "number": 18,
      "text": "وَالۡقَمَرِ اِذَا اتَّسَقَۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "080540084018.mp3"
    },
    {
      "number": 19,
      "text": "\u0026nbsp;لَتَرۡكَبُنَّ طَبَقًا عَنۡ طَبَقٍؕ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "080617084019.mp3"
    },
    {
      "number": 20,
      "text": "\u0026nbsp;فَمَا لَهُمۡ لَا يُؤۡمِنُوۡنَۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "080651084020.mp3"
    },
    {
      "number": 21,
      "text": "\u0026nbsp;وَاِذَا قُرِئَ عَلَيۡهِمُ الۡقُرۡاٰنُ لَا يَسۡجُدُوۡنَ ؕ ۩",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "080734084021.mp3"
    },
    {
      "number": 22,
      "text": "بَلِ الَّذِيۡنَ كَفَرُوۡا يُكَذِّبُوۡنَ\u0026emsp;ۖ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "080809084022.mp3"
    },
    {
      "number": 23,
      "text": "\u0026nbsp;وَاللّٰهُ اَعۡلَمُ بِمَا يُوۡعُوۡنَ\u0026emsp;ۖ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "080837084023.mp3"
    },
    {
      "number": 24,
      "text": "فَبَشِّرۡهُمۡ بِعَذَابٍ اَلِيۡمٍۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "080943084024.mp3"
    },
    {
      "number": 25,
      "text": "اِلَّا الَّذِيۡنَ اٰمَنُوۡا وَعَمِلُوا الصّٰلِحٰتِ لَهُمۡ اَجۡرٌ غَيۡرُ مَمۡنُوۡنٍ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "081108084025.mp3"
    }
  ]
}