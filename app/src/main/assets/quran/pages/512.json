{
  "maps": {},
  "suraStart": true,
  "suraNo": 74,
  "ayatStart": 1,
  "ayatEnd": 31,
  "pageNo": 512,
  "ayatList": [
    {
      "number": 1,
      "text": "يٰۤاَيُّهَا الۡمُدَّثِّرُۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "160936074001.mp3"
    },
    {
      "number": 2,
      "text": "قُمۡ فَاَنۡذِرۡۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "161047074002.mp3"
    },
    {
      "number": 3,
      "text": "وَرَبَّكَ فَكَبِّرۡۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "161136074003.mp3"
    },
    {
      "number": 4,
      "text": "وَثِيَابَكَ فَطَهِّرۡۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "161257074004.mp3"
    },
    {
      "number": 5,
      "text": "وَالرُّجۡزَ فَاهۡجُرۡۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "165549074005.mp3"
    },
    {
      "number": 6,
      "text": "وَلَا تَمۡنُنۡ تَسۡتَكۡثِرُۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "165628074006.mp3"
    },
    {
      "number": 7,
      "text": "وَ لِرَبِّكَ فَاصۡبِرۡؕ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "165718074007.mp3"
    },
    {
      "number": 8,
      "text": "فَاِذَا نُقِرَ فِى النَّاقُوۡرِۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "165755074008.mp3"
    },
    {
      "number": 9,
      "text": "فَذٰلِكَ يَوۡمَٮِٕذٍ يَّوۡمٌ عَسِيۡرٌۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "165837074009.mp3"
    },
    {
      "number": 10,
      "text": "عَلَى الۡكٰفِرِيۡنَ غَيۡرُ يَسِيۡرٍ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "165913074010.mp3"
    },
    {
      "number": 11,
      "text": "ذَرۡنِىۡ وَمَنۡ خَلَقۡتُ وَحِيۡدًا ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "170013074011.mp3"
    },
    {
      "number": 12,
      "text": "وَّجَعَلۡتُ لَهٗ مَالًا مَّمۡدُوۡدًا ۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "170051074012.mp3"
    },
    {
      "number": 13,
      "text": "وَّبَنِيۡنَ شُهُوۡدًا ۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "170126074013.mp3"
    },
    {
      "number": 14,
      "text": "\u0026nbsp;وَّمَهَّدتُّ لَهٗ تَمۡهِيۡدًا ۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "170204074014.mp3"
    },
    {
      "number": 15,
      "text": "ثُمَّ يَطۡمَعُ اَنۡ اَزِيۡدَ \u0026ensp;ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "170243074015.mp3"
    },
    {
      "number": 16,
      "text": "كَلَّا ؕ اِنَّهٗ كَانَ لِاٰيٰتِنَا عَنِيۡدًا ؕ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "090815074016.mp3"
    },
    {
      "number": 17,
      "text": "سَاُرۡهِقُهٗ صَعُوۡدًا ؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "090854074017.mp3"
    },
    {
      "number": 18,
      "text": "اِنَّهٗ فَكَّرَ وَقَدَّرَۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "090931074018.mp3"
    },
    {
      "number": 19,
      "text": "فَقُتِلَ كَيۡفَ قَدَّرَۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091015074019.mp3"
    },
    {
      "number": 20,
      "text": "ثُمَّ قُتِلَ كَيۡفَ قَدَّرَۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091051074020.mp3"
    },
    {
      "number": 21,
      "text": "ثُمَّ نَظَرَۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091129074021.mp3"
    },
    {
      "number": 22,
      "text": "ثُمَّ عَبَسَ وَبَسَرَۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091159074022.mp3"
    },
    {
      "number": 23,
      "text": "ثُمَّ اَدۡبَرَ وَاسۡتَكۡبَرَۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091322074023.mp3"
    },
    {
      "number": 24,
      "text": "\u0026nbsp;فَقَالَ اِنۡ هٰذَاۤ اِلَّا سِحۡرٌ يُّؤۡثَرُۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091357074024.mp3"
    },
    {
      "number": 25,
      "text": "اِنۡ هٰذَاۤ اِلَّا قَوۡلُ الۡبَشَرِؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091430074025.mp3"
    },
    {
      "number": 26,
      "text": "سَاُصۡلِيۡهِ سَقَرَ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091535074026.mp3"
    },
    {
      "number": 27,
      "text": "وَمَاۤ اَدۡرٰٮكَ مَا سَقَرُؕ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091613074027.mp3"
    },
    {
      "number": 28,
      "text": "لَا تُبۡقِىۡ وَ لَا تَذَرُ\u0026zwnj;ۚ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091646074028.mp3"
    },
    {
      "number": 29,
      "text": "لَـوَّاحَةٌ لِّلۡبَشَرِ\u0026zwnj;ۖ\u0026zwnj;ۚ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091722074029.mp3"
    },
    {
      "number": 30,
      "text": "عَلَيۡهَا تِسۡعَةَ عَشَرَؕ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091822074030.mp3"
    },
    {
      "number": 31,
      "text": "وَمَا جَعَلۡنَاۤ اَصۡحٰبَ النَّارِ اِلَّا مَلٰٓٮِٕكَةً\u0026zwnj; وَّمَا جَعَلۡنَا عِدَّتَهُمۡ اِلَّا فِتۡنَةً لِّلَّذِيۡنَ كَفَرُوۡا ۙ لِيَسۡتَيۡقِنَ الَّذِيۡنَ اُوۡتُوا الۡكِتٰبَ وَيَزۡدَادَ الَّذِيۡنَ اٰمَنُوۡۤا اِيۡمَانًا\u0026zwnj; وَّلَا يَرۡتَابَ الَّذِيۡنَ اُوۡتُوا الۡكِتٰبَ وَالۡمُؤۡمِنُوۡنَ\u0026zwnj;ۙ وَلِيَقُوۡلَ الَّذِيۡنَ فِىۡ قُلُوۡبِهِمۡ مَّرَضٌ وَّالۡكٰفِرُوۡنَ مَاذَاۤ اَرَادَ اللّٰهُ بِهٰذَا مَثَلًا \u0026zwnj;ؕ كَذٰلِكَ يُضِلُّ اللّٰهُ مَنۡ يَّشَآءُ وَيَهۡدِىۡ مَنۡ يَّشَآءُ \u0026zwnj;ؕ وَمَا يَعۡلَمُ جُنُوۡدَ رَبِّكَ اِلَّا هُوَ \u0026zwnj;ؕ وَمَا هِىَ اِلَّا ذِكۡرٰى لِلۡبَشَرِ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091902074031.mp3"
    }
  ]
}