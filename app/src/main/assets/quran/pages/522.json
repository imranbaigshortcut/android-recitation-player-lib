{
  "maps": {},
  "suraStart": true,
  "suraNo": 79,
  "ayatStart": 1,
  "ayatEnd": 26,
  "pageNo": 522,
  "ayatList": [
    {
      "number": 1,
      "text": "وَالنّٰزِعٰتِ غَرۡقًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "161502079001.mp3"
    },
    {
      "number": 2,
      "text": "\u0026nbsp;\u0026nbsp;وَّالنّٰشِطٰتِ نَشۡطًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "161728079002.mp3"
    },
    {
      "number": 3,
      "text": "\u0026nbsp;\u0026nbsp;وَّالسّٰبِحٰتِ سَبۡحًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "161801079003.mp3"
    },
    {
      "number": 4,
      "text": "\u0026nbsp;\u0026nbsp;فَالسّٰبِقٰتِ سَبۡقًا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "161833079004.mp3"
    },
    {
      "number": 5,
      "text": "\u0026nbsp;\u0026nbsp;فَالۡمُدَبِّرٰتِ اَمۡرًا\u0026zwnj; ۘ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "161908079005.mp3"
    },
    {
      "number": 6,
      "text": "\u0026nbsp;\u0026nbsp;يَوۡمَ تَرۡجُفُ الرَّاجِفَةُ ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "162034079006.mp3"
    },
    {
      "number": 7,
      "text": "\u0026nbsp;\u0026nbsp;تَتۡبَعُهَا الرَّادِفَةُ ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "162202079007.mp3"
    },
    {
      "number": 8,
      "text": "\u0026nbsp;\u0026nbsp;قُلُوۡبٌ يَّوۡمَٮِٕذٍ وَّاجِفَةٌ ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "162300079008.mp3"
    },
    {
      "number": 9,
      "text": "\u0026nbsp;\u0026nbsp;اَبۡصَارُهَا خَاشِعَةٌ\u0026zwnj;\u0026ensp;ۘ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "162343079009.mp3"
    },
    {
      "number": 10,
      "text": "\u0026nbsp;\u0026nbsp;يَقُوۡلُوۡنَ ءَاِنَّا لَمَرۡدُوۡدُوۡنَ فِى الۡحَـافِرَةِ ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "162421079010.mp3"
    },
    {
      "number": 11,
      "text": "\u0026nbsp;\u0026nbsp;ءَاِذَا كُنَّا عِظَامًا نَّخِرَةً ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "162601079011.mp3"
    },
    {
      "number": 12,
      "text": "\u0026nbsp;\u0026nbsp;قَالُوۡا تِلۡكَ اِذًا كَرَّةٌ خَاسِرَةٌ\u0026zwnj;\u0026ensp;ۘ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "162637079012.mp3"
    },
    {
      "number": 13,
      "text": "\u0026nbsp;\u0026nbsp;فَاِنَّمَا هِىَ زَجۡرَةٌ وَّاحِدَةٌ\u0026ensp;ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "162721079013.mp3"
    },
    {
      "number": 14,
      "text": "\u0026nbsp;\u0026nbsp;فَاِذَا هُمۡ بِالسَّاهِرَةِ ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "162805079014.mp3"
    },
    {
      "number": 15,
      "text": "\u0026nbsp;\u0026nbsp;هَلۡ اَتٰٮكَ حَدِيۡثُ مُوۡسٰى\u0026zwnj;ۘ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "162845079015.mp3"
    },
    {
      "number": 16,
      "text": "\u0026nbsp;\u0026nbsp;اِذۡ نَادٰٮهُ رَبُّهٗ بِالۡوَادِ الۡمُقَدَّسِ طُوًى\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "163028079016.mp3"
    },
    {
      "number": 17,
      "text": "\u0026nbsp;\u0026nbsp;اِذۡهَبۡ اِلٰى فِرۡعَوۡنَ اِنَّهٗ طَغٰى\u0026ensp;ۖ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "163107079017.mp3"
    },
    {
      "number": 18,
      "text": "\u0026nbsp;\u0026nbsp;فَقُلۡ هَلۡ لَّكَ اِلٰٓى اَنۡ تَزَكّٰى ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "163151079018.mp3"
    },
    {
      "number": 19,
      "text": "\u0026nbsp;\u0026nbsp;وَاَهۡدِيَكَ اِلٰى رَبِّكَ فَتَخۡشٰى\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "163239079019.mp3"
    },
    {
      "number": 20,
      "text": "\u0026nbsp;\u0026nbsp;فَاَرٰٮهُ الۡاٰيَةَ الۡكُبۡرٰى\u0026ensp;ۖ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "163320079020.mp3"
    },
    {
      "number": 21,
      "text": "\u0026nbsp;\u0026nbsp;فَكَذَّبَ وَعَصٰى\u0026ensp;ۖ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "163508079021.mp3"
    },
    {
      "number": 22,
      "text": "\u0026nbsp;\u0026nbsp;ثُمَّ اَدۡبَرَ يَسۡعٰىۖ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "163550079022.mp3"
    },
    {
      "number": 23,
      "text": "\u0026nbsp;\u0026nbsp;فَحَشَرَ فَنَادٰىۖ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "163634079023.mp3"
    },
    {
      "number": 24,
      "text": "\u0026nbsp;\u0026nbsp;فَقَالَ اَنَا رَبُّكُمُ الۡاَعۡلٰى\u0026ensp;ۖ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "163723079024.mp3"
    },
    {
      "number": 25,
      "text": "\u0026nbsp;\u0026nbsp;فَاَخَذَهُ اللّٰهُ نَڪَالَ الۡاٰخِرَةِ وَالۡاُوۡلٰى ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "163807079025.mp3"
    },
    {
      "number": 26,
      "text": "اِنَّ فِىۡ ذٰلِكَ لَعِبۡرَةً لِّمَنۡ يَّخۡشٰىؕ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "163951079026.mp3"
    }
  ]
}