  "ayatList": [
    {
      "number": 36,
      "text": "فَمَالِ الَّذِيۡنَ كَفَرُوۡا قِبَلَكَ مُهۡطِعِيۡنَۙ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "114821070036.mp3"
    },
    {
      "number": 37,
      "text": "عَنِ الۡيَمِيۡنِ وَعَنِ الشِّمَالِ عِزِيۡنَ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "114946070037.mp3"
    },
    {
      "number": 38,
      "text": "اَيَطۡمَعُ كُلُّ امۡرِىءٍ مِّنۡهُمۡ اَنۡ يُّدۡخَلَ جَنَّةَ نَعِيۡمٍۙ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "115101070038.mp3"
    },
    {
      "number": 39,
      "text": "كَلَّا ؕ اِنَّا خَلَقۡنٰهُمۡ مِّمَّا يَعۡلَمُوۡنَ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "115206070039.mp3"
    },
    {
      "number": 40,
      "text": "فَلَاۤ اُقۡسِمُ بِرَبِّ الۡمَشٰرِقِ وَالۡمَغٰرِبِ اِنَّا لَقٰدِرُوۡنَۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "115310070040.mp3"
    },
    {
      "number": 41,
      "text": "عَلٰٓى اَنۡ نُّبَدِّلَ خَيۡرًا مِّنۡهُمۡۙ وَمَا نَحۡنُ بِمَسۡبُوۡقِيۡنَ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "115524070041.mp3"
    },
    {
      "number": 42,
      "text": "\u0026nbsp;\u0026nbsp;فَذَرۡهُمۡ يَخُوۡضُوۡا وَيَلۡعَبُوۡا حَتّٰى يُلٰقُوۡا يَوۡمَهُمُ الَّذِىۡ يُوۡعَدُوۡنَۙ\u0026rlm; ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "115635070042.mp3"
    },
    {
      "number": 43,
      "text": "يَوۡمَ يَخۡرُجُوۡنَ مِنَ الۡاَجۡدَاثِ سِرَاعًا كَاَنَّهُمۡ اِلٰى نُصُبٍ يُّوۡفِضُوۡنَۙ",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "115742070043.mp3"
    },
    {
      "number": 44,
      "text": "\u0026nbsp;خَاشِعَةً اَبۡصَارُهُمۡ تَرۡهَقُهُمۡ ذِلَّةٌ\u0026nbsp;\u0026nbsp;\u0026nbsp;ؕ ذٰلِكَ الۡيَوۡمُ الَّذِىۡ كَانُوۡا يُوۡعَدُوۡنَ\u0026rlm;",
      "translationNo": "un",
      "commentary": "",
      "audioTalawat": "115901070044.mp3"
    }
  ]
}