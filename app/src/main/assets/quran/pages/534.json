{
  "maps": {},
  "suraStart": true,
  "suraNo": 90,
  "ayatStart": 1,
  "ayatEnd": 20,
  "pageNo": 534,
  "ayatList": [
    {
      "number": 1,
      "text": "لَاۤ اُقۡسِمُ بِهٰذَا الۡبَلَدِۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "172139090001.mp3"
    },
    {
      "number": 2,
      "text": "\u0026nbsp;\u0026nbsp;وَاَنۡتَ حِلٌّ\u0026nbsp;ۢ بِهٰذَا الۡبَلَدِۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "172245090002.mp3"
    },
    {
      "number": 3,
      "text": "\u0026nbsp;\u0026nbsp;وَوَالِدٍ وَّمَا وَلَدَ ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "172328090003.mp3"
    },
    {
      "number": 4,
      "text": "\u0026nbsp;\u0026nbsp;لَقَدۡ خَلَقۡنَا الۡاِنۡسَانَ فِىۡ كَبَدٍؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "172443090004.mp3"
    },
    {
      "number": 5,
      "text": "\u0026nbsp;\u0026nbsp;اَيَحۡسَبُ اَنۡ لَّنۡ يَّقۡدِرَ عَلَيۡهِ اَحَدٌ\u0026zwnj; ۘ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "172526090005.mp3"
    },
    {
      "number": 6,
      "text": "\u0026nbsp;\u0026nbsp;يَقُوۡلُ اَهۡلَكۡتُ مَالًا لُّبَدًا ؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "172714090006.mp3"
    },
    {
      "number": 7,
      "text": "\u0026nbsp;\u0026nbsp;اَيَحۡسَبُ اَنۡ لَّمۡ يَرَهٗۤ اَحَدٌ ؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "172839090007.mp3"
    },
    {
      "number": 8,
      "text": "\u0026nbsp;\u0026nbsp;اَلَمۡ نَجۡعَلۡ لَّهٗ عَيۡنَيۡنِۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "172943090008.mp3"
    },
    {
      "number": 9,
      "text": "\u0026nbsp;\u0026nbsp;وَلِسَانًا وَّشَفَتَيۡنِۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173127090009.mp3"
    },
    {
      "number": 10,
      "text": "\u0026nbsp;\u0026nbsp;وَهَدَيۡنٰهُ النَّجۡدَيۡنِ\u0026zwnj;ۚ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173239090010.mp3"
    },
    {
      "number": 11,
      "text": "\u0026nbsp;\u0026nbsp;فَلَا اقۡتَحَمَ الۡعَقَبَةَ\u0026emsp;ۖ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173349090011.mp3"
    },
    {
      "number": 12,
      "text": "\u0026nbsp;\u0026nbsp;وَمَاۤ اَدۡرٰٮكَ مَا الۡعَقَبَةُ ؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173459090012.mp3"
    },
    {
      "number": 13,
      "text": "\u0026nbsp;\u0026nbsp;فَكُّ رَقَبَةٍ ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173544090013.mp3"
    },
    {
      "number": 14,
      "text": "\u0026nbsp;\u0026nbsp;اَوۡ اِطۡعٰمٌ فِىۡ يَوۡمٍ ذِىۡ مَسۡغَبَةٍ ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173636090014.mp3"
    },
    {
      "number": 15,
      "text": "\u0026nbsp;\u0026nbsp;يَّتِيۡمًا ذَا مَقۡرَبَةٍ ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173725090015.mp3"
    },
    {
      "number": 16,
      "text": "\u0026nbsp;\u0026nbsp;اَوۡ مِسۡكِيۡنًا ذَا مَتۡرَبَةٍ ؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173817090016.mp3"
    },
    {
      "number": 17,
      "text": "\u0026nbsp;\u0026nbsp;ثُمَّ كَانَ مِنَ الَّذِيۡنَ اٰمَنُوۡا وَتَوَاصَوۡا بِالصَّبۡرِ وَتَوَاصَوۡا بِالۡمَرۡحَمَةِ ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173905090017.mp3"
    },
    {
      "number": 18,
      "text": "\u0026nbsp;\u0026nbsp;اُولٰٓٮِٕكَ اَصۡحٰبُ الۡمَيۡمَنَةِ ؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "173952090018.mp3"
    },
    {
      "number": 19,
      "text": "\u0026nbsp;\u0026nbsp;وَالَّذِيۡنَ كَفَرُوۡا بِاٰيٰتِنَا هُمۡ اَصۡحٰبُ الۡمَشۡـَٔـمَةِ ؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "174038090019.mp3"
    },
    {
      "number": 20,
      "text": "\u0026nbsp;\u0026nbsp;عَلَيۡهِمۡ نَارٌ مُّؤۡصَدَةٌ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "174126090020.mp3"
    }
  ]
}