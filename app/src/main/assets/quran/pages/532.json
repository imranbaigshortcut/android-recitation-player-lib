{
  "maps": {},
  "suraStart": true,
  "suraNo": 88,
  "ayatStart": 1,
  "ayatEnd": 26,
  "pageNo": 532,
  "ayatList": [
    {
      "number": 1,
      "text": "هَلۡ اَتٰٮكَ حَدِيۡثُ الۡغَاشِيَةِؕ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "084434088001.mp3"
    },
    {
      "number": 2,
      "text": "\u0026nbsp;وُجُوۡهٌ يَّوۡمَٮِٕذٍ خَاشِعَةٌ\u0026ensp;ۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "084508088002.mp3"
    },
    {
      "number": 3,
      "text": "عَامِلَةٌ نَّاصِبَةٌ\u0026ensp;ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "084545088003.mp3"
    },
    {
      "number": 4,
      "text": "\u0026nbsp;تَصۡلٰى نَارًا حَامِيَةً\u0026ensp;ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "084620088004.mp3"
    },
    {
      "number": 5,
      "text": "\u0026nbsp;تُسۡقٰى مِنۡ عَيۡنٍ اٰنِيَةٍؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "084657088005.mp3"
    },
    {
      "number": 6,
      "text": "\u0026nbsp;لَـيۡسَ لَهُمۡ طَعَامٌ اِلَّا مِنۡ ضَرِيۡعٍۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "084749088006.mp3"
    },
    {
      "number": 7,
      "text": "\u0026nbsp;لَّا يُسۡمِنُ وَلَا يُغۡنِىۡ مِنۡ جُوۡعٍؕ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "084840088007.mp3"
    },
    {
      "number": 8,
      "text": "\u0026nbsp;وُجُوۡهٌ يَّوۡمَٮِٕذٍ نَّاعِمَةٌ\u0026ensp;ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "084917088008.mp3"
    },
    {
      "number": 9,
      "text": "\u0026nbsp;لِّسَعۡيِهَا رَاضِيَةٌ\u0026ensp;ۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "084952088009.mp3"
    },
    {
      "number": 10,
      "text": "\u0026nbsp;فِىۡ جَنَّةٍ عَالِيَةٍۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "085027088010.mp3"
    },
    {
      "number": 11,
      "text": "لَّا تَسۡمَعُ فِيۡهَا لَاغِيَةً\u0026ensp;ؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "085103088011.mp3"
    },
    {
      "number": 12,
      "text": "فِيۡهَا عَيۡنٌ جَارِيَةٌ\u0026zwnj;\u0026ensp;ۘ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "085137088012.mp3"
    },
    {
      "number": 13,
      "text": "فِيۡهَا سُرُرٌ مَّرۡفُوۡعَةٌ\u0026ensp;ۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "085214088013.mp3"
    },
    {
      "number": 14,
      "text": "وَّاَكۡوَابٌ مَّوۡضُوۡعَةٌ\u0026ensp;ۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "085314088014.mp3"
    },
    {
      "number": 15,
      "text": "\u0026nbsp;وَّنَمَارِقُ مَصۡفُوۡفَةٌ\u0026ensp;ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "085349088015.mp3"
    },
    {
      "number": 16,
      "text": "\u0026nbsp;وَّزَرَابِىُّ مَبۡثُوۡثَةٌ\u0026ensp;ؕ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "085424088016.mp3"
    },
    {
      "number": 17,
      "text": "اَفَلَا يَنۡظُرُوۡنَ اِلَى الۡاِ بِلِ كَيۡفَ خُلِقَتۡ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091037088017.mp3"
    },
    {
      "number": 18,
      "text": "وَاِلَى السَّمَآءِ كَيۡفَ رُفِعَتۡ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091113088018.mp3"
    },
    {
      "number": 19,
      "text": "\u0026nbsp;وَاِلَى الۡجِبَالِ كَيۡفَ نُصِبَتۡ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091146088019.mp3"
    },
    {
      "number": 20,
      "text": "وَاِلَى الۡاَرۡضِ كَيۡفَ سُطِحَتۡ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091219088020.mp3"
    },
    {
      "number": 21,
      "text": "\u0026nbsp;فَذَكِّرۡ ؕ اِنَّمَاۤ اَنۡتَ مُذَكِّرٌ ؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091303088021.mp3"
    },
    {
      "number": 22,
      "text": "\u0026nbsp;لَـسۡتَ عَلَيۡهِمۡ بِمُصَۜيۡطِرٍۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091334088022.mp3"
    },
    {
      "number": 23,
      "text": "اِلَّا مَنۡ تَوَلّٰى وَكَفَرَۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091407088023.mp3"
    },
    {
      "number": 24,
      "text": "\u0026nbsp;فَيُعَذِّبُهُ اللّٰهُ الۡعَذَابَ الۡاَكۡبَرَؕ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091441088024.mp3"
    },
    {
      "number": 25,
      "text": "اِنَّ اِلَيۡنَاۤ اِيَابَهُمۡۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091541088025.mp3"
    },
    {
      "number": 26,
      "text": "\u0026nbsp;ثُمَّ اِنَّ عَلَيۡنَا حِسَابَهُمْ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "091615088026.mp3"
    }
  ]
}