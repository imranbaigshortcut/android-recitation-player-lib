    {
      "number": 1,
      "text": "اَلۡهٰٮكُمُ التَّكَاثُرُۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "100300102001.mp3"
    },
    {
      "number": 2,
      "text": "حَتّٰى زُرۡتُمُ الۡمَقَابِرَؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "100339102002.mp3"
    },
    {
      "number": 3,
      "text": "\u0026nbsp;كَلَّا سَوۡفَ تَعۡلَمُوۡنَۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "100421102003.mp3"
    },
    {
      "number": 4,
      "text": "\u0026nbsp;ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُوۡنَؕ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "100501102004.mp3"
    },
    {
      "number": 5,
      "text": "كَلَّا لَوۡ تَعۡلَمُوۡنَ عِلۡمَ الۡيَقِيۡنِؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "100532102005.mp3"
    },
    {
      "number": 6,
      "text": "لَتَرَوُنَّ الۡجَحِيۡمَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "100605102006.mp3"
    },
    {
      "number": 7,
      "text": "\u0026nbsp;ثُمَّ لَتَرَوُنَّهَا عَيۡنَ الۡيَقِيۡنِۙ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "100657102007.mp3"
    },
    {
      "number": 8,
      "text": "\u0026nbsp;ثُمَّ لَـتُسۡـَٔـلُنَّ يَوۡمَٮِٕذٍ عَنِ النَّعِيۡمِ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
