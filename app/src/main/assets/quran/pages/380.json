  "ayatEnd": 26,
  "pageNo": 380,
  "ayatList": [
    {
      "number": 15,
      "text": "\u0026nbsp;يٰۤاَيُّهَا النَّاسُ اَنۡتُمُ الۡفُقَرَآءُ اِلَى اللّٰهِۚ وَاللّٰهُ هُوَ الۡغَنِىُّ الۡحَمِيۡدُ",
      "translationNo": "\u0026quot;her kommer norsk oversettelse snart\u0026quot;",
      "commentary": "",
      "audioTalawat": "115457035015.mp3"
    },
    {
      "number": 16,
      "text": "اِنۡ يَّشَاۡ يُذۡهِبۡكُمۡ وَيَاۡتِ بِخَلۡقٍ جَدِيۡدٍۚ\u0026rlm; ",
      "translationNo": "\u0026quot;her kommer norsk oversettelse snart\u0026quot;",
      "commentary": "",
      "audioTalawat": "115534035016.mp3"
    },
    {
      "number": 17,
      "text": "وَمَا ذٰ لِكَ عَلَى اللّٰهِ بِعَزِيۡزٍ",
      "translationNo": "\u0026quot;her kommer norsk oversettelse snart\u0026quot;",
      "commentary": "",
      "audioTalawat": "115608035017.mp3"
    },
    {
      "number": 18,
      "text": "وَ لَا تَزِرُ وَازِرَةٌ وِّزۡرَ اُخۡرَىٰ ؕ وَاِنۡ تَدۡعُ مُثۡقَلَةٌ اِلٰى حِمۡلِهَا لَا يُحۡمَلۡ مِنۡهُ شَىۡءٌ وَّلَوۡ كَانَ ذَا قُرۡبٰى ؕ اِنَّمَا تُنۡذِرُ الَّذِيۡنَ يَخۡشَوۡنَ رَبَّهُمۡ بِالۡغَيۡبِ وَاَقَامُوا الصَّلٰوةَ ؕ وَمَنۡ تَزَكّٰى فَاِنَّمَا يَتَزَكّٰى لِنَفۡسِهٖ ؕ وَاِلَى اللّٰهِ الۡمَصِيۡرُ",
      "translationNo": "\u0026quot;her kommer norsk oversettelse snart\u0026quot;",
      "commentary": "",
      "audioTalawat": "115651035018.mp3"
    },
    {
      "number": 19,
      "text": "وَمَا يَسۡتَوِى الۡاَعۡمٰى وَالۡبَصِيۡرُ ۙ\u0026rlm;",
      "translationNo": "\u0026quot;her kommer norsk oversettelse snart\u0026quot;",
      "commentary": "",
      "audioTalawat": "115745035019.mp3"
    },
    {
      "number": 20,
      "text": "وَلَا الظُّلُمٰتُ وَلَا النُّوۡرُۙ",
      "translationNo": "\u0026quot;her kommer norsk oversettelse snart\u0026quot;",
      "commentary": "",
      "audioTalawat": "115833035020.mp3"
    },
    {
      "number": 21,
      "text": "وَلَا الظِّلُّ وَلَا الۡحَـرُوۡرُۚ",
      "translationNo": "\u0026quot;her kommer norsk oversettelse snart\u0026quot;",
      "commentary": "",
      "audioTalawat": "115911035021.mp3"
    },
    {
      "number": 22,
      "text": "وَمَا يَسۡتَوِى الۡاَحۡيَآءُ وَلَا الۡاَمۡوَاتُ ؕ اِنَّ اللّٰهَ يُسۡمِعُ مَنۡ يَّشَآءُ ۚ وَمَاۤ اَنۡتَ بِمُسۡمِعٍ مَّنۡ فِى الۡقُبُوۡرِ",
      "translationNo": "\u0026quot;her kommer norsk oversettelse snart\u0026quot;",
      "commentary": "",
      "audioTalawat": "115946035022.mp3"
    },
    {
      "number": 23,
      "text": "اِنۡ اَنۡتَ اِلَّا نَذِيۡرٌ",
      "translationNo": "\u0026quot;her kommer norsk oversettelse snart\u0026quot;",
      "commentary": "",
      "audioTalawat": "120018035023.mp3"
    },
    {
      "number": 24,
      "text": "اِنَّاۤ اَرۡسَلۡنٰكَ بِالۡحَـقِّ بَشِيۡرًا وَّنَذِيۡرًاؕ وَاِنۡ مِّنۡ اُمَّةٍ اِلَّا خَلَا فِيۡهَا نَذِيۡرٌ",
      "translationNo": "\u0026quot;her kommer norsk oversettelse snart\u0026quot;",
      "commentary": "",
      "audioTalawat": "120056035024.mp3"
    },
    {
      "number": 25,
      "text": "وَاِنۡ يُّكَذِّبُوۡكَ فَقَدۡ كَذَّبَ الَّذِيۡنَ مِنۡ قَبۡلِهِمۡ\u0026zwnj;ۚ جَآءَتۡهُمۡ رُسُلُهُمۡ بِالۡبَيِّنٰتِ وَبِالزُّبُرِ وَبِالۡكِتٰبِ الۡمُنِيۡرِ",
      "translationNo": "\u0026quot;her kommer norsk oversettelse snart\u0026quot;",
      "commentary": "",
      "audioTalawat": "120158035025.mp3"
    },
    {
      "number": 26,
      "text": "ثُمَّ اَخَذۡتُ الَّذِيۡنَ كَفَرُوۡا فَكَيۡفَ كَانَ نَـكِيۡرِ",
      "translationNo": "Kommer snart",
      "commentary": "",
      "audioTalawat": "213238035026.mp3"
    }
  ]
}