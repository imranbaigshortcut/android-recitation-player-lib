{
  "maps": {},
  "suraStart": true,
  "suraNo": 37,
  "ayatStart": 1,
  "ayatEnd": 21,
  "pageNo": 388,
  "ayatList": [
    {
      "number": 1,
      "text": "وَالصّٰٓفّٰتِ صَفًّا ۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "101127037001.mp3"
    },
    {
      "number": 2,
      "text": "فَالزّٰجِرٰتِ زَجۡرًا ۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "101204037002.mp3"
    },
    {
      "number": 3,
      "text": "فَالتّٰلِيٰتِ ذِكۡرًا ۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "101425037003.mp3"
    },
    {
      "number": 4,
      "text": "اِنَّ اِلٰهَكُمۡ لَوَاحِدٌ\u0026ensp;ؕ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "101510037004.mp3"
    },
    {
      "number": 5,
      "text": "رَبُّ السَّمٰوٰتِ وَالۡاَرۡضِ وَمَا بَيۡنَهُمَا وَرَبُّ الۡمَشَارِقِ ؕ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "101603037005.mp3"
    },
    {
      "number": 6,
      "text": "اِنَّا زَيَّنَّا السَّمَآءَ الدُّنۡيَا بِزِيۡنَةِ اۨلۡكَوَاكِبِۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "101657037006.mp3"
    },
    {
      "number": 7,
      "text": "وَحِفۡظًا مِّنۡ كُلِّ شَيۡطٰنٍ مَّارِدٍ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "101741037007.mp3"
    },
    {
      "number": 8,
      "text": "لَّا يَسَّمَّعُوۡنَ اِلَى الۡمَلَاِ الۡاَعۡلٰى وَيُقۡذَفُوۡنَ مِنۡ كُلِّ جَانِبٍۖ \u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "101907037008.mp3"
    },
    {
      "number": 9,
      "text": "دُحُوۡرًا\u0026ensp; وَّلَهُمۡ عَذَابٌ وَّاصِبٌ\u0026ensp; ۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "102003037009.mp3"
    },
    {
      "number": 10,
      "text": "اِلَّا مَنۡ خَطِفَ الۡخَطۡفَةَ فَاَتۡبَعَهٗ شِهَابٌ ثَاقِبٌ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "102045037010.mp3"
    },
    {
      "number": 11,
      "text": "فَاسۡتَفۡتِهِمۡ اَهُمۡ اَشَدُّ خَلۡقًا اَمۡ مَّنۡ خَلَقۡنَاؕ اِنَّا خَلَقۡنٰهُمۡ مِّنۡ طِيۡنٍ لَّازِبٍ\u0026rlm;",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "102130037011.mp3"
    },
    {
      "number": 12,
      "text": "بَلۡ عَجِبۡتَ وَيَسۡخَرُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "102219037012.mp3"
    },
    {
      "number": 13,
      "text": "وَاِذَا ذُكِّرُوۡا لَا يَذۡكُرُوۡنَ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "102349037013.mp3"
    },
    {
      "number": 14,
      "text": "وَاِذَا رَاَوۡا اٰيَةً يَّسۡتَسۡخِرُوۡنَ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "102447037014.mp3"
    },
    {
      "number": 15,
      "text": "وَقَالُوۡۤا اِنۡ هٰذَاۤ اِلَّا سِحۡرٌ مُّبِيۡنٌ\u0026zwnj;\u0026nbsp;ۖ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "102545037015.mp3"
    },
    {
      "number": 16,
      "text": "ءَاِذَا مِتۡنَا وَكُـنَّا تُرَابًا وَّعِظَامًا ءَاِنَّا لَمَبۡعُوۡثُوۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "102642037016.mp3"
    },
    {
      "number": 17,
      "text": "اَوَاٰبَآؤُنَا الۡاَوَّلُوۡنَؕ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "102731037017.mp3"
    },
    {
      "number": 18,
      "text": "قُلۡ نَعَمۡ وَاَنۡـتُمۡ دٰخِرُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "102838037018.mp3"
    },
    {
      "number": 19,
      "text": "فَاِنَّمَا هِىَ زَجۡرَةٌ وَّاحِدَةٌ فَاِذَا هُمۡ يَنۡظُرُوۡنَ\u0026rlm;",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "102933037019.mp3"
    },
    {
      "number": 20,
      "text": "وَقَالُوۡا يٰوَيۡلَنَا هٰذَا يَوۡمُ الدِّيۡنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "103023037020.mp3"
    },
    {
      "number": 21,
      "text": "هٰذَا يَوۡمُ الۡفَصۡلِ الَّذِىۡ كُنۡتُمۡ بِهٖ تُكَذِّبُوۡنَ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "103116037021.mp3"
    }
  ]
}