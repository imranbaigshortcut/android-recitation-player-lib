  "ayatList": [
    {
      "number": 1,
      "text": "اَلَمۡ نَشۡرَحۡ لَـكَ صَدۡرَكَۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "081854094001.mp3"
    },
    {
      "number": 2,
      "text": "\u0026nbsp;وَوَضَعۡنَا عَنۡكَ وِزۡرَكَۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "082016094002.mp3"
    },
    {
      "number": 3,
      "text": "\u0026nbsp;\u0026nbsp;الَّذِىۡۤ اَنۡقَضَ ظَهۡرَكَۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "082238094003.mp3"
    },
    {
      "number": 4,
      "text": "\u0026nbsp;\u0026nbsp;وَرَفَعۡنَا لَـكَ ذِكۡرَكَؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "082444094004.mp3"
    },
    {
      "number": 5,
      "text": "\u0026nbsp;\u0026nbsp;فَاِنَّ مَعَ الۡعُسۡرِ يُسۡرًا ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "082900094005.mp3"
    },
    {
      "number": 6,
      "text": "\u0026nbsp;\u0026nbsp;اِنَّ مَعَ الۡعُسۡرِ يُسۡرًا ؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "083110094006.mp3"
    },
    {
      "number": 7,
      "text": "\u0026nbsp;\u0026nbsp;فَاِذَا فَرَغۡتَ فَانۡصَبۡۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "083319094007.mp3"
    },
    {
      "number": 8,
      "text": "\u0026nbsp;\u0026nbsp;وَاِلٰى رَبِّكَ فَارۡغَب\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "083505094008.mp3"
    }
  ]
}