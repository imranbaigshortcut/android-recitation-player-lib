{
  "maps": {},
  "suraStart": false,
  "suraNo": 37,
  "ayatStart": 75,
  "ayatEnd": 113,
  "pageNo": 390,
  "ayatList": [
    {
      "number": 75,
      "text": "وَلَقَدۡ نَادٰٮنَا نُوۡحٌ فَلَنِعۡمَ الۡمُجِيۡبُوۡنَ\u0026ensp; ۖ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "130800037075.mp3"
    },
    {
      "number": 76,
      "text": "وَنَجَّيۡنٰهُ وَاَهۡلَهٗ مِنَ الۡكَرۡبِ الۡعَظِيۡمِ\u0026ensp; ۖ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "130849037076.mp3"
    },
    {
      "number": 77,
      "text": "وَجَعَلۡنَا ذُرِّيَّتَهٗ هُمُ الۡبٰقِيۡنَ\u0026ensp; ۖ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "130940037077.mp3"
    },
    {
      "number": 78,
      "text": "وَتَرَكۡنَا عَلَيۡهِ فِى الۡاٰخِرِيۡنَ\u0026ensp; ۖ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "131032037078.mp3"
    },
    {
      "number": 79,
      "text": "سَلٰمٌ عَلٰى نُوۡحٍ فِى الۡعٰلَمِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "131125037079.mp3"
    },
    {
      "number": 80,
      "text": "اِنَّا كَذٰلِكَ نَجۡزِى الۡمُحۡسِنِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "131212037080.mp3"
    },
    {
      "number": 81,
      "text": "اِنَّهٗ مِنۡ عِبَادِنَا الۡمُؤۡمِنِيۡنَ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "131302037081.mp3"
    },
    {
      "number": 82,
      "text": "ثُمَّ اَغۡرَقۡنَا الۡاٰخَرِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "131344037082.mp3"
    },
    {
      "number": 83,
      "text": "وَاِنَّ مِنۡ شِيۡعَتِهٖ لَاِبۡرٰهِيۡمَ\u0026zwnj;ۘ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "131435037083.mp3"
    },
    {
      "number": 84,
      "text": "اِذۡ جَآءَ رَبَّهٗ بِقَلۡبٍ سَلِيۡمٍ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "131527037084.mp3"
    },
    {
      "number": 85,
      "text": "اِذۡ قَالَ لِاَبِيۡهِ وَقَوۡمِهٖ مَاذَا تَعۡبُدُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "131618037085.mp3"
    },
    {
      "number": 86,
      "text": "اَٮِٕفۡكًا اٰلِهَةً دُوۡنَ اللّٰهِ تُرِيۡدُوۡنَؕ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "131707037086.mp3"
    },
    {
      "number": 87,
      "text": "فَمَا ظَنُّكُمۡ بِرَبِّ الۡعٰلَمِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "131856037087.mp3"
    },
    {
      "number": 88,
      "text": "فَنَظَرَ نَظۡرَةً فِى النُّجُوۡمِۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "132016037088.mp3"
    },
    {
      "number": 89,
      "text": "فَقَالَ اِنِّىۡ سَقِيۡمٌ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "132107037089.mp3"
    },
    {
      "number": 90,
      "text": "فَتَوَلَّوۡا عَنۡهُ مُدۡبِرِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "132204037090.mp3"
    },
    {
      "number": 91,
      "text": "فَرَاغَ اِلٰٓى اٰلِهَتِهِمۡ فَقَالَ اَلَا تَاۡكُلُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "132259037091.mp3"
    },
    {
      "number": 92,
      "text": "مَا لَـكُمۡ لَا تَنۡطِقُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "132352037092.mp3"
    },
    {
      "number": 93,
      "text": "فَرَاغَ عَلَيۡهِمۡ ضَرۡبًۢا بِالۡيَمِيۡنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "132441037093.mp3"
    },
    {
      "number": 94,
      "text": "فَاَقۡبَلُوۡۤا اِلَيۡهِ يَزِفُّوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "132535037094.mp3"
    },
    {
      "number": 95,
      "text": "قَالَ اَتَعۡبُدُوۡنَ مَا تَنۡحِتُوۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "132622037095.mp3"
    },
    {
      "number": 96,
      "text": "وَاللّٰهُ خَلَقَكُمۡ وَمَا تَعۡمَلُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "132713037096.mp3"
    },
    {
      "number": 97,
      "text": "قَالُوا ابۡنُوۡا لَهٗ بُنۡيَانًا فَاَلۡقُوۡهُ فِى الۡجَحِيۡمِ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "132758037097.mp3"
    },
    {
      "number": 98,
      "text": "فَاَرَادُوۡا بِهٖ كَيۡدًا فَجَعَلۡنٰهُمُ الۡاَسۡفَلِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "132845037098.mp3"
    },
    {
      "number": 99,
      "text": "وَقَالَ اِنِّىۡ ذَاهِبٌ اِلٰى رَبِّىۡ سَيَهۡدِيۡنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "132940037099.mp3"
    },
    {
      "number": 100,
      "text": "رَبِّ هَبۡ لِىۡ مِنَ الصّٰلِحِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "133027037100.mp3"
    },
    {
      "number": 101,
      "text": "فَبَشَّرۡنٰهُ بِغُلٰمٍ حَلِيۡمٍ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "140114037101.mp3"
    },
    {
      "number": 102,
      "text": "فَلَمَّا بَلَغَ مَعَهُ السَّعۡىَ قَالَ يٰبُنَىَّ اِنِّىۡۤ اَرٰى فِى الۡمَنَامِ اَنِّىۡۤ اَذۡبَحُكَ فَانْظُرۡ مَاذَا تَرٰى\u0026zwnj;ؕ قَالَ يٰۤاَبَتِ افۡعَلۡ مَا تُؤۡمَرُ\u0026zwnj; سَتَجِدُنِىۡۤ اِنۡ شَآءَ اللّٰهُ مِنَ الصّٰبِرِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "140232037102.mp3"
    },
    {
      "number": 103,
      "text": "فَلَمَّاۤ اَسۡلَمَا وَتَلَّهٗ لِلۡجَبِيۡنِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "140323037103.mp3"
    },
    {
      "number": 104,
      "text": "وَنَادَيۡنٰهُ اَنۡ يّٰۤاِبۡرٰهِيۡمُۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "140444037104.mp3"
    },
    {
      "number": 105,
      "text": "قَدۡ صَدَّقۡتَ الرُّءۡيَا \u0026zwnj; \u0026zwnj;ۚ اِنَّا كَذٰلِكَ نَجۡزِى الۡمُحۡسِنِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "140545037105.mp3"
    },
    {
      "number": 106,
      "text": "اِنَّ هٰذَا لَهُوَ الۡبَلٰٓؤُا الۡمُبِيۡنُ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "140637037106.mp3"
    },
    {
      "number": 107,
      "text": "وَفَدَيۡنٰهُ بِذِبۡحٍ عَظِيۡمٍ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "140848037107.mp3"
    },
    {
      "number": 108,
      "text": "وَتَرَكۡنَا عَلَيۡهِ فِى الۡاٰخِرِيۡنَ\u0026zwnj;ۖ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "140950037108.mp3"
    },
    {
      "number": 109,
      "text": "سَلٰمٌ عَلٰٓى اِبۡرٰهِيۡمَ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "141042037109.mp3"
    },
    {
      "number": 110,
      "text": "كَذٰلِكَ نَجۡزِى الۡمُحۡسِنِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "141128037110.mp3"
    },
    {
      "number": 111,
      "text": "اِنَّهٗ مِنۡ عِبَادِنَا الۡمُؤۡمِنِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "141220037111.mp3"
    },
    {
      "number": 112,
      "text": "وَبَشَّرۡنٰهُ بِاِسۡحٰقَ نَبِيًّا مِّنَ الصّٰلِحِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "141318037112.mp3"
    },
    {
      "number": 113,
      "text": "وَبٰرَكۡنَا عَلَيۡهِ وَعَلٰٓى اِسۡحٰقَ\u0026zwnj;ؕ وَ مِنۡ ذُرِّيَّتِهِمَا مُحۡسِنٌ وَّظَالِمٌ لِّنَفۡسِهٖ مُبِيۡنٌ\u0026zwnj;\u0026rlm;",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "141415037113.mp3"
    }
  ]
}