{
  "maps": {},
  "suraStart": false,
  "suraNo": 37,
  "ayatStart": 139,
  "ayatEnd": 182,
  "pageNo": 392,
  "ayatList": [
    {
      "number": 139,
      "text": "وَاِنَّ يُوۡنُسَ لَمِنَ الۡمُرۡسَلِيۡنَؕ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "144034037139.mp3"
    },
    {
      "number": 140,
      "text": "اِذۡ اَبَقَ اِلَى الۡفُلۡكِ الۡمَشۡحُوۡنِۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "144117037140.mp3"
    },
    {
      "number": 141,
      "text": "فَسَاهَمَ فَكَانَ مِنَ الۡمُدۡحَضِيۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "144202037141.mp3"
    },
    {
      "number": 142,
      "text": "فَالۡتَقَمَهُ الۡحُوۡتُ وَهُوَ مُلِيۡمٌ\u0026rlm;",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "144407037142.mp3"
    },
    {
      "number": 143,
      "text": "فَلَوۡلَاۤ اَنَّهٗ كَانَ مِنَ الۡمُسَبِّحِيۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "144454037143.mp3"
    },
    {
      "number": 144,
      "text": "لَلَبِثَ فِىۡ بَطۡنِهٖۤ اِلٰى يَوۡمِ يُبۡعَثُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "144549037144.mp3"
    },
    {
      "number": 145,
      "text": "فَنَبَذۡنٰهُ بِالۡعَرَآءِ وَهُوَ سَقِيۡمٌ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "144633037145.mp3"
    },
    {
      "number": 146,
      "text": "وَاَنۡۢبَتۡنَا عَلَيۡهِ شَجَرَةً مِّنۡ يَّقۡطِيۡنٍ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "144740037146.mp3"
    },
    {
      "number": 147,
      "text": "وَاَرۡسَلۡنٰهُ اِلٰى مِائَةِ اَلۡفٍ اَوۡ يَزِيۡدُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "144829037147.mp3"
    },
    {
      "number": 148,
      "text": "فَاٰمَنُوۡا فَمَتَّعۡنٰهُمۡ اِلٰى حِيۡنٍؕ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "144914037148.mp3"
    },
    {
      "number": 149,
      "text": "فَاسۡتَفۡتِهِمۡ اَلِرَبِّكَ الۡبَنَاتُ وَلَهُمُ الۡبَنُوۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "145002037149.mp3"
    },
    {
      "number": 150,
      "text": "اَمۡ خَلَقۡنَا الۡمَلٰٓٮِٕكَةَ اِنَاثًا وَّهُمۡ شٰهِدُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "145044037150.mp3"
    },
    {
      "number": 151,
      "text": "اَلَاۤ اِنَّهُمۡ مِّنۡ اِفۡكِهِمۡ لَيَقُوۡلُوۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "145138037151.mp3"
    },
    {
      "number": 152,
      "text": "وَلَدَ اللّٰهُۙ وَاِنَّهُمۡ لَـكٰذِبُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "145231037152.mp3"
    },
    {
      "number": 153,
      "text": "اَصۡطَفَى الۡبَنَاتِ عَلَى الۡبَنِيۡنَؕ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "145316037153.mp3"
    },
    {
      "number": 154,
      "text": "مَا لَـكُمۡ كَيۡفَ تَحۡكُمُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "145359037154.mp3"
    },
    {
      "number": 155,
      "text": "اَفَلَا تَذَكَّرُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "145447037155.mp3"
    },
    {
      "number": 156,
      "text": "اَمۡ لَـكُمۡ سُلۡطٰنٌ مُّبِيۡنٌۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "145535037156.mp3"
    },
    {
      "number": 157,
      "text": "فَاۡتُوۡا بِكِتٰبِكُمۡ اِنۡ كُنۡتُمۡ صٰدِقِيۡنَ\u0026rlm;",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "145620037157.mp3"
    },
    {
      "number": 158,
      "text": "وَجَعَلُوۡا بَيۡنَهٗ وَبَيۡنَ الۡجِنَّةِ نَسَبًا\u0026nbsp;ؕ\u0026zwnj; وَلَقَدۡ عَلِمَتِ الۡجِنَّةُ اِنَّهُمۡ لَمُحۡضَرُوۡنَۙ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "145704037158.mp3"
    },
    {
      "number": 159,
      "text": "سُبۡحٰنَ اللّٰهِ عَمَّا يَصِفُوۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "145749037159.mp3"
    },
    {
      "number": 160,
      "text": "اِلَّا عِبَادَ اللّٰهِ الۡمُخۡلَصِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "145834037160.mp3"
    },
    {
      "number": 161,
      "text": "فَاِنَّكُمۡ وَمَا تَعۡبُدُوۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "213311037161.mp3"
    },
    {
      "number": 162,
      "text": "مَاۤ اَنۡـتُمۡ عَلَيۡهِ بِفٰتِنِيۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "213358037162.mp3"
    },
    {
      "number": 163,
      "text": "اِلَّا مَنۡ هُوَ صَالِ الۡجَحِيۡمِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "213506037163.mp3"
    },
    {
      "number": 164,
      "text": "وَمَا مِنَّاۤ اِلَّا لَهٗ مَقَامٌ مَّعۡلُوۡمٌۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "213556037164.mp3"
    },
    {
      "number": 165,
      "text": "وَّاِنَّا لَـنَحۡنُ الصَّآفُّوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "213643037165.mp3"
    },
    {
      "number": 166,
      "text": "وَاِنَّا لَـنَحۡنُ الۡمُسَبِّحُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "213736037166.mp3"
    },
    {
      "number": 167,
      "text": "وَاِنۡ كَانُوۡا لَيَقُوۡلُوۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "213827037167.mp3"
    },
    {
      "number": 168,
      "text": "لَوۡ اَنَّ عِنۡدَنَا ذِكۡرًا مِّنَ الۡاَوَّلِيۡنَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "213919037168.mp3"
    },
    {
      "number": 169,
      "text": "لَـكُنَّا عِبَادَ اللّٰهِ الۡمُخۡلَصِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "214007037169.mp3"
    },
    {
      "number": 170,
      "text": "فَكَفَرُوۡا بِهٖ\u0026zwnj; فَسَوۡفَ يَعۡلَمُوۡنَ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "214104037170.mp3"
    },
    {
      "number": 171,
      "text": "وَلَقَدۡ سَبَقَتۡ كَلِمَتُنَا لِعِبَادِنَا الۡمُرۡسَلِيۡنَ\u0026nbsp;\u0026zwnj;ۖ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "214155037171.mp3"
    },
    {
      "number": 172,
      "text": "اِنَّهُمۡ لَهُمُ الۡمَنۡصُوۡرُوۡنَ\u0026nbsp;",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "214258037172.mp3"
    },
    {
      "number": 173,
      "text": "وَاِنَّ جُنۡدَنَا لَهُمُ الۡغٰلِبُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "214344037173.mp3"
    },
    {
      "number": 174,
      "text": "فَتَوَلَّ عَنۡهُمۡ حَتّٰى حِيۡنٍۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "214431037174.mp3"
    },
    {
      "number": 175,
      "text": "وَاَبۡصِرۡهُمۡ فَسَوۡفَ يُبۡصِرُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "214518037175.mp3"
    },
    {
      "number": 176,
      "text": "اَفَبِعَذَابِنَا يَسۡتَعۡجِلُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "214603037176.mp3"
    },
    {
      "number": 177,
      "text": "فَاِذَا نَزَلَ بِسَاحَتِهِمۡ فَسَآءَ صَبَاحُ الۡمُنۡذَرِيۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "214656037177.mp3"
    },
    {
      "number": 178,
      "text": "وَتَوَلَّ عَنۡهُمۡ حَتّٰى حِيۡنٍۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "214746037178.mp3"
    },
    {
      "number": 179,
      "text": "وَّاَبۡصِرۡ فَسَوۡفَ يُبۡصِرُوۡنَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "214835037179.mp3"
    },
    {
      "number": 180,
      "text": "سُبۡحٰنَ رَبِّكَ رَبِّ الۡعِزَّةِ عَمَّا يَصِفُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "214918037180.mp3"
    },
    {
      "number": 181,
      "text": "وَسَلٰمٌ عَلَى الۡمُرۡسَلِيۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "215002037181.mp3"
    },
    {
      "number": 182,
      "text": "وَالۡحَمۡدُ لِلّٰهِ رَبِّ الۡعٰلَمِيۡنَ\u0026zwnj;\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "215056037182.mp3"
    }
  ]
}