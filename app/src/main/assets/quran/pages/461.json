{
  "maps": {},
  "suraStart": false,
  "suraNo": 52,
  "ayatStart": 29,
  "ayatEnd": 49,
  "pageNo": 461,
  "ayatList": [
    {
      "number": 29,
      "text": "فَذَكِّرۡ فَمَاۤ اَنۡتَ بِنِعۡمَتِ رَبِّكَ بِكَاهِنٍ وَّلَا مَجۡنُوۡنٍؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195358052029.mp3"
    },
    {
      "number": 30,
      "text": "اَمۡ يَقُوۡلُوۡنَ شَاعِرٌ نَّتَـرَبَّصُ بِهٖ رَيۡبَ الۡمَنُوۡنِ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195500052030.mp3"
    },
    {
      "number": 31,
      "text": "قُلۡ تَرَبَّصُوۡا فَاِنِّىۡ مَعَكُمۡ مِّنَ الۡمُتَـرَبِّصِيۡنَ ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195626052031.mp3"
    },
    {
      "number": 32,
      "text": "اَمۡ تَاۡمُرُهُمۡ اَحۡلَامُهُمۡ بِهٰذَآ\u0026zwnj; اَمۡ هُمۡ قَوۡمٌ طَاغُوۡنَ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195803052032.mp3"
    },
    {
      "number": 33,
      "text": "اَمۡ يَقُوۡلُوۡنَ تَقَوَّلَهٗ\u0026zwnj; ۚ بَلْ لَّا يُؤۡمِنُوۡنَ\u0026zwnj; ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195904052033.mp3"
    },
    {
      "number": 34,
      "text": "فَلۡيَاۡتُوۡا بِحَدِيۡثٍ مِّثۡلِهٖۤ اِنۡ كَانُوۡا صٰدِقِيۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.",
      "commentary": "",
      "audioTalawat": "200140052034.mp3"
    },
    {
      "number": 35,
      "text": "اَمۡ خُلِقُوۡا مِنۡ غَيۡرِ شَىۡءٍ اَمۡ هُمُ الۡخٰلِقُوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200240052035.mp3"
    },
    {
      "number": 36,
      "text": "اَمۡ خَلَـقُوا السَّمٰوٰتِ وَالۡاَرۡضَ\u0026zwnj;ۚ بَلْ لَّا يُوۡقِنُوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200338052036.mp3"
    },
    {
      "number": 37,
      "text": "اَمۡ عِنۡدَهُمۡ خَزَآٮِٕنُ رَبِّكَ اَمۡ هُمُ الۡمُصَۜيۡطِرُوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200521052037.mp3"
    },
    {
      "number": 38,
      "text": "اَمۡ لَهُمۡ سُلَّمٌ يَّسۡتَمِعُوۡنَ فِيۡهِ\u0026zwnj;\u0026nbsp;ۚ فَلۡيَاۡتِ مُسۡتَمِعُهُمۡ بِسُلۡطٰنٍ مُّبِيۡنٍؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200623052038.mp3"
    },
    {
      "number": 39,
      "text": "اَمۡ لَـهُ الۡبَنٰتُ وَلَـكُمُ الۡبَنُوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200734052039.mp3"
    },
    {
      "number": 40,
      "text": "اَمۡ تَسۡـَٔـلُهُمۡ اَجۡرًا فَهُمۡ مِّنۡ مَّغۡرَمٍ مُّثۡقَلُوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "200825052040.mp3"
    },
    {
      "number": 41,
      "text": "اَمۡ عِنۡدَهُمُ الۡغَيۡبُ فَهُمۡ يَكۡتُبُوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "201106052041.mp3"
    },
    {
      "number": 42,
      "text": "اَمۡ يُرِيۡدُوۡنَ كَيۡدًا\u0026zwnj;ؕ فَالَّذِيۡنَ كَفَرُوۡا هُمُ الۡمَكِيۡدُوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "201202052042.mp3"
    },
    {
      "number": 43,
      "text": "اَمۡ لَهُمۡ اِلٰهٌ غَيۡرُ اللّٰهِ\u0026zwnj;ؕ سُبۡحٰنَ اللّٰهِ عَمَّا يُشۡرِكُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "201256052043.mp3"
    },
    {
      "number": 44,
      "text": "وَاِنۡ يَّرَوۡا كِسۡفًا مِّنَ السَّمَآءِ سَاقِطًا يَّقُوۡلُوۡا سَحَابٌ مَّرۡكُوۡمٌ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "201358052044.mp3"
    },
    {
      "number": 45,
      "text": "فَذَرۡهُمۡ حَتّٰى يُلٰقُوۡا يَوۡمَهُمُ الَّذِىۡ فِيۡهِ يُصۡعَقُوۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "201511052045.mp3"
    },
    {
      "number": 46,
      "text": "يَوۡمَ لَا يُغۡنِىۡ عَنۡهُمۡ كَيۡدُهُمۡ شَيۡـًٔـا وَّلَا هُمۡ يُنۡصَرُوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "201700052046.mp3"
    },
    {
      "number": 47,
      "text": "وَاِنَّ لِلَّذِيۡنَ ظَلَمُوۡا عَذَابًا دُوۡنَ ذٰلِكَ وَلٰـكِنَّ اَكۡثَرَهُمۡ لَا يَعۡلَمُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "201757052047.mp3"
    },
    {
      "number": 48,
      "text": "وَاصۡبِرۡ لِحُكۡمِ رَبِّكَ فَاِنَّكَ بِاَعۡيُنِنَا\u0026zwnj; وَسَبِّحۡ بِحَمۡدِ رَبِّكَ حِيۡنَ تَقُوۡمُۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "201851052048.mp3"
    },
    {
      "number": 49,
      "text": "\u0026nbsp;وَمِنَ الَّيۡلِ فَسَبِّحۡهُ وَاِدۡبَارَ النُّجُوۡمِ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "202001052049.mp3"
    }
  ]
}