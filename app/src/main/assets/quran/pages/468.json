{
  "maps": {},
  "suraStart": true,
  "suraNo": 55,
  "ayatStart": 1,
  "ayatEnd": 25,
  "pageNo": 468,
  "ayatList": [
    {
      "number": 1,
      "text": "اَلرَّحۡمٰنُۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "162443055001.mp3"
    },
    {
      "number": 2,
      "text": "عَلَّمَ الۡقُرۡاٰنَؕ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "162539055002.mp3"
    },
    {
      "number": 3,
      "text": "خَلَقَ الۡاِنۡسَانَۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "162623055003.mp3"
    },
    {
      "number": 4,
      "text": "عَلَّمَهُ الۡبَيَانَ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "162702055004.mp3"
    },
    {
      "number": 5,
      "text": "اَلشَّمۡسُ وَالۡقَمَرُ بِحُسۡبَانٍ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "162752055005.mp3"
    },
    {
      "number": 6,
      "text": "وَّالنَّجۡمُ وَالشَّجَرُ يَسۡجُدٰنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "162843055006.mp3"
    },
    {
      "number": 7,
      "text": "وَالسَّمَآءَ رَفَعَهَا وَوَضَعَ الۡمِيۡزَانَۙ\u0026rlm;",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "162949055007.mp3"
    },
    {
      "number": 8,
      "text": "اَلَّا تَطۡغَوۡا فِى الۡمِيۡزَانِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "163035055008.mp3"
    },
    {
      "number": 9,
      "text": "وَاَقِيۡمُوا الۡوَزۡنَ بِالۡقِسۡطِ وَلَا تُخۡسِرُوا الۡمِيۡزَانَ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "163122055009.mp3"
    },
    {
      "number": 10,
      "text": "وَالۡاَرۡضَ وَضَعَهَا لِلۡاَنَامِۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "163208055010.mp3"
    },
    {
      "number": 11,
      "text": "فِيۡهَا فَاكِهَةٌ  ۙ وَّالنَّخۡلُ ذَاتُ الۡاَكۡمَامِ\u0026zwnj; ۖ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "163248055011.mp3"
    },
    {
      "number": 12,
      "text": "وَالۡحَبُّ ذُو الۡعَصۡفِ وَالرَّيۡحَانُ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "163334055012.mp3"
    },
    {
      "number": 13,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "163422055013.mp3"
    },
    {
      "number": 14,
      "text": "خَلَقَ الۡاِنۡسَانَ مِنۡ صَلۡصَالٍ كَالۡفَخَّارِۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "174741055014.mp3"
    },
    {
      "number": 15,
      "text": "وَخَلَقَ الۡجَآنَّ مِنۡ مَّارِجٍ مِّنۡ نَّارٍ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "174823055015.mp3"
    },
    {
      "number": 16,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "174902055016.mp3"
    },
    {
      "number": 17,
      "text": "رَبُّ الۡمَشۡرِقَيۡنِ وَ رَبُّ الۡمَغۡرِبَيۡنِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "174943055017.mp3"
    },
    {
      "number": 18,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "175025055018.mp3"
    },
    {
      "number": 19,
      "text": "مَرَجَ الۡبَحۡرَيۡنِ يَلۡتَقِيٰنِۙ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "175107055019.mp3"
    },
    {
      "number": 20,
      "text": "بَيۡنَهُمَا بَرۡزَخٌ لَّا يَبۡغِيٰنِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "175149055020.mp3"
    },
    {
      "number": 21,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "175250055021.mp3"
    },
    {
      "number": 22,
      "text": "يَخۡرُجُ مِنۡهُمَا اللُّـؤۡلُـؤُ وَالۡمَرۡجَانُ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "175333055022.mp3"
    },
    {
      "number": 23,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "175415055023.mp3"
    },
    {
      "number": 24,
      "text": "وَلَهُ الۡجَوَارِ الۡمُنۡشَئٰتُ فِى الۡبَحۡرِ كَالۡاَعۡلَامِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "175458055024.mp3"
    },
    {
      "number": 25,
      "text": "فَبِاَىِّ اٰلَاۤءِ رَبِّكُمَا تُكَذِّبٰنِ",
      "translationNo": "Oversettelse kommer",
      "commentary": "",
      "audioTalawat": "175544055025.mp3"
    }
  ]
}