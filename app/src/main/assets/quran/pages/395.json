  "ayatEnd": 40,
  "pageNo": 395,
  "ayatList": [
    {
      "number": 27,
      "text": "وَمَا خَلَقۡنَا السَّمَآءَ وَالۡاَرۡضَ وَمَا بَيۡنَهُمَا بَاطِلًا \u0026zwnj;ؕ ذٰ لِكَ ظَنُّ الَّذِيۡنَ كَفَرُوۡا\u0026zwnj;ۚ فَوَيۡلٌ لِّلَّذِيۡنَ كَفَرُوۡا مِنَ النَّارِؕ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "224611038027.mp3"
    },
    {
      "number": 28,
      "text": "اَمۡ نَجۡعَلُ الَّذِيۡنَ اٰمَنُوۡا وَعَمِلُوا الصّٰلِحٰتِ كَالۡمُفۡسِدِيۡنَ فِى الۡاَرۡضِ اَمۡ نَجۡعَلُ الۡمُتَّقِيۡنَ كَالۡفُجَّارِ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "224722038028.mp3"
    },
    {
      "number": 29,
      "text": "كِتٰبٌ اَنۡزَلۡنٰهُ اِلَيۡكَ مُبٰرَكٌ لِّيَدَّبَّرُوۡۤا اٰيٰتِهٖ وَلِيَتَذَكَّرَ اُولُوا الۡاَلۡبَابِ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "224816038029.mp3"
    },
    {
      "number": 30,
      "text": "وَوَهَبۡنَا لِدَاوٗدَ سُلَيۡمٰنَ\u0026zwnj; ؕ نِعۡمَ الۡعَبۡدُ\u0026zwnj; ؕ اِنَّـهٗۤ اَوَّابٌ ؕ ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "224931038030.mp3"
    },
    {
      "number": 31,
      "text": "اِذۡ عُرِضَ عَلَيۡهِ بِالۡعَشِىِّ الصّٰفِنٰتُ الۡجِيَادُ ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "225023038031.mp3"
    },
    {
      "number": 32,
      "text": "فَقَالَ اِنِّىۡۤ اَحۡبَبۡتُ حُبَّ الۡخَيۡرِ عَنۡ ذِكۡرِ رَبِّىۡ\u0026zwnj;ۚ حَتّٰى تَوَارَتۡ بِالۡحِجَابِ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "225112038032.mp3"
    },
    {
      "number": 33,
      "text": "رُدُّوۡهَا عَلَىَّ\u0026nbsp;\u0026nbsp;ؕ فَطَفِقَ مَسۡحًۢا بِالسُّوۡقِ وَ الۡاَعۡنَاقِ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "225210038033.mp3"
    },
    {
      "number": 34,
      "text": "وَلَقَدۡ فَتَنَّا سُلَيۡمٰنَ وَاَلۡقَيۡنَا عَلٰى كُرۡسِيِّهٖ جَسَدًا ثُمَّ اَنَابَ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "225312038034.mp3"
    },
    {
      "number": 35,
      "text": "قَالَ رَبِّ اغۡفِرۡ لِىۡ وَهَبۡ لِىۡ مُلۡكًا لَّا يَنۡۢبَغِىۡ لِاَحَدٍ مِّنۡۢ بَعۡدِىۡ\u0026zwnj;ۚ اِنَّكَ اَنۡتَ الۡوَهَّابُ\u0026rlm;",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "225408038035.mp3"
    },
    {
      "number": 36,
      "text": "فَسَخَّرۡنَا لَهُ الرِّيۡحَ تَجۡرِىۡ بِاَمۡرِهٖ رُخَآءً حَيۡثُ اَصَابَۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "225512038036.mp3"
    },
    {
      "number": 37,
      "text": "وَالشَّيٰطِيۡنَ كُلَّ بَنَّآءٍ وَّغَوَّاصٍۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "225605038037.mp3"
    },
    {
      "number": 38,
      "text": "وَّاٰخَرِيۡنَ مُقَرَّنِيۡنَ فِىۡ الۡاَصۡفَادِ\u0026rlm;\u0026nbsp;",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "225708038038.mp3"
    },
    {
      "number": 39,
      "text": "هٰذَا عَطَآؤُنَا فَامۡنُنۡ اَوۡ اَمۡسِكۡ بِغَيۡرِ حِسَابٍ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "225941038039.mp3"
    },
    {
      "number": 40,
      "text": "وَاِنَّ لَهٗ عِنۡدَنَا لَزُلۡفٰى وَحُسۡنَ مَاٰبٍ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "230035038040.mp3"
    }
  ]
}