{
  "maps": {},
  "suraStart": false,
  "suraNo": 50,
  "ayatStart": 30,
  "ayatEnd": 45,
  "pageNo": 456,
  "ayatList": [
    {
      "number": 30,
      "text": "يَوۡمَ نَـقُوۡلُ لِجَهَـنَّمَ هَلِ امۡتَلَـئْتِ وَتَقُوۡلُ هَلۡ مِنۡ مَّزِيۡدٍ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "222254050030.mp3"
    },
    {
      "number": 31,
      "text": "\u0026nbsp;\u0026nbsp;وَاُزۡلِفَتِ الۡجَـنَّةُ لِلۡمُتَّقِيۡنَ غَيۡرَ بَعِيۡدٍ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "222403050031.mp3"
    },
    {
      "number": 32,
      "text": "﻿\u0026nbsp; هٰذَا مَا تُوۡعَدُوۡنَ لِكُلِّ اَوَّابٍ حَفِيۡظٍ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "222529050032.mp3"
    },
    {
      "number": 33,
      "text": "مَنۡ خَشِىَ الرَّحۡمٰنَ بِالۡغَيۡبِ وَجَآءَ بِقَلۡبٍ مُّنِيۡبِۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "222618050033.mp3"
    },
    {
      "number": 34,
      "text": "اۨدۡخُلُوۡهَا بِسَلٰمٍ\u0026zwnj;ؕ ذٰلِكَ يَوۡمُ الۡخُلُوۡدِ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "222725050034.mp3"
    },
    {
      "number": 35,
      "text": "لَهُمۡ مَّا يَشَآءُوۡنَ فِيۡهَا وَلَدَيۡنَا مَزِيۡدٌ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "222833050035.mp3"
    },
    {
      "number": 36,
      "text": "\u0026nbsp;وَكَمۡ اَهۡلَـكۡنَا قَبۡلَهُمۡ مِّنۡ قَرۡنٍ هُمۡ اَشَدُّ مِنۡهُمۡ بَطۡشًا فَنَقَّبُوۡا فِى الۡبِلَادِ ؕ هَلۡ مِنۡ مَّحِيۡصٍ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "222921050036.mp3"
    },
    {
      "number": 37,
      "text": "\u0026nbsp;اِنَّ فِىۡ ذٰلِكَ لَذِكۡرٰى لِمَنۡ كَانَ لَهٗ قَلۡبٌ اَوۡ اَلۡقَى السَّمۡعَ وَهُوَ شَهِيۡدٌ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "223015050037.mp3"
    },
    {
      "number": 38,
      "text": "\u0026nbsp;وَلَقَدۡ خَلَقۡنَا السَّمٰوٰتِ وَالۡاَرۡضَ وَمَا بَيۡنَهُمَا فِىۡ سِتَّةِ اَيَّامٍ\u0026zwnj;ۖ وَّمَا مَسَّنَا مِنۡ لُّغُوۡبٍ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "223113050038.mp3"
    },
    {
      "number": 39,
      "text": "فَاصۡبِرۡ عَلٰى مَا يَقُوۡلُوۡنَ وَسَبِّحۡ بِحَمۡدِ رَبِّكَ قَبۡلَ طُلُوۡعِ الشَّمۡسِ وَقَبۡلَ الۡغُرُوۡبِ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "223205050039.mp3"
    },
    {
      "number": 40,
      "text": "\u0026nbsp;وَمِنَ الَّيۡلِ فَسَبِّحۡهُ وَاَدۡبَارَ السُّجُوۡدِ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "223303050040.mp3"
    },
    {
      "number": 41,
      "text": "﻿\u0026nbsp; وَاسۡتَمِعۡ يَوۡمَ يُنَادِ الۡمُنَادِ مِنۡ مَّكَانٍ قَرِيۡبٍۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "223415050041.mp3"
    },
    {
      "number": 42,
      "text": "\u0026nbsp;يَوۡمَ يَسۡمَعُوۡنَ الصَّيۡحَةَ بِالۡحَـقِّ\u0026zwnj; ؕ ذٰ لِكَ يَوۡمُ الۡخُـرُوۡجِ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "223511050042.mp3"
    },
    {
      "number": 43,
      "text": "\u0026nbsp;اِنَّا نَحۡنُ نُحۡىٖ وَنُمِيۡتُ وَاِلَيۡنَا الۡمَصِيۡرُۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "223606050043.mp3"
    },
    {
      "number": 44,
      "text": "﻿\u0026nbsp; يَوۡمَ تَشَقَّقُ الۡاَرۡضُ عَنۡهُمۡ سِرَاعًا\u0026zwnj; ؕ ذٰ لِكَ حَشۡرٌ عَلَيۡنَا يَسِيۡرٌ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "223712050044.mp3"
    },
    {
      "number": 45,
      "text": "\u0026nbsp;نَحۡنُ اَعۡلَمُ بِمَا يَقُوۡلُوۡنَ\u0026zwnj; وَمَاۤ اَنۡتَ عَلَيۡهِمۡ بِجَـبَّارٍ\u0026zwnj; فَذَكِّرۡ بِالۡقُرۡاٰنِ مَنۡ يَّخَافُ وَعِيۡدِ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "223812050045.mp3"
    }
  ]
}