  "ayatList": [
    {
      "number": 31,
      "text": "فَلَا صَدَّقَ وَلَا صَلّٰىۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "131848075031.mp3"
    },
    {
      "number": 32,
      "text": "وَلٰڪِنۡ كَذَّبَ وَتَوَلّٰىۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "131952075032.mp3"
    },
    {
      "number": 33,
      "text": "ثُمَّ ذَهَبَ اِلٰٓى اَهۡلِهٖ يَتَمَطّٰىؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "132055075033.mp3"
    },
    {
      "number": 34,
      "text": "اَوۡلٰى لَكَ فَاَوۡلٰىۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "132202075034.mp3"
    },
    {
      "number": 35,
      "text": "ثُمَّ اَوۡلٰى لَكَ فَاَوۡلٰىؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "132319075035.mp3"
    },
    {
      "number": 36,
      "text": "اَيَحۡسَبُ الۡاِنۡسَانُ اَنۡ يُّتۡرَكَ سُدًىؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "132417075036.mp3"
    },
    {
      "number": 37,
      "text": "اَلَمۡ يَكُ نُطۡفَةً مِّنۡ مَّنِىٍّ يُّمۡنٰىۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "132522075037.mp3"
    },
    {
      "number": 38,
      "text": "ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوّٰىۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "132619075038.mp3"
    },
    {
      "number": 39,
      "text": "فَجَعَلَ مِنۡهُ الزَّوۡجَيۡنِ الذَّكَرَ وَالۡاُنۡثٰىؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "132741075039.mp3"
    },
    {
      "number": 40,
      "text": "اَلَيۡسَ ذٰلِكَ بِقٰدِرٍ عَلٰٓى اَنۡ يُّحۡـىِۦَ الۡمَوۡتٰى\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "132848075040.mp3"
    }
  ]
}