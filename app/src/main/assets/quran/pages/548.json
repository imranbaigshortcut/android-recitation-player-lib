  "ayatList": [
    {
      "number": 1,
      "text": "وَيۡلٌ لِّـكُلِّ هُمَزَةٍ لُّمَزَةِ ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192815104001.mp3"
    },
    {
      "number": 2,
      "text": "\u0026nbsp;اۨلَّذِىۡ جَمَعَ مَالًا وَّعَدَّدَهٗ ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192852104002.mp3"
    },
    {
      "number": 3,
      "text": "\u0026nbsp;يَحۡسَبُ اَنَّ مَالَهٗۤ اَخۡلَدَهٗ\u0026zwnj; ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "192942104003.mp3"
    },
    {
      "number": 4,
      "text": "\u0026nbsp;كَلَّا\u0026zwnj; لَيُنۡۢبَذَنَّ فِى الۡحُطَمَةِ \u0026emsp;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193033104004.mp3"
    },
    {
      "number": 5,
      "text": "\u0026nbsp;وَمَاۤ اَدۡرٰٮكَ مَا الۡحُطَمَةُ ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193114104005.mp3"
    },
    {
      "number": 6,
      "text": "\u0026nbsp;نَارُ اللّٰهِ الۡمُوۡقَدَةُ ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193155104006.mp3"
    },
    {
      "number": 7,
      "text": "\u0026nbsp;الَّتِىۡ تَطَّلِعُ عَلَى الۡاَفۡـــِٕدَةِ ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193230104007.mp3"
    },
    {
      "number": 8,
      "text": "\u0026nbsp;اِنَّهَا عَلَيۡهِمۡ مُّؤۡصَدَةٌ\u0026ensp;ۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193308104008.mp3"
    },
    {
      "number": 9,
      "text": "\u0026nbsp;فِىۡ عَمَدٍ مُّمَدَّدَةٍ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "193355104009.mp3"
    }
  ]
}