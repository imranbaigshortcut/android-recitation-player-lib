{
  "maps": {},
  "suraStart": false,
  "suraNo": 36,
  "ayatStart": 13,
  "ayatEnd": 32,
  "pageNo": 384,
  "ayatList": [
    {
      "number": 13,
      "text": "\u0026nbsp;وَاضۡرِبۡ لَهُمۡ مَّثَلًا اَصۡحٰبَ الۡقَرۡيَةِ \u0026zwnj;ۘ اِذۡ جَآءَهَا الۡمُرۡسَلُوۡنَۚ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "192231036013.mp3"
    },
    {
      "number": 14,
      "text": "اِذۡ اَرۡسَلۡنَاۤ اِلَيۡهِمُ اثۡنَيۡنِ فَكَذَّبُوۡهُمَا فَعَزَّزۡنَا بِثَالِثٍ فَقَالُـوۡۤا اِنَّاۤ اِلَيۡكُمۡ مُّرۡسَلُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "192329036014.mp3"
    },
    {
      "number": 15,
      "text": "قَالُوۡا مَاۤ اَنۡـتُمۡ اِلَّا بَشَرٌ مِّثۡلُـنَا\u0026nbsp;ۙ وَمَاۤ اَنۡزَلَ الرَّحۡمٰنُ مِنۡ شَىۡءٍۙ اِنۡ اَنۡـتُمۡ اِلَّا تَكۡذِبُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "192438036015.mp3"
    },
    {
      "number": 16,
      "text": "قَالُوۡا رَبُّنَا يَعۡلَمُ اِنَّاۤ اِلَيۡكُمۡ لَمُرۡسَلُوۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "192608036016.mp3"
    },
    {
      "number": 17,
      "text": "وَمَا عَلَيۡنَاۤ اِلَّا الۡبَلٰغُ الۡمُبِيۡنُ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "192709036017.mp3"
    },
    {
      "number": 18,
      "text": "قَالُـوۡۤا اِنَّا تَطَيَّرۡنَا بِكُمۡۚ لَٮِٕنۡ لَّمۡ تَنۡتَهُوۡا لَنَرۡجُمَنَّكُمۡ وَلَيَمَسَّنَّكُمۡ مِّنَّا عَذَابٌ اَلِيۡمٌ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "192834036018.mp3"
    },
    {
      "number": 19,
      "text": "قَالُوۡا طٰۤٮِٕـرُكُمۡ مَّعَكُمۡؕ اَٮِٕنۡ ذُكِّرۡتُمۡ ؕ بَلۡ اَنۡـتُمۡ قَوۡمٌ مُّسۡرِفُوۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "192943036019.mp3"
    },
    {
      "number": 20,
      "text": "وَجَآءَ مِنۡ اَقۡصَا الۡمَدِيۡنَةِ رَجُلٌ يَّسۡعٰى قَالَ يٰقَوۡمِ اتَّبِعُوا الۡمُرۡسَلِيۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "193054036020.mp3"
    },
    {
      "number": 21,
      "text": "اتَّبِعُوۡا مَنۡ لَّا يَسۡــٴَــلُكُمۡ اَجۡرًا وَّهُمۡ مُّهۡتَدُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "193159036021.mp3"
    },
    {
      "number": 22,
      "text": "وَمَا لِىَ لَاۤ اَعۡبُدُ الَّذِىۡ فَطَرَنِىۡ وَاِلَيۡهِ تُرۡجَعُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "193258036022.mp3"
    },
    {
      "number": 23,
      "text": "ءَاَ\u0026nbsp;تَّخِذُ مِنۡ دُوۡنِهٖۤ اٰلِهَةً اِنۡ يُّرِدۡنِ الرَّحۡمٰنُ بِضُرٍّ لَّا تُغۡنِ عَنِّىۡ شَفَاعَتُهُمۡ شَيۡـــًٔا وَّلَا يُنۡقِذُوۡنِ\u0026zwnj;ۚ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "193351036023.mp3"
    },
    {
      "number": 24,
      "text": "اِنِّىۡۤ اِذًا لَّفِىۡ ضَلٰلٍ مُّبِيۡنٍ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "193549036024.mp3"
    },
    {
      "number": 25,
      "text": "اِنِّىۡۤ اٰمَنۡتُ بِرَبِّكُمۡ فَاسۡمَعُوۡنِؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "193919036025.mp3"
    },
    {
      "number": 26,
      "text": "قِيۡلَ ادۡخُلِ الۡجَـنَّةَ\u0026nbsp;\u0026nbsp;ؕ قَالَ يٰلَيۡتَ قَوۡمِىۡ يَعۡلَمُوۡنَۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "194041036026.mp3"
    },
    {
      "number": 27,
      "text": "بِمَا غَفَرَلِىۡ رَبِّىۡ وَجَعَلَنِىۡ مِنَ الۡمُكۡرَمِيۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "194134036027.mp3"
    },
    {
      "number": 28,
      "text": "وَمَاۤ اَنۡزَلۡنَا عَلٰى قَوۡمِهٖ مِنۡۢ بَعۡدِهٖ مِنۡ جُنۡدٍ مِّنَ السَّمَآءِ وَمَا كُـنَّا مُنۡزِلِيۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "194250036028.mp3"
    },
    {
      "number": 29,
      "text": "اِنۡ كَانَتۡ اِلَّا صَيۡحَةً وَّاحِدَةً فَاِذَا هُمۡ خٰمِدُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "194404036029.mp3"
    },
    {
      "number": 30,
      "text": "يٰحَسۡرَةً عَلَى الۡعِبَادِ\u0026nbsp;ؔ\u0026zwnj;ۚ مَا يَاۡتِيۡهِمۡ مِّنۡ رَّسُوۡلٍ اِلَّا كَانُوۡا بِهٖ يَسۡتَهۡزِءُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "194528036030.mp3"
    },
    {
      "number": 31,
      "text": "اَلَمۡ يَرَوۡا كَمۡ اَهۡلَـكۡنَا قَبۡلَهُمۡ مِّنَ الۡقُرُوۡنِ اَنَّهُمۡ اِلَيۡهِمۡ لَا يَرۡجِعُوۡنَؕ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195032036031.mp3"
    },
    {
      "number": 32,
      "text": "وَاِنۡ كُلٌّ لَّمَّا جَمِيۡعٌ لَّدَيۡنَا مُحۡضَرُوۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "195211036032.mp3"
    }
  ]
}