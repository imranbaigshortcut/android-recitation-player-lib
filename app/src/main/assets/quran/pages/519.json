  "ayatList": [
    {
      "number": 41,
      "text": "اِنَّ الۡمُتَّقِيۡنَ فِىۡ ظِلٰلٍ وَّعُيُوۡنٍۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "102303077041.mp3"
    },
    {
      "number": 42,
      "text": "وَّفَوَاكِهَ مِمَّا يَشۡتَهُوۡنَؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "102350077042.mp3"
    },
    {
      "number": 43,
      "text": "كُلُوۡا وَاشۡرَبُوۡا هَنِيْٓئًا ۢ بِمَا كُنۡتُمۡ تَعۡمَلُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "102440077043.mp3"
    },
    {
      "number": 44,
      "text": "اِنَّا كَذٰلِكَ نَجۡزِى الۡمُحۡسِنِيۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "102536077044.mp3"
    },
    {
      "number": 45,
      "text": "وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "102625077045.mp3"
    },
    {
      "number": 46,
      "text": "كُلُوۡا وَتَمَتَّعُوۡا قَلِيۡلًا اِنَّكُمۡ مُّجۡرِمُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "102716077046.mp3"
    },
    {
      "number": 47,
      "text": "وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "102824077047.mp3"
    },
    {
      "number": 48,
      "text": "وَاِذَا قِيۡلَ لَهُمُ ارۡكَعُوۡا لَا يَرۡكَعُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "103036077048.mp3"
    },
    {
      "number": 49,
      "text": "وَيۡلٌ يَّوۡمَٮِٕذٍ لِّلۡمُكَذِّبِيۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
