{
  "maps": {},
  "suraStart": false,
  "suraNo": 26,
  "ayatStart": 123,
  "ayatEnd": 140,
  "pageNo": 322,
  "ayatList": [
    {
      "number": 123,
      "text": "كَذَّبَتۡ عَادُ اۨلۡمُرۡسَلِيۡنَ \u0026zwnj;ۖ \u0026zwnj;ۚ\u0026rlm;",
      "translationNo": "Husk, da Ad-folket kalte sendebudene for l\u0026oslash;gnere",
      "commentary": "",
      "audioTalawat": "232920026123.mp3"
    },
    {
      "number": 124,
      "text": "\u0026nbsp;اِذۡ قَالَ لَهُمۡ اَخُوۡهُمۡ هُوۡدٌ اَلَا تَتَّقُوۡنَ\u0026zwnj;ۚ\u0026rlm;",
      "translationNo": "og deres bror, (profeten) Hod, sa til dem: \u0026laquo;Frykter dere ikke Allah?",
      "commentary": "",
      "audioTalawat": "233019026124.mp3"
    },
    {
      "number": 125,
      "text": "اِنِّىۡ لَـكُمۡ رَسُوۡلٌ اَمِيۡنٌ\u0026zwnj;ۙ\u0026rlm;",
      "translationNo": "Jeg er et troverdig sendebud til dere,",
      "commentary": "",
      "audioTalawat": "233115026125.mp3"
    },
    {
      "number": 126,
      "text": "فَاتَّقُوا اللّٰهَ وَاَطِيۡعُوۡنِ\u0026zwnj; ۚ\u0026rlm;",
      "translationNo": "s\u0026aring; frykt Allah og adlyd meg.",
      "commentary": "",
      "audioTalawat": "233214026126.mp3"
    },
    {
      "number": 127,
      "text": "وَمَاۤ اَسۡــَٔـلُكُمۡ عَلَيۡهِ مِنۡ اَجۡرٍ\u0026zwnj;ۚ اِنۡ اَجۡرِىَ اِلَّا عَلٰى رَبِّ الۡعٰلَمِيۡنَ ؕ\u0026rlm;",
      "translationNo": "Jeg krever ingen bel\u0026oslash;nning fra dere for dette. Min bel\u0026oslash;nning ligger hos ingen andre enn universenes Herre.",
      "commentary": "",
      "audioTalawat": "233315026127.mp3"
    },
    {
      "number": 128,
      "text": "اَتَبۡنُوۡنَ بِكُلِّ رِيۡعٍ اٰيَةً تَعۡبَثُوۡنَۙ\u0026rlm;",
      "translationNo": "Reiser dere et monument p\u0026aring; hver h\u0026oslash;yde bare for moro skyld,",
      "commentary": "",
      "audioTalawat": "233425026128.mp3"
    },
    {
      "number": 129,
      "text": "وَ تَتَّخِذُوۡنَ مَصَانِعَ لَعَلَّكُمۡ تَخۡلُدُوۡنَ\u0026zwnj;ۚ\u0026rlm;",
      "translationNo": "og bygger store palasser som om dere skal leve evig,\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "233520026129.mp3"
    },
    {
      "number": 130,
      "text": "وَاِذَا بَطَشۡتُمۡ بَطَشۡتُمۡ جَبَّارِيۡنَ\u0026zwnj;ۚ\u0026rlm;",
      "translationNo": "og n\u0026aring;r dere angriper (noen), angriper dere som tyranner?",
      "commentary": "",
      "audioTalawat": "233607026130.mp3"
    },
    {
      "number": 131,
      "text": "فَاتَّقُوا اللّٰهَ وَاَطِيۡعُوۡنِ\u0026zwnj; ۚ\u0026rlm;",
      "translationNo": "S\u0026aring; frykt Allah og adlyd meg.",
      "commentary": "",
      "audioTalawat": "234607026131.mp3"
    },
    {
      "number": 132,
      "text": "وَاتَّقُوۡا الَّذِىۡۤ اَمَدَّكُمۡ بِمَا تَعۡلَمُوۡنَ\u0026zwnj;ۚ\u0026rlm;",
      "translationNo": "Og frykt Ham som har forsynt dere med alt dere vet om;",
      "commentary": "",
      "audioTalawat": "234731026132.mp3"
    },
    {
      "number": 133,
      "text": "اَمَدَّكُمۡ بِاَنۡعَامٍ وَّبَنِيۡنَ\u0026nbsp;\u0026zwnj;ۚۙ\u0026rlm;",
      "translationNo": "Han forsynte dere med kveg og barn,",
      "commentary": "",
      "audioTalawat": "234826026133.mp3"
    },
    {
      "number": 134,
      "text": "وَجَنّٰتٍ وَّعُيُوۡنٍ\u0026zwnj;ۚ\u0026rlm;",
      "translationNo": "og hager og vannkilder.",
      "commentary": "",
      "audioTalawat": "234925026134.mp3"
    },
    {
      "number": 135,
      "text": "اِنِّىۡۤ اَخَافُ عَلَيۡكُمۡ عَذَابَ يَوۡمٍ عَظِيۡمٍؕ\u0026rlm;",
      "translationNo": "Jeg frykter for dere straffen av en fryktelig dag.\u0026raquo;",
      "commentary": "",
      "audioTalawat": "235018026135.mp3"
    },
    {
      "number": 136,
      "text": "\u0026nbsp;قَالُوۡا سَوَآءٌ عَلَيۡنَاۤ اَوَعَظۡتَ اَمۡ لَمۡ تَكُنۡ مِّنَ الۡوٰعِظِيۡنَۙ\u0026rlm;",
      "translationNo": "De svarte: \u0026laquo;Det er det samme for oss om du advarer oss eller ikke.",
      "commentary": "",
      "audioTalawat": "235114026136.mp3"
    },
    {
      "number": 137,
      "text": "اِنۡ هٰذَاۤ اِلَّا خُلُقُ الۡاَوَّلِيۡنَۙ\u0026rlm;",
      "translationNo": "Dette har p\u0026aring;g\u0026aring;tt lenge.",
      "commentary": "",
      "audioTalawat": "235217026137.mp3"
    },
    {
      "number": 138,
      "text": "مَا نَحۡنُ بِمُعَذَّبِيۡنَ\u0026zwnj;ۚ\u0026rlm;",
      "translationNo": "Vi kommer ikke til \u0026aring; bli rammet av noen straff.\u0026raquo;",
      "commentary": "",
      "audioTalawat": "235327026138.mp3"
    },
    {
      "number": 139,
      "text": "فَكَذَّبُوۡهُ فَاَهۡلَـكۡنٰهُمۡ\u0026zwnj;ؕ اِنَّ فِىۡ ذٰلِكَ لَاَيَةً\u0026zwnj;\u0026nbsp;ؕ وَ مَا كَانَ اَكۡثَرُهُمۡ مُّؤۡمِنِيۡنَ\u0026rlm;",
      "translationNo": "Til slutt avviste de ham, og Vi utslettet dem. Sannelig er det et tegn i dette, men de fleste av dem tror ikke.",
      "commentary": "",
      "audioTalawat": "235423026139.mp3"
    },
    {
      "number": 140,
      "text": "\u0026nbsp;وَاِنَّ رَبَّكَ لَهُوَ الۡعَزِيۡزُ الرَّحِيۡمُ\u0026rlm;",
      "translationNo": "Sannelig er Herren Mektig, N\u0026aring;derik.",
      "commentary": "",
      "audioTalawat": "235533026140.mp3"
    }
  ]
}