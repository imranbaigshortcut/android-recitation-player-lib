  "ayatList": [
    {
      "number": 1,
      "text": "وَالتِّيۡنِ وَالزَّيۡتُوۡنِۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "075453095001.mp3"
    },
    {
      "number": 2,
      "text": "\u0026nbsp;وَطُوۡرِ سِيۡنِيۡنَۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "075816095002.mp3"
    },
    {
      "number": 3,
      "text": "\u0026nbsp;وَهٰذَا الۡبَلَدِ الۡاَمِيۡنِۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "080231095003.mp3"
    },
    {
      "number": 4,
      "text": "\u0026nbsp;\u0026nbsp;لَقَدۡ خَلَقۡنَا الۡاِنۡسَانَ فِىۡۤ اَحۡسَنِ تَقۡوِيۡمٍ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "080450095004.mp3"
    },
    {
      "number": 5,
      "text": "\u0026nbsp;\u0026nbsp;ثُمَّ رَدَدۡنٰهُ اَسۡفَلَ سَافِلِيۡنَۙ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "080650095005.mp3"
    },
    {
      "number": 6,
      "text": "\u0026nbsp;\u0026nbsp;اِلَّا الَّذِيۡنَ اٰمَنُوۡا وَعَمِلُوا الصّٰلِحٰتِ فَلَهُمۡ اَجۡرٌ غَيۡرُ مَمۡنُوۡنٍؕ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "080855095006.mp3"
    },
    {
      "number": 7,
      "text": "\u0026nbsp;\u0026nbsp;فَمَا يُكَذِّبُكَ بَعۡدُ بِالدِّيۡنِ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "081114095007.mp3"
    },
    {
      "number": 8,
      "text": "\u0026nbsp;\u0026nbsp;اَلَيۡسَ اللّٰهُ بِاَحۡكَمِ الۡحٰكِمِيۡنَ\u0026rlm;",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "081327095008.mp3"
    }
  ]
}