{
  "maps": {},
  "suraStart": false,
  "suraNo": 79,
  "ayatStart": 27,
  "ayatEnd": 46,
  "pageNo": 523,
  "ayatList": [
    {
      "number": 27,
      "text": "\u0026nbsp;\u0026nbsp;ءَاَنۡتُمۡ اَشَدُّ خَلۡقًا اَمِ السَّمَآءُ\u0026zwnj; ؕ بَنٰٮهَا\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "164355079027.mp3"
    },
    {
      "number": 28,
      "text": "\u0026nbsp;\u0026nbsp;رَفَعَ سَمۡكَهَا فَسَوَّٮهَا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "164432079028.mp3"
    },
    {
      "number": 29,
      "text": "\u0026nbsp;\u0026nbsp;وَ اَغۡطَشَ لَيۡلَهَا وَاَخۡرَجَ ضُحٰٮهَا\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "164509079029.mp3"
    },
    {
      "number": 30,
      "text": "\u0026nbsp;\u0026nbsp;وَالۡاَرۡضَ بَعۡدَ ذٰلِكَ دَحٰٮهَا ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "164605079030.mp3"
    },
    {
      "number": 31,
      "text": "\u0026nbsp;\u0026nbsp;اَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعٰٮهَا\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "164652079031.mp3"
    },
    {
      "number": 32,
      "text": "\u0026nbsp;\u0026nbsp;وَالۡجِبَالَ اَرۡسٰٮهَا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "164738079032.mp3"
    },
    {
      "number": 33,
      "text": "\u0026nbsp;\u0026nbsp;مَتَاعًا لَّـكُمۡ وَلِاَنۡعَامِكُمۡؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "165213079033.mp3"
    },
    {
      "number": 34,
      "text": "\u0026nbsp;\u0026nbsp;فَاِذَا جَآءَتِ الطَّآمَّةُ الۡكُبۡرٰى\u0026ensp;ۖ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "165252079034.mp3"
    },
    {
      "number": 35,
      "text": "\u0026nbsp;\u0026nbsp;يَوۡمَ يَتَذَكَّرُ الۡاِنۡسَانُ مَا سَعٰىۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "165357079035.mp3"
    },
    {
      "number": 36,
      "text": "\u0026nbsp;\u0026nbsp;وَبُرِّزَتِ الۡجَحِيۡمُ لِمَنۡ يَّرٰى\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "165548079036.mp3"
    },
    {
      "number": 37,
      "text": "\u0026nbsp;\u0026nbsp;فَاَمَّا مَنۡ طَغٰىۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "165637079037.mp3"
    },
    {
      "number": 38,
      "text": "\u0026nbsp;\u0026nbsp;وَاٰثَرَ الۡحَيٰوةَ الدُّنۡيَا ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "165727079038.mp3"
    },
    {
      "number": 39,
      "text": "\u0026nbsp;\u0026nbsp;فَاِنَّ الۡجَحِيۡمَ هِىَ الۡمَاۡوٰىؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "165801079039.mp3"
    },
    {
      "number": 40,
      "text": "\u0026nbsp;\u0026nbsp;وَاَمَّا مَنۡ خَافَ مَقَامَ رَبِّهٖ وَ نَهَى النَّفۡسَ عَنِ الۡهَوٰىۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "170047079040.mp3"
    },
    {
      "number": 41,
      "text": "\u0026nbsp;\u0026nbsp;فَاِنَّ الۡجَـنَّةَ هِىَ الۡمَاۡوٰىؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "170211079041.mp3"
    },
    {
      "number": 42,
      "text": "\u0026nbsp;\u0026nbsp;يَسۡــٴَــلُوۡنَكَ عَنِ السَّاعَةِ اَيَّانَ مُرۡسٰٮهَا ؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "170300079042.mp3"
    },
    {
      "number": 43,
      "text": "\u0026nbsp;\u0026nbsp;فِيۡمَ اَنۡتَ مِنۡ ذِكۡرٰٮهَاؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "170604079043.mp3"
    },
    {
      "number": 44,
      "text": "\u0026nbsp;\u0026nbsp;اِلٰى رَبِّكَ مُنۡتَهٰٮهَاؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "170649079044.mp3"
    },
    {
      "number": 45,
      "text": "\u0026nbsp;\u0026nbsp;اِنَّمَاۤ اَنۡتَ مُنۡذِرُ مَنۡ يَّخۡشٰٮهَاؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "170920079045.mp3"
    },
    {
      "number": 46,
      "text": "\u0026nbsp;\u0026nbsp;كَاَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوۡۤا اِلَّا عَشِيَّةً اَوۡ ضُحٰٮهَا\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse",
      "commentary": "",
      "audioTalawat": "171039079046.mp3"
    }
  ]
}