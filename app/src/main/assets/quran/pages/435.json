{
  "maps": {},
  "suraStart": false,
  "suraNo": 44,
  "ayatStart": 43,
  "ayatEnd": 59,
  "pageNo": 435,
  "ayatList": [
    {
      "number": 43,
      "text": "اِنَّ شَجَرَتَ الزَّقُّوۡمِۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "190152044043.mp3"
    },
    {
      "number": 44,
      "text": "طَعَامُ الۡاَثِيۡمِ ۛۚ \u0026ensp; ۖ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "190239044044.mp3"
    },
    {
      "number": 45,
      "text": "كَالۡمُهۡلِ ۛۚ يَغۡلِىۡ فِى الۡبُطُوۡنِۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "190325044045.mp3"
    },
    {
      "number": 46,
      "text": "كَغَلۡىِ الۡحَمِيۡمِ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "190411044046.mp3"
    },
    {
      "number": 47,
      "text": "\u0026nbsp;خُذُوۡهُ فَاعۡتِلُوۡهُ اِلٰى سَوَآءِ الۡجَحِيۡمِ \u0026ensp; ۖ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "190724044047.mp3"
    },
    {
      "number": 48,
      "text": "ثُمَّ صُبُّوۡا فَوۡقَ رَاۡسِهٖ مِنۡ عَذَابِ الۡحَمِيۡمِؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "190825044048.mp3"
    },
    {
      "number": 49,
      "text": "ذُقۡ ۖۚ اِنَّكَ اَنۡتَ الۡعَزِيۡزُ الۡكَرِيۡمُ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "191001044049.mp3"
    },
    {
      "number": 50,
      "text": "اِنَّ هٰذَا مَا كُنۡتُمۡ بِهٖ تَمۡتَرُوۡنَ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "191049044050.mp3"
    },
    {
      "number": 51,
      "text": "اِنَّ الۡمُتَّقِيۡنَ فِىۡ مَقَامٍ اَمِيۡنٍۙ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "191140044051.mp3"
    },
    {
      "number": 52,
      "text": "فِىۡ جَنّٰتٍ وَّعُيُوۡنٍ ۙ ۚ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "191230044052.mp3"
    },
    {
      "number": 53,
      "text": "يَّلۡبَسُوۡنَ مِنۡ سُنۡدُسٍ وَّاِسۡتَبۡرَقٍ مُّتَقٰبِلِيۡنَۚ\u0026nbsp;ۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "191321044053.mp3"
    },
    {
      "number": 54,
      "text": "كَذٰلِكَ وَزَوَّجۡنٰهُمۡ بِحُوۡرٍ عِيۡنٍؕ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "191412044054.mp3"
    },
    {
      "number": 55,
      "text": "يَدۡعُوۡنَ فِيۡهَا بِكُلِّ فَاكِهَةٍ اٰمِنِيۡنَۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "191506044055.mp3"
    },
    {
      "number": 56,
      "text": "لَا يَذُوۡقُوۡنَ فِيۡهَا الۡمَوۡتَ اِلَّا الۡمَوۡتَةَ الۡاُوۡلٰى\u0026zwnj;\u0026nbsp;ۚ وَوَقٰٮهُمۡ عَذَابَ الۡجَحِيۡمِۙ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "191559044056.mp3"
    },
    {
      "number": 57,
      "text": "فَضۡلًا مِّنۡ رَّبِّكَ \u0026zwnj;ؕ ذٰ لِكَ هُوَ الۡفَوۡزُ الۡعَظِيۡمُ\u0026rlm; ",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "191703044057.mp3"
    },
    {
      "number": 58,
      "text": "فَاِنَّمَا يَسَّرۡنٰهُ بِلِسَانِكَ لَعَلَّهُمۡ يَتَذَكَّرُوۡنَ",
      "translationNo": "Her kommer norsk oversettelse.",
      "commentary": "",
      "audioTalawat": "162239044058.mp3"
    },
    {
      "number": 59,
      "text": "فَارۡتَقِبۡ اِنَّهُمۡ مُّرۡتَقِبُوۡنَ\u0026rlm;\u0026nbsp;",
      "translationNo": "Her kommer norsk oversettelse.\u0026nbsp;",
      "commentary": "",
      "audioTalawat": "162419044059.mp3"
    }
  ]
}