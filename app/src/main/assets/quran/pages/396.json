{
  "maps": {},
  "suraStart": false,
  "suraNo": 38,
  "ayatStart": 41,
  "ayatEnd": 64,
  "pageNo": 396,
  "ayatList": [
    {
      "number": 41,
      "text": "\u0026nbsp;وَاذۡكُرۡ عَبۡدَنَاۤ اَيُّوۡبَۘ اِذۡ نَادٰى رَبَّهٗۤ اَنِّىۡ مَسَّنِىَ الشَّيۡطٰنُ بِنُصۡبٍ وَّعَذَابٍؕ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "230328038041.mp3"
    },
    {
      "number": 42,
      "text": "\u0026nbsp;اُرۡكُضۡ بِرِجۡلِكَ\u0026zwnj; ۚ هٰذَا مُغۡتَسَلٌ ۢ بَارِدٌ وَّشَرَابٌ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "230438038042.mp3"
    },
    {
      "number": 43,
      "text": "\u0026nbsp;وَوَهَبۡنَا لَهٗۤ اَهۡلَهٗ وَمِثۡلَهُمۡ مَّعَهُمۡ رَحۡمَةً مِّنَّا وَذِكۡرٰى لِاُولِى الۡاَلۡبَابِ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "230528038043.mp3"
    },
    {
      "number": 44,
      "text": "وَخُذۡ بِيَدِكَ ضِغۡثًا فَاضۡرِبْ بِّهٖ وَلَا تَحۡنَثۡ\u0026zwnj;ؕ اِنَّا وَجَدۡنٰهُ صَابِرًا\u0026zwnj; ؕ نِعۡمَ الۡعَبۡدُ\u0026zwnj; ؕ اِنَّـهٗۤ اَوَّابٌ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "230615038044.mp3"
    },
    {
      "number": 45,
      "text": "وَاذۡكُرۡ عِبٰدَنَاۤ اِبۡرٰهِيۡمَ وَاِسۡحٰقَ وَيَعۡقُوۡبَ اُولِى الۡاَيۡدِىۡ وَالۡاَبۡصَارِ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "230707038045.mp3"
    },
    {
      "number": 46,
      "text": "اِنَّاۤ اَخۡلَصۡنٰهُمۡ بِخَالِصَةٍ ذِكۡرَى الدَّارِ\u0026zwnj;ۚ\u0026rlm;\u0026nbsp;",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "230756038046.mp3"
    },
    {
      "number": 47,
      "text": "وَاِنَّهُمۡ عِنۡدَنَا لَمِنَ الۡمُصۡطَفَيۡنَ الۡاَخۡيَارِؕ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "230848038047.mp3"
    },
    {
      "number": 48,
      "text": "وَاذۡكُرۡ اِسۡمٰعِيۡلَ وَ الۡيَسَعَ وَذَا الۡكِفۡلِ\u0026zwnj;ؕ وَكُلٌّ مِّنَ الۡاَخۡيَارِؕ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "230945038048.mp3"
    },
    {
      "number": 49,
      "text": "هٰذَا ذِكۡرٌ\u0026zwnj;ؕ وَاِنَّ لِلۡمُتَّقِيۡنَ لَحُسۡنَ مَاٰبٍۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "231141038049.mp3"
    },
    {
      "number": 50,
      "text": "جَنّٰتِ عَدۡنٍ مُّفَتَّحَةً لَّهُمُ الۡاَبۡوَابُ\u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "231235038050.mp3"
    },
    {
      "number": 51,
      "text": "مُتَّكِـــِٕيۡنَ فِيۡهَا يَدۡعُوۡنَ فِيۡهَا بِفَاكِهَةٍ كَثِيۡرَةٍ وَّشَرَابٍ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "231326038051.mp3"
    },
    {
      "number": 52,
      "text": "\u0026nbsp;وَعِنۡدَهُمۡ قٰصِرٰتُ الطَّرۡفِ اَتۡرَابٌ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "231418038052.mp3"
    },
    {
      "number": 53,
      "text": "هٰذَا مَا تُوۡعَدُوۡنَ لِيَوۡمِ الۡحِسَابِ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "231506038053.mp3"
    },
    {
      "number": 54,
      "text": "اِنَّ هٰذَا لَرِزۡقُنَا مَا لَهٗ مِنۡ نَّـفَادٍ \u0026zwnj;ۖ \u0026zwnj;ۚ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "231558038054.mp3"
    },
    {
      "number": 55,
      "text": "هٰذَا\u0026zwnj; ؕ وَاِنَّ لِلطّٰغِيۡنَ لَشَرَّ مَاٰبٍ ۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "231711038055.mp3"
    },
    {
      "number": 56,
      "text": "جَهَـنَّمَ\u0026zwnj; ۚ يَصۡلَوۡنَهَا\u0026zwnj; ۚ فَبِئۡسَ الۡمِهَادُ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "231829038056.mp3"
    },
    {
      "number": 57,
      "text": "هٰذَا ۙ فَلۡيَذُوۡقُوۡهُ حَمِيۡمٌ وَّغَسَّاقٌ\u0026ensp;ۙ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "231919038057.mp3"
    },
    {
      "number": 58,
      "text": "وَّاٰخَرُ مِنۡ شَكۡلِهٖۤ اَزۡوَاجٌ\u0026ensp;ؕ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "232007038058.mp3"
    },
    {
      "number": 59,
      "text": "هٰذَا فَوۡجٌ مُّقۡتَحِمٌ مَّعَكُمۡ\u0026zwnj;ۚ لَا مَرۡحَبًۢـا بِهِمۡ\u0026zwnj;ؕ اِنَّهُمۡ صَالُوا النَّارِ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "232111038059.mp3"
    },
    {
      "number": 60,
      "text": "قَالُوۡا بَلۡ اَنۡتُمۡ\u0026nbsp;لَا مَرۡحَبًۢـا بِكُمۡ\u0026zwnj;ؕ اَنۡتُمۡ قَدَّمۡتُمُوۡهُ لَنَا\u0026zwnj;ۚ فَبِئۡسَ الۡقَرَارُ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "232200038060.mp3"
    },
    {
      "number": 61,
      "text": "قَالُوۡا رَبَّنَا مَنۡ قَدَّمَ لَنَا هٰذَا فَزِدۡهُ عَذَابًا ضِعۡفًا فِى النَّارِ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "232308038061.mp3"
    },
    {
      "number": 62,
      "text": "\u0026nbsp;وَقَالُوۡا مَا لَنَا لَا نَرٰى رِجَالًا كُنَّا نَـعُدُّهُمۡ مِّنَ الۡاَشۡرَارِؕ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "232357038062.mp3"
    },
    {
      "number": 63,
      "text": "\u0026nbsp;اَ تَّخَذۡنٰهُمۡ سِخۡرِيًّا اَمۡ زَاغَتۡ عَنۡهُمُ الۡاَبۡصَارُ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "232451038063.mp3"
    },
    {
      "number": 64,
      "text": "اِنَّ ذٰ لِكَ لَحَقّ\u0026ensp;ٌ تَخَاصُمُ اَهۡلِ النَّارِ\u0026rlm; ",
      "translationNo": "kommer snart",
      "commentary": "",
      "audioTalawat": "232559038064.mp3"
    }
  ]
}